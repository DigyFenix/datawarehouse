# =====================================================================
# Producción — plantilla de variables. Copiar a `.env` JUNTO a este archivo
# y completar. El `.env` NUNCA se versiona. Generar TODOS los secretos
# nuevos para producción (no reutilizar los de desarrollo).
# =====================================================================

# --- Postgres (rol administrador del clúster) ---
POSTGRES_DB=cresta_dw
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- Rol dedicado del portal de USUARIO (RUNBOOK §5) ---
# SELECT sobre gobierno.organizaciones + permisos sobre el esquema `portal`
# de cada base de tenant. Nunca el rol administrador.
PORTAL_DB_USER=portal_app
PORTAL_DB_PASSWORD=

# --- Portal ADMIN ---
JWT_SECRET=
JWT_EXPIRA_EN=8h
PORTAL_ADMIN_EMAIL=
PORTAL_ADMIN_PASSWORD=
WORKER_TIMEOUT_MS=1800000

# --- Portal de USUARIO ---
PORTAL_JWT_SECRET=
PORTAL_JWT_EXPIRA_EN=8h

# --- ERPs alcanzables desde el VPS (Iron Network; Cresta corre on-prem) ---
ODOO_USER=
ODOO_PASSWORD=
HANA_USER=
HANA_PASSWORD=

# --- Respaldos ---
RESPALDO_RETENCION_DIAS=14
