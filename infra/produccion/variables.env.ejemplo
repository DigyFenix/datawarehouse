# =====================================================================
# Variables del servidor de UN cliente. Copiar a `.env` en el servidor
# (junto a docker-compose.yml) y completar con valores NUEVOS por cliente.
# Generar cada secreto con:  openssl rand -base64 33
# Este archivo de ejemplo no lleva ningún valor real.
# =====================================================================

# --- Versión de las imágenes cargadas (la imprime empaquetar.sh) ---
VERSION=

# --- Cliente ---
ORGANIZACION=ironnetwork                      # código de la organización en el portal admin
DOMINIO_PORTAL=ironnetwork.digyfenix.com      # lo que abre el cliente
DOMINIO_ADMIN=admin-ironnetwork.digyfenix.com # solo el proveedor
HASH_TENANT=                                  # se completa al crear la organización (RUNBOOK §6)
ACME_EMAIL=echacon@digyfenix.com              # avisos de Let's Encrypt

# --- Carga diaria (hora de Guatemala, separadas por espacio) ---
HORAS_CARGA=05:00

# --- Postgres (superusuario del clúster: solo plano de control y worker) ---
POSTGRES_DB=quilate_control
POSTGRES_USER=quilate_admin
POSTGRES_PASSWORD=
PG_PUERTO_PUBLICO=5432

# --- Roles de aplicación (los crea el init en el primer arranque) ---
PORTAL_APP_PASSWORD=        # API del portal de usuario
PBI_LECTOR_PASSWORD=        # gateway de Power BI (solo lectura de oro)
PORTAL_LECTOR_PASSWORD=     # agente de IA (lectura bajo RLS)

# --- Worker (solo lo llama el API admin) ---
WORKER_TOKEN=

# --- Portal admin ---
JWT_SECRET=
PORTAL_ADMIN_EMAIL=echacon@digyfenix.com
PORTAL_ADMIN_PASSWORD=

# --- Portal de usuario ---
PORTAL_JWT_SECRET=
ANTHROPIC_API_KEY=          # vacío salvo que el cliente compre el módulo Asistente

# --- Credenciales read-only del ERP (solo las del ERP del cliente) ---
ODOO_USER=
ODOO_PASSWORD=
HANA_USER=
HANA_PASSWORD=
MSSQL_USER=
MSSQL_PASSWORD=

# --- Respaldos ---
RESPALDO_RETENCION_DIAS=14
