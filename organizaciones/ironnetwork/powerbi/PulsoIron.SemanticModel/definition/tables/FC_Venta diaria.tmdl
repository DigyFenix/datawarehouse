table 'FC_Venta diaria'
	lineageTag: 9d2a6bd4-3c6a-4f95-aabb-841cb5cb27b1

	/// Serie continua (un día sin ventas es un CERO, no un hueco): la única base correcta para tendencias.
	measure 'Venta diaria neta' = SUM('FC_Venta diaria'[ventas_netas])
		formatString: "Q" #,0
		displayFolder: 01 Serie
		lineageTag: 46b2d70f-278c-46ff-9db3-f40882553a5f

	/// Suaviza el efecto del día de semana. Útil para ver la tendencia corta sin el ruido del fin de semana.
	measure 'Venta media móvil 7d' = AVERAGEX(DATESINPERIOD('DM_Calendario'[fecha], [_Fecha ancla móvil], -7, DAY), CALCULATE(SUM('FC_Venta diaria'[ventas_netas])))
		formatString: "Q" #,0
		displayFolder: 01 Serie
		lineageTag: bd8cfa6a-650f-41eb-af47-11b3154ca7a5

	/// Tendencia de fondo, ya sin efecto semanal ni de quincena.
	measure 'Venta media móvil 30d' = AVERAGEX(DATESINPERIOD('DM_Calendario'[fecha], [_Fecha ancla móvil], -30, DAY), CALCULATE(SUM('FC_Venta diaria'[ventas_netas])))
		formatString: "Q" #,0
		displayFolder: 01 Serie
		lineageTag: feb8a850-4504-44b4-8f5d-7b2777fd012f

	/// Promedio solo de los días que SÍ se vendió (excluye ceros): el ritmo real de un día operado.
	measure 'Venta promedio día operado' = CALCULATE(AVERAGE('FC_Venta diaria'[ventas_netas]), KEEPFILTERS('FC_Venta diaria'[es_dia_sin_venta] = FALSE))
		formatString: "Q" #,0
		displayFolder: 01 Serie
		lineageTag: 4f3c9938-d258-426f-beb6-08432b1417e9

	/// Días del período sin ninguna facturación. Un pico aquí suele ser paro, feriado o problema de captura.
	measure 'Días sin venta' = CALCULATE(COUNTROWS('FC_Venta diaria'), KEEPFILTERS('FC_Venta diaria'[es_dia_sin_venta] = TRUE))
		formatString: #,0
		displayFolder: 02 Actividad
		lineageTag: 1cc5a17a-cae1-4cb7-ad99-5cffe95436d6

	/// Cuántos clientes distintos compran en un día operado promedio.
	measure 'Clientes activos por día' = CALCULATE(AVERAGE('FC_Venta diaria'[clientes_activos]), KEEPFILTERS('FC_Venta diaria'[es_dia_sin_venta] = FALSE))
		formatString: #,0
		displayFolder: 02 Actividad
		lineageTag: f66bf27b-8475-452c-8368-ae6ec64faa89

	/// Días del período con facturación real.
	measure 'Días con venta' = CALCULATE(COUNTROWS('FC_Venta diaria'), KEEPFILTERS('FC_Venta diaria'[es_dia_sin_venta] = FALSE))
		formatString: #,0
		displayFolder: 02 Actividad
		lineageTag: f0dfeed8-e5e3-4db2-9990-6a2e801086bc

	/// Ritmo real: dividir entre días NATURALES castiga a los meses con muchos feriados y hace parecer que la operación cayó cuando solo hubo menos días de trabajo.
	measure 'Venta por día hábil' = DIVIDE([Venta diaria neta], CALCULATE(COUNTROWS(DM_Calendario), KEEPFILTERS(DM_Calendario[es_dia_habil] = TRUE)))
		formatString: "Q" #,0
		displayFolder: 03 Ritmo
		lineageTag: 3a43e148-724f-45cf-be02-7cb227b36d4e

	/// Dónde va a cerrar el mes si se mantiene el ritmo de los días hábiles ya trabajados. Solo tiene sentido con UN mes filtrado: con el período abierto devolvía la venta de toda la historia repartida entre todos los días hábiles del calendario — un número plausible y falso (≈Q9.8M contra una venta mensual real cercana a Q50M). Ahora se calla en vez de mentir.
	measure 'Proyección de cierre de mes' = IF(DISTINCTCOUNT(DM_Calendario[anio_mes]) <> 1, BLANK(), DIVIDE([Venta diaria neta], CALCULATE(COUNTROWS(DM_Calendario), KEEPFILTERS(DM_Calendario[es_dia_habil] = TRUE), KEEPFILTERS(DM_Calendario[fecha] <= TODAY()))) * MAX(DM_Calendario[dias_habiles_del_mes]))
		formatString: "Q" #,0
		displayFolder: 03 Ritmo
		lineageTag: 10dcfc99-b550-4167-941d-943d557e7a81

	/// Cuánto se despega el período del promedio mensual de su propio año. 1.0 es un mes normal; 1.3 es un pico estacional.
	measure 'Índice de estacionalidad' = DIVIDE([Venta diaria neta], DIVIDE(CALCULATE([Venta diaria neta], ALLEXCEPT(DM_Calendario, DM_Calendario[anio])), 12))
		formatString: #,0.00
		displayFolder: 03 Ritmo
		lineageTag: 96669559-3462-4869-8c2d-8dd96c9dbea4

	/// Acumulado dentro de la semana ISO en curso.
	measure 'Venta acumulada semana' = CALCULATE([Venta diaria neta], FILTER(ALL(DM_Calendario), DM_Calendario[anio_semana_orden] = MAX(DM_Calendario[anio_semana_orden]) && DM_Calendario[fecha] <= MAX(DM_Calendario[fecha])))
		formatString: "Q" #,0
		displayFolder: 03 Ritmo
		lineageTag: d5776ee5-19ae-412f-94fb-9a684716ecfa

	/// Subtítulo del ritmo del mes (página 01). El dato que decide DENTRO del mes: lo que va, contra los días hábiles ya trabajados y los que faltan. Con el período abierto lo dice en vez de mostrar una proyección que no significa nada — la proyección exige un mes.
	measure 'Subtítulo del ritmo del mes' = VAR meses = DISTINCTCOUNT(DM_Calendario[anio_mes]) VAR proy = [Proyección de cierre de mes] VAR acum = [Ventas acumuladas mes] VAR hab = MAX(DM_Calendario[dias_habiles_del_mes]) VAR trans = MAX(DM_Calendario[dias_habiles_transcurridos]) RETURN SWITCH(TRUE(), meses <> 1, "Seleccioná un mes: la proyección de cierre se calcula sobre los días hábiles de un solo mes", ISBLANK(proy) || proy = 0, "Sin venta registrada en el mes", "Cierre proyectado " & (IF(proy < 0, "-", "") & "Q" & SWITCH(TRUE(), ABS(proy) >= 1000000, FORMAT(ABS(proy) / 1000000, "#,##0.0") & "M", ABS(proy) >= 10000, FORMAT(ABS(proy) / 1000, "#,##0") & "K", FORMAT(ABS(proy), "#,##0"))) & " · van " & (IF(acum < 0, "-", "") & "Q" & SWITCH(TRUE(), ABS(acum) >= 1000000, FORMAT(ABS(acum) / 1000000, "#,##0.0") & "M", ABS(acum) >= 10000, FORMAT(ABS(acum) / 1000, "#,##0") & "K", FORMAT(ABS(acum), "#,##0"))) & " en " & FORMAT(trans, "0") & " de " & FORMAT(hab, "0") & " días hábiles")
		displayFolder: _Narrativa
		lineageTag: d2e62d5c-8863-4b2d-972a-e1dfebe124f0

