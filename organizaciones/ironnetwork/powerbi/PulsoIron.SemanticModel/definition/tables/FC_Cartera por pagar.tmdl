		summarizeBy: none
		sourceColumn: version_proceso

	/// Días de crédito pactados en la partida (vencimiento − documento).
	column 'Días de crédito' = DATEDIFF('FC_Cartera por pagar'[fecha_documento], 'FC_Cartera por pagar'[fecha_vencimiento], DAY)
		dataType: int64
		formatString: 0
		lineageTag: f6ed68ef-59a5-4cba-8fe5-49cc54928184
		summarizeBy: none

	/// Días desde el documento hasta el corte.
	column 'Días transcurridos' = DATEDIFF('FC_Cartera por pagar'[fecha_documento], 'FC_Cartera por pagar'[fecha_corte], DAY)
		dataType: int64
		formatString: 0
		lineageTag: c9213053-01df-4c96-9076-83661fbf01b1
		summarizeBy: none

	/// Vencido / No vencido (días vencido positivos = vencido; negativos = días que faltan).
	column Estado = IF('FC_Cartera por pagar'[dias_vencido] > 0, "Vencido", "No vencido")
		dataType: string
		lineageTag: ae19b0bf-bf48-4fe7-8681-995f0dafd129
		summarizeBy: none

	/// Rangos finos de vencimiento como en Kraken: por vencer (31+, 22-30, 15-21, 8-14, 7 días) y vencido (1-15, 16-30, 31-60, 61-90, 91+). Etiquetas en lenguaje claro («Vence en 22-30», «Vencido 31-60»): Edwin pidió retirar el «Próx.» y la jerarquía Estado › Rango no abre por PBIR.
	column 'Rango de vencimiento' = VAR d = 'FC_Cartera por pagar'[dias_vencido] RETURN SWITCH(TRUE(), d > 90, "Vencido 91+", d > 60, "Vencido 61-90", d > 30, "Vencido 31-60", d > 15, "Vencido 16-30", d > 0, "Vencido 1-15", d > -8, "Vence en 7", d > -15, "Vence en 8-14", d > -22, "Vence en 15-21", d > -31, "Vence en 22-30", "Vence en 31+")
		dataType: string
		lineageTag: 43aa2d2d-026a-466c-99ad-3f6131ecacf6
		summarizeBy: none
		sortByColumn: 'Rango de vencimiento orden'

	column 'Rango de vencimiento orden' = VAR d = 'FC_Cartera por pagar'[dias_vencido] RETURN SWITCH(TRUE(), d > 90, 10, d > 60, 9, d > 30, 8, d > 15, 7, d > 0, 6, d > -8, 5, d > -15, 4, d > -22, 3, d > -31, 2, 1)
		dataType: int64
		isHidden
		lineageTag: 5903f213-df59-423f-bbf6-fd8beb61d23f
		summarizeBy: none

	partition 'FC_Cartera por pagar' = m
		mode: import
		source =
				let
				    Origen = PostgreSQL.Database(Servidor, BaseDatos),
				    Tabla = Origen{[Schema="oro",Item="hecho_cartera_pagar"]}[Data]
				in
				    Tabla

