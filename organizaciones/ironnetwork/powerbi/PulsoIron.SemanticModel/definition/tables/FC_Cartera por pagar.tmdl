table 'FC_Cartera por pagar'
	lineageTag: b3b808af-00d7-43e5-a1b3-c4ce66751576

	/// En positivo para poder compararlo con la cartera por cobrar sin invertir signos en cada visual. MONEDA DE PRESENTACIÓN.
	measure 'Saldo por pagar' = SUM('FC_Cartera por pagar'[saldo_pendiente_absoluto])
		formatString: "Q" #,0
		displayFolder: 01 Saldo
		lineageTag: 1770fc46-8912-4d0b-9f81-e7d59e3a986a

	/// Lo que se debe a proveedores reales.
	measure 'Saldo por pagar terceros' = CALCULATE([Saldo por pagar], DM_Proveedor[es_intercompania] = FALSE)
		formatString: "Q" #,0
		displayFolder: 01 Saldo
		lineageTag: 43eeb0bb-00e8-40a0-9311-1c009b38c9b5

	/// Deuda con empresas del propio grupo: se netea al consolidar.
	measure 'Saldo por pagar grupo' = CALCULATE([Saldo por pagar], DM_Proveedor[es_intercompania] = TRUE)
		formatString: "Q" #,0
		displayFolder: 01 Saldo
		lineageTag: 3dbe15ab-29cc-4c16-8d16-b8f9cbcbd76f

	/// Lo que se cobra menos lo que se debe: la liquidez estructural del negocio.
	measure 'Posición neta' = VAR c = [Saldo por cobrar] VAR p = [Saldo por pagar] RETURN IF(ISBLANK(c) && ISBLANK(p), BLANK(), COALESCE(c, 0) - COALESCE(p, 0))
		formatString: "Q" #,0
		displayFolder: 01 Saldo
		lineageTag: 7d09f3ce-3250-4479-843d-135f105ad492

	/// Número de partidas abiertas de deuda.
	measure 'Partidas por pagar' = COUNTROWS('FC_Cartera por pagar')
		formatString: #,0
		displayFolder: 02 Conteos
		lineageTag: 42265756-8b81-45b6-b38c-bf6028a36bcc

	/// Proveedores distintos a los que se les debe.
	measure 'Proveedores con saldo' = DISTINCTCOUNT('FC_Cartera por pagar'[proveedor_clave])
		formatString: #,0
		displayFolder: 02 Conteos
		lineageTag: 8a64c0b6-e1ec-48eb-ba41-bf9e2f0c14af

	/// Deuda que ya pasó su fecha de pago. Sostenida en el tiempo es señal de tensión de caja, no de buena negociación.
	measure 'Por pagar vencido' = CALCULATE([Saldo por pagar], KEEPFILTERS('DM_Antigüedad'[es_vencido] = TRUE))
		formatString: "Q" #,0
		displayFolder: 03 Antigüedad
		lineageTag: 2b4fd223-d277-49f0-a747-554fb0ee2b7a

	/// Qué parte de lo que se debe ya está vencido.
	measure '% Por pagar vencido' = DIVIDE([Por pagar vencido], [Saldo por pagar])
		formatString: 0.0%
		displayFolder: 03 Antigüedad
		lineageTag: 70c22a1e-4d91-49b2-a57e-0f23cfc18c77

	/// Deuda vieja con proveedores; suele venir con suministro en riesgo.
	measure 'Por pagar más de 90' = CALCULATE([Saldo por pagar], KEEPFILTERS('DM_Antigüedad'[rango_aging] = "+90"))
		formatString: "Q" #,0
		displayFolder: 03 Antigüedad
		lineageTag: 3e7032ab-63ba-435e-96cf-42e64b5f7ca4

	/// Foto de HOY: ignora el filtro de fechas de la página (el saldo es una foto, no un flujo).
	measure 'Por pagar hoy' = CALCULATE([Saldo por pagar], REMOVEFILTERS(DM_Calendario))
		formatString: "Q" #,0
		displayFolder: 04 Foto de hoy
		lineageTag: cf51c0b5-854e-4f30-84d2-76a01b4a3aa2

	/// Cobrar menos deber, foto de hoy, sin el filtro de período.
	measure 'Posición neta hoy' = CALCULATE([Posición neta], REMOVEFILTERS(DM_Calendario))
		formatString: "Q" #,0
		displayFolder: 04 Foto de hoy
		lineageTag: 97287dfa-e1e3-4cfd-a678-0c2febcc6763

	/// DPO: días que tardamos en pagar a proveedores. Misma convención que 'Días de cartera terceros' para que el ciclo de efectivo cuadre.
	measure 'Días de pago terceros' = DIVIDE([Saldo por pagar terceros], DIVIDE([Compras a terceros], CALCULATE(DISTINCTCOUNT(DM_Calendario[fecha]), FC_Compras)))
		formatString: #,0.0
		displayFolder: 05 Ciclo de efectivo
		lineageTag: f2a0aa3f-68c4-48f3-90fd-33930a200dd6

	/// Veces al año que se paga la deuda completa. Es el recíproco de los días de pago.
	measure 'Rotación de cuentas por pagar' = DIVIDE(365, [Días de pago terceros])
		formatString: #,0.0
		displayFolder: 05 Ciclo de efectivo
		lineageTag: 43023462-9bcc-4fa4-818c-b123ff3c74bd

	/// Lo que hay que pagar en el período, por fecha de VENCIMIENTO y no de documento. Leída junto a 'Cobro que vence en el período' dice si la semana entra en positivo o en negativo antes de que ocurra: en Cresta, agosto vence con Q26.1M por pagar contra Q19.4M por cobrar.
	measure 'Pago que vence en el período' = CALCULATE([Saldo por pagar terceros], USERELATIONSHIP('FC_Cartera por pagar'[tiempo_vencimiento_clave], DM_Calendario[tiempo_clave]))
		formatString: "Q" #,0
		displayFolder: 06 Agenda de vencimiento
		lineageTag: a72ded27-43e0-4738-92a0-a8dc985a8f64

	/// CICLO DE CONVERSIÓN DE EFECTIVO: días que el dinero pasa atrapado en el negocio antes de volver a caja. Cobrar + inventario − pagar. Bajarlo libera capital de trabajo sin pedir un préstamo; es la métrica de liquidez que más mueve la aguja en una PyME. Negativo significa que los proveedores financian la operación.
	measure 'Ciclo de conversión de efectivo' = [Días de cartera terceros] + [Días de inventario] - [Días de pago terceros]
		formatString: #,0.0
		displayFolder: 05 Ciclo de efectivo
		lineageTag: 7ea3e75b-5abd-4ea2-9306-96d5cffc6708

	/// A cuántos proveedores se les debe algo ya vencido.
	measure 'Proveedores con saldo vencido' = CALCULATE(DISTINCTCOUNT('FC_Cartera por pagar'[proveedor_clave]), KEEPFILTERS('DM_Antigüedad'[es_vencido] = TRUE))
		formatString: #,0
		displayFolder: 02 Conteos
		lineageTag: eedd759d-6238-4174-baad-7834e7489f78

	/// Partidas sin fecha de pago pactada: normalmente anticipos o ajustes sin depurar.
	measure 'Por pagar sin vencimiento' = CALCULATE([Saldo por pagar], KEEPFILTERS('DM_Antigüedad'[rango_aging] = "sin_vencimiento"))
		formatString: "Q" #,0
		displayFolder: 03 Antigüedad
		lineageTag: 96056b7b-02d6-4f5f-8816-5b7995f1a74d

	/// Concentración de la deuda: cuánto pesa el acreedor más grande sobre el total por pagar.
	measure '% Deuda en el mayor acreedor' = DIVIDE(MAXX(ALLSELECTED(DM_Proveedor), [Saldo por pagar terceros]), CALCULATE([Saldo por pagar terceros], ALLSELECTED(DM_Proveedor)))
		formatString: 0.0%
		displayFolder: 03 Antigüedad
		lineageTag: 295f329a-dced-4093-ad8b-0fbfc2701027

	/// Saldo por pagar que aún no vence.
	measure 'Por pagar no vencido' = CALCULATE([Saldo por pagar], KEEPFILTERS('DM_Antigüedad'[es_vencido] = FALSE))
		formatString: "Q" #,0
		displayFolder: 17 Cuentas por pagar
		lineageTag: bc2ef4ff-db30-40f6-ac98-71ff8d789197

	measure '% Por pagar no vencido' = DIVIDE([Por pagar no vencido], [Saldo por pagar])
		formatString: 0%
		displayFolder: 17 Cuentas por pagar
		lineageTag: 4f2b0314-f7fd-4eb0-b1cb-cfa58820818a

	/// Días de crédito promedio que dan los proveedores en las partidas abiertas.
	measure 'Días autorizados por proveedores' = AVERAGEX('FC_Cartera por pagar', 'FC_Cartera por pagar'[Días de crédito])
		formatString: #,0.0
		displayFolder: 17 Cuentas por pagar
		lineageTag: 8780a291-e7fd-43ff-9dd1-62d5fdb90dc7

	/// Antigüedad promedio de la deuda abierta, ponderada por saldo.
	measure 'Días promedio por pagar' = DIVIDE(SUMX('FC_Cartera por pagar', 'FC_Cartera por pagar'[saldo_pendiente_absoluto] * 'FC_Cartera por pagar'[Días transcurridos]), [Saldo por pagar])
		formatString: #,0
		displayFolder: 17 Cuentas por pagar
		lineageTag: c48dae89-c2df-4370-bddc-0843849227f5

	measure 'Sobregiro en días por pagar' = [Días promedio por pagar] - [Días autorizados por proveedores]
		formatString: +#,0;-#,0;0
		displayFolder: 17 Cuentas por pagar
		lineageTag: 725652b4-9194-4e51-98aa-7a8b9b2d78b2

	/// Detalle de la partida por pagar.
	measure 'Fecha de factura por pagar' = MAX('FC_Cartera por pagar'[fecha_documento])
		formatString: dd/MM/yyyy
		displayFolder: 17 Cuentas por pagar
		lineageTag: 90b2e9a2-dd6b-4da4-aeb7-23f8b8798761

	measure 'Días de crédito de la partida por pagar' = MAX('FC_Cartera por pagar'[Días de crédito])
		formatString: 0
		displayFolder: 17 Cuentas por pagar
		lineageTag: 1066ba26-974b-45e0-a088-0b6a352c00bc

	measure 'Días transcurridos de la partida por pagar' = MAX('FC_Cartera por pagar'[Días transcurridos])
		formatString: 0
		displayFolder: 17 Cuentas por pagar
		lineageTag: cdb1020d-5911-4333-aceb-068e974d338a

	measure 'Estado de la partida por pagar' = MAX('FC_Cartera por pagar'[Estado])
		displayFolder: 17 Cuentas por pagar
		lineageTag: c22e7067-97f2-4ab2-828c-8069bc5b29a6

	measure 'Rango de la partida por pagar' = MAX('FC_Cartera por pagar'[Rango de vencimiento])
		displayFolder: 17 Cuentas por pagar
		lineageTag: 501feb63-01c9-44ac-aab3-3c0b37edaaac

	measure 'Título de Cuentas por pagar' = "Cuentas por pagar"
		displayFolder: _Narrativa
		lineageTag: 227287e1-4861-4ded-8640-170d4b681605

