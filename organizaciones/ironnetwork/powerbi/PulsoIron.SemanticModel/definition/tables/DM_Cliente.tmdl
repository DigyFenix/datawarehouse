table DM_Cliente

	column cliente_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: cliente_clave

	column empresa_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: empresa_id

	column cliente_codigo
		dataType: string
		summarizeBy: none
		sourceColumn: cliente_codigo

	column nombre
		dataType: string
		summarizeBy: none
		sourceColumn: nombre

	column nit
		dataType: string
		summarizeBy: none
		sourceColumn: nit

	column grupo_codigo
		dataType: string
		summarizeBy: none
		sourceColumn: grupo_codigo

	column condicion_pago_codigo
		dataType: string
		summarizeBy: none
		sourceColumn: condicion_pago_codigo

	column pais
		dataType: string
		summarizeBy: none
		sourceColumn: pais

	column region
		dataType: string
		summarizeBy: none
		sourceColumn: region

	column es_tambien_proveedor
		dataType: boolean
		summarizeBy: none
		sourceColumn: es_tambien_proveedor

	column es_intercompania
		dataType: boolean
		summarizeBy: none
		sourceColumn: es_intercompania

	column activo
		dataType: boolean
		summarizeBy: none
		sourceColumn: activo

	column clase_abc_actual
		dataType: string
		summarizeBy: none
		sourceColumn: clase_abc_actual

	column clase_abc_actual_nombre
		dataType: string
		summarizeBy: none
		sourceColumn: clase_abc_actual_nombre

	column segmento_rfm_actual
		dataType: string
		summarizeBy: none
		sourceColumn: segmento_rfm_actual

	column perfil_riesgo_actual
		dataType: string
		summarizeBy: none
		sourceColumn: perfil_riesgo_actual

	column valido_desde
		dataType: dateTime
		isHidden
		summarizeBy: none
		sourceColumn: valido_desde
		formatString: dd/MM/yyyy

	column valido_hasta
		dataType: dateTime
		isHidden
		summarizeBy: none
		sourceColumn: valido_hasta
		formatString: dd/MM/yyyy

	column es_vigente
		dataType: boolean
		isHidden
		summarizeBy: none
		sourceColumn: es_vigente

	/// Alias legibles para encabezados de matrices (las columnas físicas conservan su nombre).
	column Cliente = DM_Cliente[nombre]
		dataType: string
		summarizeBy: none

	column Clase = DM_Cliente[clase_abc_actual_nombre]
		dataType: string
		summarizeBy: none

	/// Meses distintos con compra en los últimos 12 meses al corte.
	column 'Meses con compra 12m' = VAR fin = CALCULATE(MAX(FC_Ventas[fecha_documento]), REMOVEFILTERS()) VAR e = EDATE(fin, -11) VAR ini = DATE(YEAR(e), MONTH(e), 1) RETURN CALCULATE(DISTINCTCOUNT(FC_Ventas[mes_documento]), FC_Ventas[fecha_documento] >= ini && FC_Ventas[fecha_documento] <= fin)
		dataType: int64
		formatString: 0
		summarizeBy: none

	/// Rango de frecuencia (meses con compra en 12): 1-3 · 4-6 · 7-9 · 10-12.
	column 'Rango de meses con compra' = VAR n = DM_Cliente[Meses con compra 12m] RETURN SWITCH(TRUE(), ISBLANK(n) || n = 0, "0", n <= 3, "1-3", n <= 6, "4-6", n <= 9, "7-9", "10-12")
		dataType: string
		summarizeBy: none
		sortByColumn: 'Rango de meses con compra orden'

	column 'Rango de meses con compra orden' = VAR n = DM_Cliente[Meses con compra 12m] RETURN SWITCH(TRUE(), ISBLANK(n) || n = 0, 0, n <= 3, 1, n <= 6, 2, n <= 9, 3, 4)
		dataType: int64
		isHidden
		summarizeBy: none

	/// Meses consecutivos sin compra al corte (desde la última compra).
	column 'Meses sin compra' = VAR fin = CALCULATE(MAX(FC_Ventas[fecha_documento]), REMOVEFILTERS()) VAR u = CALCULATE(MAX(FC_Ventas[fecha_documento])) RETURN IF(ISBLANK(u), BLANK(), DATEDIFF(u, fin, MONTH))
		dataType: int64
		formatString: 0
		summarizeBy: none

	/// Rango de abandono (meses sin compra): 0 · 1-3 · 4-6 · 7-12 · +12.
	column 'Rango de meses sin compra' = VAR n = DM_Cliente[Meses sin compra] RETURN SWITCH(TRUE(), ISBLANK(n), "Sin compra", n = 0, "0 meses", n <= 3, "1-3 meses", n <= 6, "4-6 meses", n <= 12, "7-12 meses", "+12 meses")
		dataType: string
		summarizeBy: none
		sortByColumn: 'Rango de meses sin compra orden'

	column 'Rango de meses sin compra orden' = VAR n = DM_Cliente[Meses sin compra] RETURN SWITCH(TRUE(), ISBLANK(n), 9, n = 0, 0, n <= 3, 1, n <= 6, 2, n <= 12, 3, 4)
		dataType: int64
		isHidden
		summarizeBy: none

	partition DM_Cliente = m
		mode: import
		source =
				let
				    Origen = PostgreSQL.Database(Servidor, BaseDatos),
				    Tabla = Origen{[Schema="oro",Item="dim_cliente"]}[Data]
				in
				    Tabla
