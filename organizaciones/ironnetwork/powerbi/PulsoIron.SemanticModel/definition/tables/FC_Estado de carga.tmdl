	partition 'FC_Estado de carga' = m
		mode: import
		source =
				let
				    Origen = PostgreSQL.Database(Servidor, BaseDatos),
				    Tabla = Origen{[Schema="oro",Item="estado_carga"]}[Data]
				in
				    Tabla

