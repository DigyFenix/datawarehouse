	/// Estado del cobro en lenguaje de negocio. En Odoo `paid` = conciliado contra factura y `in_process` = registrado pero sin conciliar; el usuario decide en el segmentador cuáles cuentan.
	column 'Estado del cobro' = SWITCH('FC_Pagos recibidos'[estado], "paid", "Conciliado", "in_process", "En proceso", "posted", "Registrado", "draft", "Borrador", "cancel", "Cancelado", "canceled", "Cancelado", BLANK(), "Sin estado", 'FC_Pagos recibidos'[estado])
		dataType: string
		lineageTag: 4e53a96e-21f1-4e85-9fab-d8a2380918b3
		summarizeBy: none

	partition 'FC_Pagos recibidos' = m
		mode: import
		source =
				let
				    Origen = PostgreSQL.Database(Servidor, BaseDatos),
				    Tabla = Origen{[Schema="oro",Item="hecho_pago_recibido"]}[Data]
				in
				    Tabla

