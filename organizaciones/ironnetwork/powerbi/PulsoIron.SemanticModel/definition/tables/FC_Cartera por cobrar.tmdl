		dataType: dateTime
		formatString: dd/MM/yyyy
		lineageTag: 6359702b-cb35-487a-9128-7fec9ebc6c69
		summarizeBy: none
		sourceColumn: fecha_documento

		annotation UnderlyingDateTimeDataType = Date

	column fecha_vencimiento
		dataType: dateTime
		formatString: dd/MM/yyyy
		lineageTag: 143c5854-3417-4afc-8447-0e7c8be7cdf2
		summarizeBy: none
		sourceColumn: fecha_vencimiento

		annotation UnderlyingDateTimeDataType = Date

	column fecha_corte
		dataType: dateTime
		formatString: dd/MM/yyyy
		lineageTag: ffca20ee-7a9c-448e-820c-49246f34489a
		summarizeBy: none
		sourceColumn: fecha_corte

		annotation UnderlyingDateTimeDataType = Date

	column monto_original
		dataType: double
		formatString: #,0.00
		lineageTag: 9f860ce3-ca98-4e3c-b7f9-719199c7f3b0
		summarizeBy: sum
		sourceColumn: monto_original

		annotation SummarizationSetBy = Automatic

	column monto_original_doc
		dataType: double
		formatString: #,0.00
		lineageTag: 4278337d-706e-4d7d-9f48-2d45cd2dc86d
		summarizeBy: sum
		sourceColumn: monto_original_doc

		annotation SummarizationSetBy = Automatic

	column saldo_pendiente
		dataType: double
		formatString: #,0.00
		lineageTag: 74193cd7-9a58-40e3-8450-61a348a61b30
		summarizeBy: sum
		sourceColumn: saldo_pendiente

		annotation SummarizationSetBy = Automatic

	column saldo_pendiente_doc
		dataType: double
		formatString: #,0.00
		lineageTag: 09e612b3-455d-4a42-a75f-b5c573448340
		summarizeBy: sum
		sourceColumn: saldo_pendiente_doc

