	/// Días de crédito pactados en la partida (vencimiento − documento).
	column 'Días de crédito' = DATEDIFF('FC_Cartera por cobrar'[fecha_documento], 'FC_Cartera por cobrar'[fecha_vencimiento], DAY)
		dataType: int64
		formatString: 0
		lineageTag: 6232f471-54fa-4035-b764-4546f64dddc3
		summarizeBy: none

	/// Días desde el documento hasta el corte.
	column 'Días transcurridos' = DATEDIFF('FC_Cartera por cobrar'[fecha_documento], 'FC_Cartera por cobrar'[fecha_corte], DAY)
		dataType: int64
		formatString: 0
		lineageTag: fa614357-1e2c-4c6f-96a1-f80dadc30da9
		summarizeBy: none

	/// Vencido / No vencido (días vencido positivos = vencido; negativos = días que faltan).
	column Estado = IF('FC_Cartera por cobrar'[dias_vencido] > 0, "Vencido", "No vencido")
		dataType: string
		lineageTag: b0115991-1507-43b9-b6a4-2b5d46e4f38e
		summarizeBy: none

	/// Rangos finos de vencimiento como en Kraken: por vencer (31+, 22-30, 15-21, 8-14, 7 días) y vencido (1-15, 16-30, 31-60, 61-90, 91+). Etiquetas en lenguaje claro («Vence en 22-30», «Vencido 31-60»): Edwin pidió retirar el «Próx.» y la jerarquía Estado › Rango no abre por PBIR.
	column 'Rango de vencimiento' = VAR d = 'FC_Cartera por cobrar'[dias_vencido] RETURN SWITCH(TRUE(), d > 90, "Vencido 91+", d > 60, "Vencido 61-90", d > 30, "Vencido 31-60", d > 15, "Vencido 16-30", d > 0, "Vencido 1-15", d > -8, "Vence en 7", d > -15, "Vence en 8-14", d > -22, "Vence en 15-21", d > -31, "Vence en 22-30", "Vence en 31+")
		dataType: string
		lineageTag: 3b49be16-f9cf-4a58-b498-7255c4a0cf55
		summarizeBy: none
		sortByColumn: 'Rango de vencimiento orden'

	column 'Rango de vencimiento orden' = VAR d = 'FC_Cartera por cobrar'[dias_vencido] RETURN SWITCH(TRUE(), d > 90, 10, d > 60, 9, d > 30, 8, d > 15, 7, d > 0, 6, d > -8, 5, d > -15, 4, d > -22, 3, d > -31, 2, 1)
		dataType: int64
		isHidden
		lineageTag: 57709200-3a11-4503-935f-c87ed25ec69c
		summarizeBy: none

