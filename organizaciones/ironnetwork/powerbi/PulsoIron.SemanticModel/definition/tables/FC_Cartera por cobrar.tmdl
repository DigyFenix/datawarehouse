table 'FC_Cartera por cobrar'
	lineageTag: 7311785e-0213-4e39-be3c-2686d4f28e5b

	/// Saldo del MAYOR CONTABLE, no del documento, en MONEDA DE PRESENTACIÓN (foto convertida a la tasa vigente).
	measure 'Saldo por cobrar' = SUM('FC_Cartera por cobrar'[saldo_pendiente])
		formatString: "Q" #,0
		displayFolder: 01 Saldo
		lineageTag: c9d8890b-b502-4738-a127-30066ffeb488

	/// Lo que deben los clientes reales. Sin separar el grupo, un aging estándar reporta una crisis de cartera que no existe.
	measure 'Saldo por cobrar terceros' = CALCULATE([Saldo por cobrar], DM_Cliente[es_intercompania] = FALSE)
		formatString: "Q" #,0
		displayFolder: 01 Saldo
		lineageTag: f4908250-b1a0-454f-a786-541d6e4d532d

	/// Saldo entre empresas del propio grupo. Leerlo junto al de terceros hace parecer una crisis de cobranza que no existe.
	measure 'Saldo por cobrar grupo' = CALCULATE([Saldo por cobrar], DM_Cliente[es_intercompania] = TRUE)
		formatString: "Q" #,0
		displayFolder: 01 Saldo
		lineageTag: 73e1b4be-3bb7-46ff-836c-67ebcd27c0d0

	/// Número de partidas abiertas en el mayor.
	measure 'Partidas por cobrar' = COUNTROWS('FC_Cartera por cobrar')
		formatString: #,0
		displayFolder: 02 Conteos
		lineageTag: 65f5f817-55e3-4f7d-ae02-7974ad3d8771

	/// Clientes distintos con saldo pendiente.
	measure 'Clientes con saldo' = DISTINCTCOUNT('FC_Cartera por cobrar'[cliente_clave])
		formatString: #,0
		displayFolder: 02 Conteos
		lineageTag: d9cda14e-8e8f-4c13-a32d-35ee5ba98cb3

	/// Exposición media por cliente con deuda.
	measure 'Saldo promedio por cliente' = DIVIDE([Saldo por cobrar], [Clientes con saldo])
		formatString: "Q" #,0
		displayFolder: 02 Conteos
		lineageTag: 74aec698-406a-429b-a492-42458da43ff4

	/// Lo que aún no vence: es cobranza futura, no un problema.
	measure 'Saldo corriente' = CALCULATE([Saldo por cobrar], KEEPFILTERS('DM_Antigüedad'[es_vencido] = FALSE))
		formatString: "Q" #,0
		displayFolder: 03 Antigüedad
		lineageTag: de3a7ad8-0537-4e86-abcd-01dd921b299d

	/// Lo que ya pasó su fecha de pago, grupo incluido.
	measure 'Saldo vencido' = CALCULATE([Saldo por cobrar], KEEPFILTERS('DM_Antigüedad'[es_vencido] = TRUE))
		formatString: "Q" #,0
		displayFolder: 03 Antigüedad
		lineageTag: 35458919-f4ca-47a2-a791-5b46de25e23d

	/// La mora que de verdad hay que cobrar: vencida y fuera del grupo.
	measure 'Saldo vencido terceros' = CALCULATE([Saldo por cobrar], KEEPFILTERS('DM_Antigüedad'[es_vencido] = TRUE), DM_Cliente[es_intercompania] = FALSE)
		formatString: "Q" #,0
		displayFolder: 03 Antigüedad
		lineageTag: f62cdc0c-03ab-4473-8ccb-7f9411bc63d9

	/// Qué porción de la cartera está vencida. Mezcla el grupo; para gestión comercial usar la versión de terceros.
	measure '% Vencido' = DIVIDE([Saldo vencido], [Saldo por cobrar])
		formatString: 0.0%
		displayFolder: 03 Antigüedad
		lineageTag: 66960f58-a567-4a82-94a6-114447e433b9

	/// El indicador de salud de cobranza que sí se puede accionar.
	measure '% Vencido terceros' = DIVIDE([Saldo vencido terceros], [Saldo por cobrar terceros])
		formatString: 0.0%
		displayFolder: 03 Antigüedad
		lineageTag: 2b70c1b3-0c7e-459a-bea3-f875fe589315

	/// Primer tramo de mora: normalmente es olvido o trámite, no riesgo.
	measure 'Vencido 1 a 30' = CALCULATE([Saldo por cobrar], KEEPFILTERS('DM_Antigüedad'[rango_aging] = "1-30"))
		formatString: "Q" #,0
		displayFolder: 03 Antigüedad
		lineageTag: 3842d112-3d9b-4316-b9b2-48f312669b4b

	/// Segundo tramo: aquí la gestión de cobranza tiene que estar activa.
	measure 'Vencido 31 a 60' = CALCULATE([Saldo por cobrar], KEEPFILTERS('DM_Antigüedad'[rango_aging] = "31-60"))
		formatString: "Q" #,0
		displayFolder: 03 Antigüedad
		lineageTag: 7499c398-459a-4dd3-a05a-202c7efba21d

	/// Tercer tramo: la probabilidad de cobro empieza a caer de verdad.
	measure 'Vencido 61 a 90' = CALCULATE([Saldo por cobrar], KEEPFILTERS('DM_Antigüedad'[rango_aging] = "61-90"))
		formatString: "Q" #,0
		displayFolder: 03 Antigüedad
		lineageTag: ce36959d-dbd7-41ca-87b0-ff0405e33c76

	/// Deuda vieja. Es la candidata natural a provisión y la que conviene mirar cliente por cliente.
	measure 'Vencido más de 90' = CALCULATE([Saldo por cobrar], KEEPFILTERS('DM_Antigüedad'[rango_aging] = "+90"))
		formatString: "Q" #,0
		displayFolder: 03 Antigüedad
		lineageTag: 66e4de57-9acd-445c-98a3-a7e6c421ea74

	/// Riesgo alto: lo que pasó de 90 días pesa distinto en una provisión que lo que apenas venció.
	measure '% Crítico más de 90' = DIVIDE([Vencido más de 90], [Saldo por cobrar])
		formatString: 0.0%
		displayFolder: 03 Antigüedad
		lineageTag: 10d8dbf2-cd07-4f49-b341-73ffda4a41a9

	/// Días vencidos promedio ponderados por saldo: un promedio simple deja que una partida chica de 400 días arruine el indicador.
	measure 'Días vencido promedio' = DIVIDE(SUMX('FC_Cartera por cobrar', 'FC_Cartera por cobrar'[saldo_pendiente] * 'FC_Cartera por cobrar'[dias_vencido]), [Saldo por cobrar])
		formatString: #,0.0
		displayFolder: 04 Riesgo
		lineageTag: 0a13ce3f-ea99-4f64-9b96-06c713a1d52b

	/// Días de venta a terceros pendientes de cobro. Mezclar el saldo del grupo lo triplica.
	measure 'Días de cartera terceros' = DIVIDE([Saldo por cobrar terceros], DIVIDE([Ventas a terceros], CALCULATE(DISTINCTCOUNT(DM_Calendario[fecha]), FC_Ventas)))
		formatString: #,0.0
		displayFolder: 04 Riesgo
		lineageTag: 1e7f8350-3b05-4627-85b7-ff7f6b0d9e08

	/// Foto de HOY: ignora el filtro de fechas de la página. El saldo es una foto, no un flujo — recortarlo al trimestre ocultaría las facturas viejas abiertas.
	measure 'Por cobrar terceros hoy' = CALCULATE([Saldo por cobrar terceros], REMOVEFILTERS(DM_Calendario))
		formatString: "Q" #,0
		displayFolder: 05 Foto de hoy
		lineageTag: e07c255d-9c3a-4e98-aa12-94b4570e9035

	/// Saldo entre empresas del grupo, foto de hoy. No es riesgo de crédito: es conciliación pendiente.
	measure 'Por cobrar grupo hoy' = CALCULATE([Saldo por cobrar grupo], REMOVEFILTERS(DM_Calendario))
		formatString: "Q" #,0
		displayFolder: 05 Foto de hoy
		lineageTag: 38be8bd4-09d1-4b6d-8bab-f7e561977b82

	/// Mora real a hoy, ignorando el filtro de fechas de la página.
	measure 'Vencido terceros hoy' = CALCULATE([Saldo vencido terceros], REMOVEFILTERS(DM_Calendario))
		formatString: "Q" #,0
		displayFolder: 05 Foto de hoy
		lineageTag: b5e63f1b-8d8b-48a7-b13d-9d3c33bbad3e

	/// Salud de la cobranza a día de hoy, sin que el período seleccionado la maquille.
	measure '% Vencido terceros hoy' = DIVIDE([Vencido terceros hoy], [Por cobrar terceros hoy])
		formatString: 0.0%
		displayFolder: 05 Foto de hoy
		lineageTag: 0a7a802a-7e41-4ea0-8900-1b830b8a5395

	/// Veces al año que se cobra la cartera completa. Es el recíproco de los días de cartera, más fácil de comparar entre empresas.
	measure 'Rotación de cartera' = DIVIDE(365, [Días de cartera terceros])
		formatString: #,0.0
		displayFolder: 04 Riesgo
		lineageTag: 56790f7f-ff46-47dc-ae98-9b2654cdab3d

	/// LA AGENDA DE COBRO. El calendario filtra por fecha de DOCUMENTO en todo el modelo; esta medida lo conmuta a la fecha de VENCIMIENTO con la relación inactiva, y es la única forma de responder "¿qué tengo que cobrar esta semana?". El resto de la página sigue leyéndose por fecha de documento: el cambio de eje vive dentro de la medida y no se propaga.
	measure 'Cobro que vence en el período' = CALCULATE([Saldo por cobrar terceros], USERELATIONSHIP('FC_Cartera por cobrar'[tiempo_vencimiento_clave], DM_Calendario[tiempo_clave]))
		formatString: "Q" #,0
		displayFolder: 07 Agenda de vencimiento
		lineageTag: 391b7c8a-6204-4997-90ae-719be7b7e001

	/// Partidas sin fecha de vencimiento pactada: no son ni corrientes ni vencidas, y suelen ser anticipos o ajustes sin depurar.
	measure 'Saldo sin vencimiento' = CALCULATE([Saldo por cobrar], KEEPFILTERS('DM_Antigüedad'[rango_aging] = "sin_vencimiento"))
		formatString: "Q" #,0
		displayFolder: 03 Antigüedad
		lineageTag: 3dae0afc-a2af-41c8-a901-088b9fcbd1a4

	/// Cuánto nos debe el cliente más expuesto. Si un solo deudor concentra la cartera, el riesgo no está diversificado.
	measure 'Exposición mayor deudor' = MAXX(ALLSELECTED(DM_Cliente), [Saldo por cobrar terceros])
		formatString: "Q" #,0
		displayFolder: 06 Concentración
		lineageTag: 41a87b22-ab37-4f75-8892-2cadd69cfbfa

	/// Cuánto pesa el cliente que más debe. Si un solo nombre concentra la cartera, el riesgo no está diversificado.
	measure '% Exposición mayor deudor' = DIVIDE([Exposición mayor deudor], CALCULATE([Saldo por cobrar terceros], ALLSELECTED(DM_Cliente)))
		formatString: 0.0%
		displayFolder: 06 Concentración
		lineageTag: 2f8b10ed-a3d7-466e-8c49-d5d792e24a25

	/// Concentración de la deuda en los cinco mayores.
	measure '% Saldo en top 5 deudores' = DIVIDE(CALCULATE([Saldo por cobrar terceros], TOPN(5, ALLSELECTED(DM_Cliente), [Saldo por cobrar terceros])), CALCULATE([Saldo por cobrar terceros], ALLSELECTED(DM_Cliente)))
		formatString: 0.0%
		displayFolder: 06 Concentración
		lineageTag: 71f3c4bc-e977-429b-b72a-3cd3850dc670

	/// Título de la página 09.
	measure 'Título de Cartera y cobranza' = "09 · Cartera y cobranza · " & [Período activo]
		displayFolder: _Narrativa
		lineageTag: 2ad75c21-72b5-4f14-89df-1399fc63be6e

	/// Subtítulo del aging (página 09). Declara la salvedad que más se malinterpreta en el tablero: el saldo es una FOTO y las tarjetas ignoran el período a propósito — recortarlo escondería las facturas viejas, que son justo las que hay que cobrar.
	measure 'Subtítulo del aging de terceros' = VAR s = [Por cobrar terceros hoy] VAR v = [Vencido terceros hoy] VAR p = [% Vencido terceros hoy] RETURN IF(ISBLANK(s) || s = 0, "Sin saldo por cobrar de terceros", (IF(s < 0, "-", "") & "Q" & SWITCH(TRUE(), ABS(s) >= 1000000, FORMAT(ABS(s) / 1000000, "#,##0.0") & "M", ABS(s) >= 10000, FORMAT(ABS(s) / 1000, "#,##0") & "K", FORMAT(ABS(s), "#,##0"))) & " por cobrar de terceros · " & (IF(v < 0, "-", "") & "Q" & SWITCH(TRUE(), ABS(v) >= 1000000, FORMAT(ABS(v) / 1000000, "#,##0.0") & "M", ABS(v) >= 10000, FORMAT(ABS(v) / 1000, "#,##0") & "K", FORMAT(ABS(v), "#,##0"))) & " vencido (" & FORMAT(p, "0.0%") & ") · foto de hoy, ignora el período seleccionado")
		displayFolder: _Narrativa
		lineageTag: a6209cbc-0333-4c19-8fb1-cae3cc7a3704

	/// Subtítulo de la agenda de cobro (página 09). Lo que vence en el período elegido, por fecha de VENCIMIENTO y no de documento: es la diferencia entre "qué facturé" y "qué tengo que cobrar".
	measure 'Subtítulo de la agenda de cobro' = VAR c = [Cobro que vence en el período] RETURN IF(ISBLANK(c) || c = 0, "Nada vence en " & [Período activo], (IF(c < 0, "-", "") & "Q" & SWITCH(TRUE(), ABS(c) >= 1000000, FORMAT(ABS(c) / 1000000, "#,##0.0") & "M", ABS(c) >= 10000, FORMAT(ABS(c) / 1000, "#,##0") & "K", FORMAT(ABS(c), "#,##0"))) & " vence en " & [Período activo] & " · por fecha de vencimiento, no de documento")
		displayFolder: _Narrativa
		lineageTag: 72138179-f753-46a2-8278-7513014b208d

	/// Texto del foco de cartera vencida (página 01). Foto de hoy: ignora el período a propósito.
	measure 'Alerta de vencido' = VAR v = [Vencido terceros hoy] VAR p = [% Vencido terceros hoy] RETURN IF(ISBLANK(v) || v = 0, "Sin cartera vencida de terceros", (IF(v < 0, "-", "") & "Q" & SWITCH(TRUE(), ABS(v) >= 1000000, FORMAT(ABS(v) / 1000000, "#,##0.0") & "M", ABS(v) >= 10000, FORMAT(ABS(v) / 1000, "#,##0") & "K", FORMAT(ABS(v), "#,##0"))) & " vencido de terceros hoy · " & FORMAT(p, "0.0%") & " de la cartera")
		displayFolder: _Narrativa
		lineageTag: 7a766c1f-f9ff-4351-94fd-256115e0d4e9

	/// Proporción del saldo que aún no vence.
	measure '% No vencido' = DIVIDE([Saldo corriente], [Saldo por cobrar])
		formatString: 0%
		displayFolder: 15 Cuentas por cobrar
		lineageTag: 11f73390-5466-4f49-bb4f-dbc2a510efb8

	/// Límite de crédito autorizado (suma de los clientes en contexto; en Odoo `credit_limit`, en SAP B1 `CreditLine`).
	measure 'Límite de crédito' = SUM(DM_Cliente[limite_credito])
		formatString: "Q" #,0
		displayFolder: 15 Cuentas por cobrar
		lineageTag: 25cd6270-6dcb-43e1-938f-b351b74c338a

	/// Saldo por cobrar sobre el límite de crédito.
	measure '% Límite utilizado' = DIVIDE([Saldo por cobrar], [Límite de crédito])
		formatString: 0%
		displayFolder: 15 Cuentas por cobrar
		lineageTag: 4868bce1-4f04-4c4c-b204-e5f9a6e302fe

	/// Promedio simple de los días de crédito pactados en las partidas abiertas.
	measure 'Días autorizados' = AVERAGEX('FC_Cartera por cobrar', 'FC_Cartera por cobrar'[Días de crédito])
		formatString: #,0.0
		displayFolder: 15 Cuentas por cobrar
		lineageTag: 77650cdf-a11d-4b2f-820c-b4c16d8cb354

	/// Antigüedad promedio de la cartera abierta, ponderada por saldo (días desde el documento).
	measure 'Días promedio de cartera' = DIVIDE(SUMX('FC_Cartera por cobrar', 'FC_Cartera por cobrar'[saldo_pendiente] * 'FC_Cartera por cobrar'[Días transcurridos]), [Saldo por cobrar])
		formatString: #,0
		displayFolder: 15 Cuentas por cobrar
		lineageTag: ec743e02-62b4-47b6-ba04-2aecd8d4869d

	/// Cuántos días por encima (+) o por debajo (−) del crédito autorizado está la cartera.
	measure 'Sobregiro en días' = [Días promedio de cartera] - [Días autorizados]
		formatString: +#,0;-#,0;0
		displayFolder: 15 Cuentas por cobrar
		lineageTag: c50c29c6-4349-4bc7-befa-c298e7ce400d

	/// Detalle de la partida (una fila por documento): fecha, días, estado, rango.
	measure 'Fecha de factura' = MAX('FC_Cartera por cobrar'[fecha_documento])
		formatString: dd/MM/yyyy
		displayFolder: 15 Cuentas por cobrar
		lineageTag: fcb1b383-4250-4f2d-8936-0d7a833e0365

	measure 'Días de crédito de la partida' = MAX('FC_Cartera por cobrar'[Días de crédito])
		formatString: 0
		displayFolder: 15 Cuentas por cobrar
		lineageTag: 1bb25082-90d8-4be5-bb3a-562502003c8b

	measure 'Días transcurridos de la partida' = MAX('FC_Cartera por cobrar'[Días transcurridos])
		formatString: 0
		displayFolder: 15 Cuentas por cobrar
		lineageTag: d537eaa7-bb0a-4fe2-bd7e-d86111346626

	measure 'Estado de la partida' = MAX('FC_Cartera por cobrar'[Estado])
		displayFolder: 15 Cuentas por cobrar
		lineageTag: 052af5ab-4a3e-4ff5-bc60-5be88e47b815

	measure 'Rango de la partida' = MAX('FC_Cartera por cobrar'[Rango de vencimiento])
		displayFolder: 15 Cuentas por cobrar
		lineageTag: 0c6bbea9-587d-4f9a-ad84-9a11bf69370e

	/// Saldo histórico al último corte disponible dentro del mes del eje (la línea "Saldo" de cargos y abonos).
	measure 'Saldo al cierre del mes' = VAR f = MAX(DM_Calendario[fecha]) VAR hayDato = MIN(DM_Calendario[fecha]) <= [Corte de ventas] VAR corte = CALCULATE(MAX('FC_Cartera cobrar histórico'[fecha_corte]), REMOVEFILTERS(DM_Calendario), 'FC_Cartera cobrar histórico'[fecha_corte] <= f) RETURN IF(ISBLANK(corte) || NOT hayDato, BLANK(), CALCULATE([Saldo histórico por cobrar], REMOVEFILTERS(DM_Calendario), 'FC_Cartera cobrar histórico'[fecha_corte] = corte))
		formatString: "Q" #,0
		displayFolder: 16 Cobros
		lineageTag: d1287dc5-4b63-4ef3-8f25-3ae7e2a23913

	/// Títulos.
	measure 'Título de Cuentas por cobrar' = "Cuentas por cobrar"
		displayFolder: _Narrativa
		lineageTag: 4b186201-c790-4959-b128-c06a923d4eb1

	measure 'Título de Cobros' = "Recuperación y cobros"
		displayFolder: _Narrativa
		lineageTag: 15b1bab6-9e7d-4b0b-ae58-771891c45c9b

