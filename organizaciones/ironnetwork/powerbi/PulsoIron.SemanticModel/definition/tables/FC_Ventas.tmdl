table FC_Ventas

	column tiempo_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: tiempo_clave

	column cliente_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: cliente_clave

	column socio_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: socio_clave

	column direccion_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: direccion_clave

	column producto_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: producto_clave

	column vendedor_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: vendedor_clave

	column organizacion_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: organizacion_clave

	column almacen_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: almacen_clave

	column moneda_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: moneda_clave

	column cuenta_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: cuenta_clave

	column centro_costo_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: centro_costo_clave

	column tipo_documento_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: tipo_documento_clave

	column canal_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: canal_clave

	column condicion_pago_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: condicion_pago_clave

	column empresa_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: empresa_id

	column documento_id
		dataType: string
		summarizeBy: none
		sourceColumn: documento_id

	column documento_numero
		dataType: string
		summarizeBy: none
		sourceColumn: documento_numero

	column serie_codigo
		dataType: string
		summarizeBy: none
		sourceColumn: serie_codigo

	column tipo_documento_origen
		dataType: string
		summarizeBy: none
		sourceColumn: tipo_documento_origen

	column referencia_externa
		dataType: string
		summarizeBy: none
		sourceColumn: referencia_externa

	column linea_numero
		dataType: int64
		summarizeBy: none
		sourceColumn: linea_numero
		formatString: #,0

	column tipo_documento
		dataType: string
		summarizeBy: none
		sourceColumn: tipo_documento

	column fecha_documento
		dataType: dateTime
		summarizeBy: none
		sourceColumn: fecha_documento
		formatString: dd/MM/yyyy

	column cantidad
		dataType: decimal
		summarizeBy: none
		sourceColumn: cantidad
		formatString: #,0.00

	column monto_sin_impuesto
		dataType: decimal
		summarizeBy: none
		sourceColumn: monto_sin_impuesto
		formatString: #,0.00

	column monto_impuesto
		dataType: decimal
		summarizeBy: none
		sourceColumn: monto_impuesto
		formatString: #,0.00

	column monto_con_impuesto
		dataType: decimal
		summarizeBy: none
		sourceColumn: monto_con_impuesto
		formatString: #,0.00

	column monto_sin_impuesto_doc
		dataType: decimal
		summarizeBy: none
		sourceColumn: monto_sin_impuesto_doc
		formatString: #,0.00

	column monto_impuesto_doc
		dataType: decimal
		summarizeBy: none
		sourceColumn: monto_impuesto_doc
		formatString: #,0.00

	column monto_con_impuesto_doc
		dataType: decimal
		summarizeBy: none
		sourceColumn: monto_con_impuesto_doc
		formatString: #,0.00

	column monto_descuento
		dataType: decimal
		summarizeBy: none
		sourceColumn: monto_descuento
		formatString: #,0.00

	column descuento_pct
		dataType: decimal
		summarizeBy: none
		sourceColumn: descuento_pct
		formatString: 0.0"%"

	column costo
		dataType: decimal
		summarizeBy: none
		sourceColumn: costo
		formatString: #,0.00

	column margen
		dataType: decimal
		summarizeBy: none
		sourceColumn: margen
		formatString: #,0.00

	column saldo_pendiente
		dataType: decimal
		summarizeBy: none
		sourceColumn: saldo_pendiente
		formatString: #,0.00

	column estado_pago
		dataType: string
		summarizeBy: none
		sourceColumn: estado_pago

	column proceso_transformacion
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: proceso_transformacion

	column version_proceso
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: version_proceso

	/// Base de todo: venta sin impuestos en MONEDA DE PRESENTACIÓN (consolidable entre sociedades), con la nota de crédito ya en negativo. Una sociedad sin tasa válida no suma aquí (regla: sin tipo de cambio, no se consolida).
	measure 'Ventas netas' = SUM(FC_Ventas[monto_sin_impuesto])
		formatString: "Q" #,0
		displayFolder: 01 Importes

	/// Lo que el cliente realmente paga. Sale de la CABECERA del documento y no de la suma de líneas: el IVA se calcula por documento y sumarlo línea a línea desvía centavos contra el ERP.
	measure 'Ventas netas con IVA' = SUM(FC_Ventas[monto_con_impuesto])
		formatString: "Q" #,0
		displayFolder: 01 Importes

	/// Facturación del período antes de restar devoluciones.
	measure 'Ventas brutas' = CALCULATE([Ventas netas], KEEPFILTERS('DM_Tipo de documento'[tipo_documento] = "factura"))
		formatString: "Q" #,0
		displayFolder: 01 Importes

	/// Notas de crédito del período, en positivo para poder compararlas contra la venta.
	measure Devoluciones = ABS(CALCULATE([Ventas netas], KEEPFILTERS('DM_Tipo de documento'[tipo_documento] = "nota_credito")))
		formatString: "Q" #,0
		displayFolder: 01 Importes

	/// IVA de las ventas. Se queda en moneda LOCAL aunque el resto del modelo esté en moneda de presentación: es un concepto fiscal del país de cada sociedad.
	measure 'Impuesto facturado' = SUM(FC_Ventas[monto_impuesto])
		formatString: "Q" #,0
		displayFolder: 01 Importes

	/// Descuento concedido, tomado de lo realmente grabado en cada línea y no de una lista de precios teórica.
	measure 'Descuento otorgado' = SUM(FC_Ventas[monto_descuento])
		formatString: "Q" #,0
		displayFolder: 01 Importes

	/// Cuánto del precio se está cediendo. Que suba sin que suba el volumen es erosión de precio, no una promoción que funciona.
	measure '% Descuento' = DIVIDE([Descuento otorgado], [Ventas netas] + [Descuento otorgado])
		formatString: 0.0%
		displayFolder: 01 Importes

	/// Saldo pendiente de las facturas visibles, prorrateado por línea (suma = saldo del documento). INFORMATIVO: la cartera oficial sale del mayor.
	measure 'Saldo de facturas' = SUM(FC_Ventas[saldo_pendiente])
		formatString: "Q" #,0
		displayFolder: 01 Importes

	/// El mercado real. La venta al grupo no compite por precio: mezclarla distorsiona todo indicador comercial.
	measure 'Ventas a terceros' = CALCULATE([Ventas netas], DM_Cliente[es_intercompania] = FALSE)
		formatString: "Q" #,0
		displayFolder: 02 Terceros vs grupo

	/// Facturación a otras empresas del propio grupo. Ni compite por precio ni la trabaja un vendedor.
	measure 'Ventas al grupo' = CALCULATE([Ventas netas], DM_Cliente[es_intercompania] = TRUE)
		formatString: "Q" #,0
		displayFolder: 02 Terceros vs grupo

	/// Qué parte de la facturación es movimiento interno entre compañías del grupo. Cuando pesa, cambia la lectura de cualquier ranking comercial: revisarla antes de comparar clientes.
	measure '% Venta al grupo' = DIVIDE([Ventas al grupo], [Ventas netas])
		formatString: 0.0%
		displayFolder: 02 Terceros vs grupo

	/// Cantidad neta despachada; la nota de crédito resta.
	measure 'Unidades vendidas' = SUM(FC_Ventas[cantidad])
		formatString: #,0
		displayFolder: 03 Conteos

	/// Número de líneas de documento — el grano del hecho.
	measure 'Líneas de venta' = COUNTROWS(FC_Ventas)
		formatString: #,0
		displayFolder: 03 Conteos

	/// Facturas y notas de crédito distintas emitidas en el período.
	measure 'Documentos de venta' = DISTINCTCOUNT(FC_Ventas[documento_id])
		formatString: #,0
		displayFolder: 03 Conteos

	/// Clientes distintos con movimiento neto en el período.
	measure 'Clientes con venta' = CALCULATE(DISTINCTCOUNT(FC_Ventas[cliente_clave]), KEEPFILTERS(FC_Ventas[monto_sin_impuesto] <> 0))
		formatString: #,0
		displayFolder: 03 Conteos

	/// Artículos distintos con movimiento: la parte del catálogo que de verdad rota.
	measure 'Productos vendidos' = DISTINCTCOUNT(FC_Ventas[producto_clave])
		formatString: #,0
		displayFolder: 03 Conteos

	/// Venta media por documento. Subirlo suele costar menos que conseguir un cliente nuevo.
	measure 'Ticket promedio' = DIVIDE([Ventas netas], [Documentos de venta])
		formatString: "Q" #,0
		displayFolder: 04 Promedios

	/// Precio medio realmente cobrado. Solo significa algo con UN producto filtrado: mezclado entre artículos distintos no dice nada.
	measure 'Precio promedio unidad' = DIVIDE([Ventas netas], [Unidades vendidas])
		formatString: "Q" #,0.00
		displayFolder: 04 Promedios

	/// Tamaño medio de la línea de documento.
	measure 'Venta promedio por línea' = DIVIDE([Ventas netas], [Líneas de venta])
		formatString: "Q" #,0
		displayFolder: 04 Promedios

	/// Promedio sobre los días que SÍ hubo venta: no diluye con domingos y feriados.
	measure 'Venta promedio diaria' = DIVIDE([Ventas netas], CALCULATE(DISTINCTCOUNT(DM_Calendario[fecha]), FC_Ventas))
		formatString: "Q" #,0
		displayFolder: 04 Promedios

	/// Facturación media por cliente activo en el período.
	measure 'Venta promedio por cliente' = DIVIDE([Ventas netas], [Clientes con venta])
		formatString: "Q" #,0
		displayFolder: 04 Promedios

	/// Costo registrado en la línea al momento de facturar. Solo existe en SAP B1; en Odoo la línea no lo trae y la medida sale en cero.
	measure 'Costo de ventas' = SUM(FC_Ventas[costo])
		formatString: "Q" #,0
		displayFolder: 05 Rentabilidad

	/// Venta neta menos costo, calculado línea a línea. Cero en Odoo por la misma razón que el costo.
	measure 'Margen bruto' = SUM(FC_Ventas[margen])
		formatString: "Q" #,0
		displayFolder: 05 Rentabilidad

	/// Rentabilidad sobre la venta, grupo incluido. Para el margen del mercado real usar '% Margen terceros'.
	measure '% Margen' = DIVIDE([Margen bruto], [Ventas netas])
		formatString: 0.0%
		displayFolder: 05 Rentabilidad

	/// El margen de mercado. Incluir la venta al grupo, que no compite por precio, infla el indicador.
	measure '% Margen terceros' = DIVIDE(CALCULATE([Margen bruto], DM_Cliente[es_intercompania] = FALSE), [Ventas a terceros])
		formatString: 0.0%
		displayFolder: 05 Rentabilidad

	/// Mismo período del mes anterior (respeta el filtro de fechas del visual).
	measure 'Ventas mes anterior' = CALCULATE([Ventas netas], DATEADD(DM_Calendario[fecha], -1, MONTH))
		formatString: "Q" #,0
		displayFolder: 06 Comparativos

	/// El mismo período del año pasado. En un negocio con temporada dice más que la comparación contra el mes anterior.
	measure 'Ventas año anterior' = CALCULATE([Ventas netas], DATEADD(DM_Calendario[fecha], -1, YEAR))
		formatString: "Q" #,0
		displayFolder: 06 Comparativos

	/// Acumulado del mes en curso hasta el último día con datos del filtro.
	measure 'Ventas acumuladas mes' = TOTALMTD([Ventas netas], DM_Calendario[fecha])
		formatString: "Q" #,0
		displayFolder: 06 Comparativos

	/// Acumulado desde el inicio del trimestre hasta la fecha del contexto.
	measure 'Ventas acumuladas trimestre' = TOTALQTD([Ventas netas], DM_Calendario[fecha])
		formatString: "Q" #,0
		displayFolder: 06 Comparativos

	/// Acumulado desde el 1 de enero: la cifra con la que se mide el ejercicio.
	measure 'Ventas acumuladas año' = TOTALYTD([Ventas netas], DM_Calendario[fecha])
		formatString: "Q" #,0
		displayFolder: 06 Comparativos

	/// El acumulado del año PASADO al mismo corte: el comparable correcto del YTD.
	measure 'Ventas acumuladas año anterior' = CALCULATE(TOTALYTD([Ventas netas], DM_Calendario[fecha]), DATEADD(DM_Calendario[fecha], -1, YEAR))
		formatString: "Q" #,0
		displayFolder: 06 Comparativos

	/// Crecimiento contra el mes previo. Cuidado con la estacionalidad: un mes flojo puede ser normal para la época.
	measure 'Variación vs mes anterior' = DIVIDE([Ventas netas] - [Ventas mes anterior], [Ventas mes anterior])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 06 Comparativos

	/// Crecimiento contra el mismo período del año pasado, ya libre del efecto estacional.
	measure 'Variación vs año anterior' = DIVIDE([Ventas netas] - [Ventas año anterior], [Ventas año anterior])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 06 Comparativos

	/// Cómo va el ejercicio completo contra el anterior. Es la que se lleva a una junta.
	measure 'Variación acumulada vs año anterior' = DIVIDE([Ventas acumuladas año] - [Ventas acumuladas año anterior], [Ventas acumuladas año anterior])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 06 Comparativos

	/// Fin de la ventana móvil: el corte del contexto, pero nunca más allá del último día CON DATO. El calendario llega a 2032 para cubrir vencimientos y series proyectadas del ERP, así que anclar en MAX(Calendario[fecha]) dejaba toda ventana móvil apuntando a un futuro vacío y devolviendo BLANK. Con un período filtrado el ancla es el fin del período, que es lo correcto.
	measure '_Fecha ancla móvil' = VAR fin = MAX(DM_Calendario[fecha]) VAR ultimo_dato = CALCULATE(MAX(FC_Ventas[fecha_documento]), ALL(DM_Calendario)) RETURN MIN(fin, ultimo_dato)
		formatString: yyyy-mm-dd
		displayFolder: _Auxiliar
		isHidden

	/// Promedio MENSUAL de los últimos 3 meses: alisa el diente de sierra de la facturación. (Iterar días con DATESINPERIOD daba un promedio diario disfrazado de mensual.)
	measure 'Media móvil 3 meses' = CALCULATE(AVERAGEX(VALUES(DM_Calendario[anio_mes]), [Ventas netas]), DATESINPERIOD(DM_Calendario[fecha], [_Fecha ancla móvil], -3, MONTH))
		formatString: "Q" #,0
		displayFolder: 06 Comparativos

	/// Año móvil: los últimos 12 meses completos desde el corte. Quita la estacionalidad del calendario.
	measure 'Ventas 12 meses móviles' = CALCULATE([Ventas netas], DATESINPERIOD(DM_Calendario[fecha], [_Fecha ancla móvil], -12, MONTH))
		formatString: "Q" #,0
		displayFolder: 06 Comparativos

	/// Venta de líneas sin artículo (servicios, fletes, gastos) — el miembro SERVICIO de Producto.
	measure 'Ventas de servicios' = CALCULATE([Ventas netas], KEEPFILTERS(DM_Producto[producto_codigo] = "SERVICIO"))
		formatString: "Q" #,0
		displayFolder: 01 Importes

	/// Posición del cliente ordenado por venta a terceros, dentro del filtro vigente.
	measure 'Ranking de cliente por venta' = RANKX(ALLSELECTED(DM_Cliente), [Ventas a terceros])
		formatString: #,0
		displayFolder: 07 Pareto

	/// Curva de Pareto: % de la venta a terceros que acumulan este cliente y los mayores que él. La venta por cliente se materializa UNA vez en `base`: la versión anterior reevaluaba la medida dentro del FILTER, una vez por cliente y por cliente, lo que es cuadrático y se nota con miles de clientes.
	measure '% acumulado de venta clientes' = VAR base = ADDCOLUMNS(ALLSELECTED(DM_Cliente), "@v", [Ventas a terceros]) VAR actual = [Ventas a terceros] VAR total = SUMX(base, [@v]) VAR acum = SUMX(FILTER(base, [@v] >= actual), [@v]) RETURN DIVIDE(acum, total)
		formatString: 0.0%
		displayFolder: 07 Pareto

	/// Posición del producto por venta neta dentro del filtro vigente.
	measure 'Ranking de producto por venta' = RANKX(ALLSELECTED(DM_Producto), [Ventas netas])
		formatString: #,0
		displayFolder: 07 Pareto

	/// Curva de Pareto de productos sobre la venta neta. Misma materialización en `base` que la curva de clientes.
	measure '% acumulado de venta productos' = VAR base = ADDCOLUMNS(ALLSELECTED(DM_Producto), "@v", [Ventas netas]) VAR actual = [Ventas netas] VAR total = SUMX(base, [@v]) VAR acum = SUMX(FILTER(base, [@v] >= actual), [@v]) RETURN DIVIDE(acum, total)
		formatString: 0.0%
		displayFolder: 07 Pareto

	/// Peso de los 10 mayores clientes: la medida de riesgo comercial. Si perder un cliente hunde el año, se sabe aquí.
	measure '% Venta en top 10 clientes' = DIVIDE(CALCULATE([Ventas a terceros], TOPN(10, ALLSELECTED(DM_Cliente), [Ventas a terceros])), CALCULATE([Ventas a terceros], ALLSELECTED(DM_Cliente)))
		formatString: 0.0%
		displayFolder: 07 Pareto

	/// Amplitud de catálogo: cuántos productos distintos se le venden al cliente promedio. Subirla es la venta cruzada.
	measure 'Productos por cliente' = DIVIDE([Productos vendidos], [Clientes con venta])
		formatString: #,0.0
		displayFolder: 04 Promedios

	/// Venta facturada por DEBAJO del costo registrado en la línea. Es fuga de margen pura, no una promoción: nadie la autorizó.
	measure 'Ventas bajo costo' = CALCULATE([Ventas netas], KEEPFILTERS(FC_Ventas[margen] < 0))
		formatString: "Q" #,0
		displayFolder: 08 Fugas de margen

	/// Cuántas líneas se facturaron por debajo del costo registrado.
	measure 'Líneas bajo costo' = CALCULATE(COUNTROWS(FC_Ventas), KEEPFILTERS(FC_Ventas[margen] < 0))
		formatString: #,0
		displayFolder: 08 Fugas de margen

	/// Cuánto margen se dejó en la mesa, en positivo para poder sumarlo y priorizarlo.
	measure 'Margen perdido bajo costo' = -CALCULATE(SUM(FC_Ventas[margen]), KEEPFILTERS(FC_Ventas[margen] < 0))
		formatString: "Q" #,0
		displayFolder: 08 Fugas de margen

	/// Qué porción de la venta se hizo perdiendo margen. Cualquier cifra de dos dígitos aquí merece una revisión de política de precios.
	measure '% Ventas bajo costo' = DIVIDE([Ventas bajo costo], [Ventas netas])
		formatString: 0.0%
		displayFolder: 08 Fugas de margen

	/// Artículos distintos que se vendieron perdiendo margen: la lista corta por donde empezar.
	measure 'Productos vendidos bajo costo' = CALCULATE(DISTINCTCOUNT(FC_Ventas[producto_clave]), KEEPFILTERS(FC_Ventas[margen] < 0))
		formatString: #,0
		displayFolder: 08 Fugas de margen

	/// Clientes a los que se les facturó por debajo del costo. Suele concentrarse en pocos y negociados.
	measure 'Clientes con venta bajo costo' = CALCULATE(DISTINCTCOUNT(FC_Ventas[cliente_clave]), KEEPFILTERS(FC_Ventas[margen] < 0))
		formatString: #,0
		displayFolder: 08 Fugas de margen

	/// Precio promedio del mismo período del año pasado, base del desglose precio/volumen.
	measure 'Precio promedio año anterior' = CALCULATE([Precio promedio unidad], SAMEPERIODLASTYEAR(DM_Calendario[fecha]))
		formatString: "Q" #,0.00
		displayFolder: 09 Precio y volumen

	/// Volumen del mismo período del año pasado, base del desglose precio/volumen.
	measure 'Unidades año anterior' = CALCULATE([Unidades vendidas], SAMEPERIODLASTYEAR(DM_Calendario[fecha]))
		formatString: #,0
		displayFolder: 09 Precio y volumen

	/// Cuánto de la variación anual viene de haber vendido MÁS CARO: diferencia de precio aplicada al volumen actual.
	measure 'Efecto precio' = ([Precio promedio unidad] - [Precio promedio año anterior]) * [Unidades vendidas]
		formatString: "Q" #,0
		displayFolder: 09 Precio y volumen

	/// Cuánto viene de haber vendido MÁS UNIDADES: diferencia de volumen valorada al precio del año pasado.
	measure 'Efecto volumen' = ([Unidades vendidas] - [Unidades año anterior]) * [Precio promedio año anterior]
		formatString: "Q" #,0
		displayFolder: 09 Precio y volumen

	/// El resto: cambio en la MEZCLA de productos y clientes. Los tres efectos suman exactamente la variación anual.
	measure 'Efecto mezcla' = [Ventas netas] - [Ventas año anterior] - [Efecto precio] - [Efecto volumen]
		formatString: "Q" #,0
		displayFolder: 09 Precio y volumen

	/// Título de la página 01.
	measure 'Título de Dirección' = "01 · Dirección · " & [Período activo]
		displayFolder: _Narrativa

	/// Subtítulo del visual de ejercicio (página 01). Habla de la serie del año en curso, no de un comparativo: el modelo arranca en 2026 y no hay año anterior que comparar (decisión de Edwin, 2026-08-08). Señala el mejor mes, que es la referencia contra la que el resto se lee.
	measure 'Subtítulo del ejercicio' = VAR t = [Ventas netas] VAR meses = VALUES(DM_Calendario[anio_mes]) VAR n = COUNTROWS(meses) VAR mejor = MAXX(meses, CALCULATE([Ventas netas])) VAR etiq = CONCATENATEX(TOPN(1, meses, CALCULATE([Ventas netas]), DESC), CALCULATE(MAX(DM_Calendario[mes_anio_etiqueta])), ", ") RETURN SWITCH(TRUE(), ISBLANK(t) || t = 0, "Sin venta en el período seleccionado", n <= 1, (IF(t < 0, "-", "") & "Q" & SWITCH(TRUE(), ABS(t) >= 1000000, FORMAT(ABS(t) / 1000000, "#,##0.0") & "M", ABS(t) >= 10000, FORMAT(ABS(t) / 1000, "#,##0") & "K", FORMAT(ABS(t), "#,##0"))) & " en el período", (IF(t < 0, "-", "") & "Q" & SWITCH(TRUE(), ABS(t) >= 1000000, FORMAT(ABS(t) / 1000000, "#,##0.0") & "M", ABS(t) >= 10000, FORMAT(ABS(t) / 1000, "#,##0") & "K", FORMAT(ABS(t), "#,##0"))) & " en el período · mejor mes: " & etiq & " con " & (IF(mejor < 0, "-", "") & "Q" & SWITCH(TRUE(), ABS(mejor) >= 1000000, FORMAT(ABS(mejor) / 1000000, "#,##0.0") & "M", ABS(mejor) >= 10000, FORMAT(ABS(mejor) / 1000, "#,##0") & "K", FORMAT(ABS(mejor), "#,##0"))))
		displayFolder: _Narrativa

	/// Subtítulo de la tabla de alertas (página 01). Cuenta focos, NO suma sus importes: venta en riesgo, margen perdido, saldo vencido y backlog son cifras de distinta naturaleza y sumarlas produce un total que nadie puede reconstruir.
	measure 'Subtítulo de focos de la semana' = VAR n = IF([Venta anual en riesgo por quiebre] > 0, 1, 0) + IF([Margen perdido bajo costo] > 0, 1, 0) + IF([Vencido terceros hoy] > 0, 1, 0) + IF([Backlog vencido] > 0, 1, 0) + IF([Flujo neto próximas 4 semanas] < 0, 1, 0) RETURN IF(n = 0, "Ningún foco exige acción esta semana", FORMAT(n, "0") & IF(n = 1, " foco exige acción", " focos exigen acción") & " · cada uno se lee en su propia unidad, no se suman entre sí")
		displayFolder: _Narrativa

	/// Subtítulo del aporte por sociedad (página 01). Cuánto concentra la mayor: en un grupo de diez sociedades, la dependencia de una sola es la lectura que no da el ERP.
	measure 'Subtítulo de aporte por sociedad' = VAR t = [Ventas a terceros] VAR soc = FILTER(VALUES(DM_Empresa[nombre]), [Ventas a terceros] <> 0) VAR n = COUNTROWS(soc) VAR mayor = MAXX(soc, [Ventas a terceros]) RETURN IF(ISBLANK(t) || t = 0, "Sin venta a terceros en el período", FORMAT(n, "0") & IF(n = 1, " sociedad con venta a terceros · ", " sociedades con venta a terceros · ") & "la mayor concentra " & FORMAT(DIVIDE(mayor, t), "0.0%"))
		displayFolder: _Narrativa

	/// Texto del foco de venta bajo costo (página 01). Margen regalado en el período filtrado: líneas facturadas por debajo del costo del artículo.
	measure 'Alerta de venta bajo costo' = VAR m = [Margen perdido bajo costo] VAR p = [% Ventas bajo costo] RETURN IF(ISBLANK(m) || m = 0, "Sin venta bajo costo en el período", (IF(m < 0, "-", "") & "Q" & SWITCH(TRUE(), ABS(m) >= 1000000, FORMAT(ABS(m) / 1000000, "#,##0.0") & "M", ABS(m) >= 10000, FORMAT(ABS(m) / 1000, "#,##0") & "K", FORMAT(ABS(m), "#,##0"))) & " de margen perdido vendiendo bajo costo · " & FORMAT(p, "0.0%") & " de la venta")
		displayFolder: _Narrativa

	/// Última fecha con venta registrada, ignorando el período seleccionado. Es el "al 16 oct" de los títulos: el corte real del dato, no la fecha de hoy ni la del calendario.
	measure 'Corte de ventas' = CALCULATE(MAX(FC_Ventas[fecha_documento]), ALL(DM_Calendario))
		formatString: dd/MM/yyyy
		displayFolder: _Auxiliar

	/// Qué fracción del año calendario ya transcurrió al corte de ventas. Da contexto al acumulado anual: un 79% del año con el 100% de la meta es otra historia que con el 50%.
	measure '% Avance del año' = VAR f = [Corte de ventas] RETURN IF(ISBLANK(f), BLANK(), DIVIDE(DATEDIFF(DATE(YEAR(f), 1, 1), f, DAY) + 1, DATEDIFF(DATE(YEAR(f), 1, 1), DATE(YEAR(f), 12, 31), DAY) + 1))
		formatString: 0%
		displayFolder: 10 Seguimiento

	/// Qué fracción del mes calendario ya transcurrió al corte de ventas.
	measure '% Avance del mes' = VAR f = [Corte de ventas] RETURN IF(ISBLANK(f), BLANK(), DIVIDE(DAY(f), DAY(EOMONTH(f, 0))))
		formatString: 0%
		displayFolder: 10 Seguimiento

	/// Venta del último día con registro (el "Resultado del día"). Se calcula sobre el corte real, no sobre HOY: un lunes a primera hora muestra el viernes, que es lo que el gerente quiere ver.
	measure 'Venta del día' = VAR f = [Corte de ventas] RETURN CALCULATE([Ventas netas], FILTER(ALL(DM_Calendario), DM_Calendario[fecha] = f))
		formatString: "Q" #,0
		displayFolder: 10 Seguimiento

	/// Curva acumulada del mes día a día (eje = día del mes). Respeta el mes elegido en el segmentador y acumula hasta el día del eje. Con más de un mes seleccionado suma los días homólogos de todos: elegir UN mes.
	measure 'Venta acumulada del mes al día' = VAR d = MAX(DM_Calendario[dia]) RETURN CALCULATE([Ventas netas], FILTER(ALLSELECTED(DM_Calendario[dia]), DM_Calendario[dia] <= d))
		formatString: "Q" #,0
		displayFolder: 10 Seguimiento

	/// La misma curva acumulada, del mismo mes del año anterior. Es la línea de referencia del "Venta del mes": si la curva de este año va por debajo a mitad de mes, se sabe antes del cierre.
	measure 'Venta acumulada del mes al día año anterior' = VAR d = MAX(DM_Calendario[dia]) VAR a = MAX(DM_Calendario[anio]) VAR m = MAX(DM_Calendario[mes]) RETURN CALCULATE([Ventas netas], FILTER(ALL(DM_Calendario), DM_Calendario[anio] = a - 1 && DM_Calendario[mes] = m && DM_Calendario[dia] <= d))
		formatString: "Q" #,0
		displayFolder: 10 Seguimiento

	/// Título de la página de histórico: corte real del dato y porcentaje del año transcurrido.
	measure 'Título de Histórico de ventas' = VAR f = [Corte de ventas] RETURN "Histórico de ventas"
		displayFolder: _Narrativa

	/// Título de la página de seguimiento: corte real del dato y porcentaje del mes transcurrido.
	measure 'Título de Seguimiento de ventas' = VAR f = [Corte de ventas] RETURN "Seguimiento de ventas"
		displayFolder: _Narrativa

	/// Etiqueta de dato para las columnas mensuales: importe abreviado y variación contra el mismo mes del año anterior en una sola línea ("1.3M · +29%"). Sin año anterior solo muestra el importe.
	measure 'Etiqueta de venta mensual' = VAR v = [Ventas netas] VAR vr = [Variación vs año anterior] RETURN IF(ISBLANK(v), BLANK(), (IF(v < 0, "-", "") & "Q" & SWITCH(TRUE(), ABS(v) >= 1000000, FORMAT(ABS(v) / 1000000, "#,##0.0") & "M", ABS(v) >= 10000, FORMAT(ABS(v) / 1000, "#,##0") & "K", FORMAT(ABS(v), "#,##0"))) & IF(ISBLANK(vr), "", " · " & FORMAT(vr, "+0%;-0%;0%")))
		displayFolder: _Narrativa

	/// Fondo gris del ranking por cliente: diferencia entre el líder del visual y esta categoría. Se apila detrás de 'Ventas netas' para dibujar la barra fantasma de referencia; no es una cifra de negocio.
	measure 'Resto a máximo cliente' = VAR m = MAXX(ALLSELECTED(DM_Cliente[nombre]), [Ventas netas]) VAR v = [Ventas netas] RETURN IF(ISBLANK(v), BLANK(), m - v)
		formatString: "Q" #,0
		displayFolder: _Auxiliar

	/// Fondo gris del ranking por producto: diferencia entre el líder del visual y esta categoría. Se apila detrás de 'Ventas netas' para dibujar la barra fantasma de referencia; no es una cifra de negocio.
	measure 'Resto a máximo producto' = VAR m = MAXX(ALLSELECTED(DM_Producto[nombre]), [Ventas netas]) VAR v = [Ventas netas] RETURN IF(ISBLANK(v), BLANK(), m - v)
		formatString: "Q" #,0
		displayFolder: _Auxiliar

	/// Fondo gris del ranking por vendedor: diferencia entre el líder del visual y esta categoría. Se apila detrás de 'Ventas netas' para dibujar la barra fantasma de referencia; no es una cifra de negocio.
	measure 'Resto a máximo vendedor' = VAR m = MAXX(ALLSELECTED(DM_Vendedor[nombre]), [Ventas netas]) VAR v = [Ventas netas] RETURN IF(ISBLANK(v), BLANK(), m - v)
		formatString: "Q" #,0
		displayFolder: _Auxiliar

	/// Fondo gris del ranking por sector: diferencia entre el líder del visual y esta categoría. Se apila detrás de 'Ventas netas' para dibujar la barra fantasma de referencia; no es una cifra de negocio.
	measure 'Resto a máximo sector' = VAR m = MAXX(ALLSELECTED('DM_Condición de pago'[nombre]), [Ventas netas]) VAR v = [Ventas netas] RETURN IF(ISBLANK(v), BLANK(), m - v)
		formatString: "Q" #,0
		displayFolder: _Auxiliar

	/// Fondo gris del ranking por sucursal: diferencia entre el líder del visual y esta categoría. Se apila detrás de 'Ventas netas' para dibujar la barra fantasma de referencia; no es una cifra de negocio.
	measure 'Resto a máximo sucursal' = VAR m = MAXX(ALLSELECTED(DM_Bodega[nombre]), [Ventas netas]) VAR v = [Ventas netas] RETURN IF(ISBLANK(v), BLANK(), m - v)
		formatString: "Q" #,0
		displayFolder: _Auxiliar

	/// Fondo gris del ranking por línea: diferencia entre el líder del visual y esta categoría. Se apila detrás de 'Ventas netas' para dibujar la barra fantasma de referencia; no es una cifra de negocio.
	measure 'Resto a máximo línea' = VAR m = MAXX(ALLSELECTED(DM_Producto[grupo_nombre]), [Ventas netas]) VAR v = [Ventas netas] RETURN IF(ISBLANK(v), BLANK(), m - v)
		formatString: "Q" #,0
		displayFolder: _Auxiliar

	/// Fondo gris del ranking por canal: diferencia entre el líder del visual y esta categoría. Se apila detrás de 'Ventas netas' para dibujar la barra fantasma de referencia; no es una cifra de negocio.
	measure 'Resto a máximo canal' = VAR m = MAXX(ALLSELECTED(DM_Canal[nombre]), [Ventas netas]) VAR v = [Ventas netas] RETURN IF(ISBLANK(v), BLANK(), m - v)
		formatString: "Q" #,0
		displayFolder: _Auxiliar

	/// Fondo gris del ranking por empresa: diferencia entre el líder del visual y esta categoría. Se apila detrás de 'Ventas netas' para dibujar la barra fantasma de referencia; no es una cifra de negocio.
	measure 'Resto a máximo empresa' = VAR m = MAXX(ALLSELECTED(DM_Empresa[nombre]), [Ventas netas]) VAR v = [Ventas netas] RETURN IF(ISBLANK(v), BLANK(), m - v)
		formatString: "Q" #,0
		displayFolder: _Auxiliar

	/// Empresa seleccionada en el segmentador, o "Todas".
	measure 'Empresa activa' = SELECTEDVALUE(DM_Empresa[nombre], "Todas")
		displayFolder: _Narrativa

	/// Subtítulo del histórico: "al 16 oct (79%)" — corte real y fracción del año transcurrida.
	measure 'Subtítulo de corte anual' = VAR f = [Corte de ventas] RETURN "al " & FORMAT(f, "d") & " " & FORMAT(f, "mmm") & " (" & FORMAT([% Avance del año], "0%") & ")"
		displayFolder: _Narrativa

	/// Pie de las páginas de ventas: habla del corte de VENTAS, no del dominio más rezagado (en Iron, tipos de cambio con una sola tasa arrastraría la frescura global a 2025 y desmentiría un tablero correcto).
	measure 'Pie de ventas' = VAR f = [Corte de ventas] VAR d = [Días desde última extracción] RETURN IF(ISBLANK(f), "Sin ventas cargadas", "Ventas del ERP al " & FORMAT(f, "d") & " de " & FORMAT(f, "mmmm") & " de " & FORMAT(f, "yyyy") & " · extraído hace " & FORMAT(d, "0") & IF(d = 1, " día", " días"))
		displayFolder: _Narrativa

	/// Subtítulo del seguimiento: "al 16 oct (52%)" — corte real y fracción del mes transcurrida.
	measure 'Subtítulo de corte mensual' = VAR f = [Corte de ventas] RETURN "al " & FORMAT(f, "d") & " " & FORMAT(f, "mmm") & " (" & FORMAT([% Avance del mes], "0%") & ")"
		displayFolder: _Narrativa

	/// Primera compra del cliente de esta línea (sobre TODO el hecho). Base de las cohortes de clientes nuevos.
	column primera_compra_cliente = VAR c = FC_Ventas[cliente_clave] RETURN CALCULATE(MIN(FC_Ventas[fecha_documento]), FILTER(ALL(FC_Ventas), FC_Ventas[cliente_clave] = c))
		dataType: dateTime
		formatString: dd/MM/yyyy
		isHidden
		summarizeBy: none

	/// La línea pertenece al PRIMER mes de relación del cliente (venta de estreno vs recompra).
	column es_primer_mes_cliente = EOMONTH(FC_Ventas[fecha_documento], 0) = EOMONTH(FC_Ventas[primera_compra_cliente], 0)
		dataType: boolean
		isHidden
		summarizeBy: none

	/// Mes del documento (fin de mes) para contar meses distintos con compra.
	column mes_documento = EOMONTH(FC_Ventas[fecha_documento], 0)
		dataType: dateTime
		formatString: dd/MM/yyyy
		isHidden
		summarizeBy: none

	/// Compra anterior del mismo cliente (última fecha estrictamente menor). Base de los recuperados.
	column fecha_compra_anterior_cliente = VAR c = FC_Ventas[cliente_clave] VAR f = FC_Ventas[fecha_documento] RETURN CALCULATE(MAX(FC_Ventas[fecha_documento]), FILTER(ALL(FC_Ventas), FC_Ventas[cliente_clave] = c && FC_Ventas[fecha_documento] < f))
		dataType: dateTime
		formatString: dd/MM/yyyy
		isHidden
		summarizeBy: none

	/// La línea es una compra de RETORNO: el cliente llevaba 6 meses o más sin comprar.
	column es_compra_recuperacion = NOT ISBLANK(FC_Ventas[fecha_compra_anterior_cliente]) && DATEDIFF(FC_Ventas[fecha_compra_anterior_cliente], FC_Ventas[fecha_documento], MONTH) >= 6
		dataType: boolean
		isHidden
		summarizeBy: none

	/// Meses hacia atrás desde el corte que delimitan la ventana de las cohortes (segmentador "Mes de partida", -12 por defecto).
	measure 'Meses de partida' = SELECTEDVALUE('MD_Mes de partida'[Mes de partida], -12)
		formatString: 0
		displayFolder: _Auxiliar

	/// Primer día del mes de partida: inicio de la ventana de cohortes.
	measure 'Inicio de ventana' = VAR f = [Corte de ventas] VAR e = EDATE(f, [Meses de partida]) RETURN DATE(YEAR(e), MONTH(e), 1)
		formatString: dd/MM/yyyy
		displayFolder: _Auxiliar

	/// Primer día del mes que abre los últimos 12 meses (corte incluido): la "cartera de clientes" se lee siempre a 12 meses.
	measure 'Inicio 12 meses' = VAR f = [Corte de ventas] VAR e = EDATE(f, -11) RETURN DATE(YEAR(e), MONTH(e), 1)
		formatString: dd/MM/yyyy
		displayFolder: _Auxiliar

	/// Venta del mes en curso al corte (el "acumulado del mes" de Kraken), independiente del año seleccionado.
	measure 'Venta del mes en curso' = VAR f = [Corte de ventas] RETURN CALCULATE([Ventas netas], DATESBETWEEN(DM_Calendario[fecha], DATE(YEAR(f), MONTH(f), 1), f))
		formatString: "Q" #,0
		displayFolder: 10 Seguimiento

	/// Mismo tramo del mes, un año antes.
	measure 'Venta del mes en curso año anterior' = VAR f = EDATE([Corte de ventas], -12) RETURN CALCULATE([Ventas netas], DATESBETWEEN(DM_Calendario[fecha], DATE(YEAR(f), MONTH(f), 1), f))
		formatString: "Q" #,0
		displayFolder: 10 Seguimiento

	/// Variación del mes en curso contra el mismo tramo del año anterior.
	measure 'Variación del mes en curso vs año anterior' = DIVIDE([Venta del mes en curso] - [Venta del mes en curso año anterior], [Venta del mes en curso año anterior])
		formatString: +0%;-0%;0%
		displayFolder: 10 Seguimiento

	/// Diferencia absoluta del acumulado del año contra el acumulado del año anterior a la misma fecha (la "Variación" de la matriz de oportunidades).
	measure 'Diferencia acumulada vs año anterior' = IF(ISBLANK([Ventas acumuladas año]) && ISBLANK([Ventas acumuladas año anterior]), BLANK(), [Ventas acumuladas año] - [Ventas acumuladas año anterior])
		formatString: "Q" #,0
		displayFolder: 11 Clientes

	/// Icono de la matriz de oportunidades: ✔ crece, ✖ cae, – sin comparativo.
	measure 'Semáforo acumulado' = VAR d = [Diferencia acumulada vs año anterior] RETURN SWITCH(TRUE(), ISBLANK(d), "–", d < 0, "✖", "✔")
		displayFolder: 11 Clientes

	/// Atrición: lo que falta para igualar el acumulado del año anterior (0 si ya se superó).
	measure 'Faltante vs año anterior' = VAR d = [Diferencia acumulada vs año anterior] RETURN IF(ISBLANK(d), BLANK(), MAX(0, -d))
		formatString: "Q" #,0
		displayFolder: 11 Clientes

	/// Penetración: lo vendido por encima del acumulado del año anterior (0 si aún no se alcanza).
	measure 'Superávit vs año anterior' = VAR d = [Diferencia acumulada vs año anterior] RETURN IF(ISBLANK(d), BLANK(), MAX(0, d))
		formatString: "Q" #,0
		displayFolder: 11 Clientes

	/// Base de la barra de oportunidad según la vista elegida: Atrición = acumulado actual; Penetración = acumulado del año anterior.
	measure 'Venta actual' = IF(SELECTEDVALUE('MD_Vista de oportunidad'[Vista], "Atrición") = "Atrición", [Ventas acumuladas año], [Ventas acumuladas año anterior])
		formatString: "Q" #,0
		displayFolder: 11 Clientes

	/// Tramo rojo (solo en Atrición): faltante contra el año anterior.
	measure 'Faltante de venta' = IF(SELECTEDVALUE('MD_Vista de oportunidad'[Vista], "Atrición") = "Atrición", [Faltante vs año anterior], BLANK())
		formatString: "Q" #,0
		displayFolder: 11 Clientes

	/// Tramo verde (solo en Penetración): superávit sobre el año anterior.
	measure 'Superávit de venta' = IF(SELECTEDVALUE('MD_Vista de oportunidad'[Vista], "Atrición") = "Penetración", [Superávit vs año anterior], BLANK())
		formatString: "Q" #,0
		displayFolder: 11 Clientes

	/// Fondo gris del ranking de vendedores en acumulado del año.
	measure 'Resto a máximo vendedor acumulado' = VAR m = MAXX(ALLSELECTED(DM_Vendedor[nombre]), [Ventas acumuladas año]) VAR v = [Ventas acumuladas año] RETURN IF(ISBLANK(v), BLANK(), m - v)
		formatString: "Q" #,0
		displayFolder: _Auxiliar

	/// Venta de los últimos 12 meses al corte. Respeta el mes del eje cuando lo hay (intersección), así sirve para el KPI y para el desglose mensual.
	measure 'Ventas 12 meses' = CALCULATE([Ventas netas], KEEPFILTERS(DATESBETWEEN(DM_Calendario[fecha], [Inicio 12 meses], [Corte de ventas])))
		formatString: "Q" #,0
		displayFolder: 12 Doce meses

	/// Los mismos 12 meses, un año antes (gris de referencia del desglose mensual).
	measure 'Ventas 12 meses año anterior' = CALCULATE([Ventas netas], KEEPFILTERS(DATESBETWEEN(DM_Calendario[fecha], EDATE([Inicio 12 meses], -12), EDATE([Corte de ventas], -12))))
		formatString: "Q" #,0
		displayFolder: 12 Doce meses

	/// Clientes distintos con venta en los últimos 12 meses.
	measure 'Clientes 12 meses' = CALCULATE(DISTINCTCOUNT(FC_Ventas[cliente_clave]), KEEPFILTERS(DATESBETWEEN(DM_Calendario[fecha], [Inicio 12 meses], [Corte de ventas])), KEEPFILTERS(FC_Ventas[monto_sin_impuesto] <> 0))
		formatString: #,0
		displayFolder: 12 Doce meses

	/// Productos distintos vendidos en los últimos 12 meses.
	measure 'Productos 12 meses' = CALCULATE(DISTINCTCOUNT(FC_Ventas[producto_clave]), KEEPFILTERS(DATESBETWEEN(DM_Calendario[fecha], [Inicio 12 meses], [Corte de ventas])))
		formatString: #,0
		displayFolder: 12 Doce meses

	/// Fondo gris del ranking por cliente a 12 meses.
	measure 'Resto a máximo cliente 12 meses' = VAR m = MAXX(ALLSELECTED(DM_Cliente[nombre]), [Ventas 12 meses]) VAR v = [Ventas 12 meses] RETURN IF(ISBLANK(v), BLANK(), m - v)
		formatString: "Q" #,0
		displayFolder: _Auxiliar

	/// Fondo gris del ranking por producto a 12 meses.
	measure 'Resto a máximo producto 12 meses' = VAR m = MAXX(ALLSELECTED(DM_Producto[nombre]), [Ventas 12 meses]) VAR v = [Ventas 12 meses] RETURN IF(ISBLANK(v), BLANK(), m - v)
		formatString: "Q" #,0
		displayFolder: _Auxiliar

	/// Fondo gris del ranking por vendedor a 12 meses.
	measure 'Resto a máximo vendedor 12 meses' = VAR m = MAXX(ALLSELECTED(DM_Vendedor[nombre]), [Ventas 12 meses]) VAR v = [Ventas 12 meses] RETURN IF(ISBLANK(v), BLANK(), m - v)
		formatString: "Q" #,0
		displayFolder: _Auxiliar

	/// Fondo gris del ranking por sector a 12 meses.
	measure 'Resto a máximo sector 12 meses' = VAR m = MAXX(ALLSELECTED('DM_Condición de pago'[nombre]), [Ventas 12 meses]) VAR v = [Ventas 12 meses] RETURN IF(ISBLANK(v), BLANK(), m - v)
		formatString: "Q" #,0
		displayFolder: _Auxiliar

	/// Fondo gris del ranking por línea a 12 meses.
	measure 'Resto a máximo línea 12 meses' = VAR m = MAXX(ALLSELECTED(DM_Producto[grupo_nombre]), [Ventas 12 meses]) VAR v = [Ventas 12 meses] RETURN IF(ISBLANK(v), BLANK(), m - v)
		formatString: "Q" #,0
		displayFolder: _Auxiliar

	/// Fondo gris del ranking por categoría a 12 meses.
	measure 'Resto a máximo categoría 12 meses' = VAR m = MAXX(ALLSELECTED(DM_Cliente[clase_abc_actual_nombre]), [Ventas 12 meses]) VAR v = [Ventas 12 meses] RETURN IF(ISBLANK(v), BLANK(), m - v)
		formatString: "Q" #,0
		displayFolder: _Auxiliar

	/// Clientes nuevos: primera compra dentro de la ventana. Ventana = mes de partida → corte.
	measure 'Clientes nuevos en ventana' = VAR ini = [Inicio de ventana] VAR fin = [Corte de ventas] RETURN CALCULATE(DISTINCTCOUNT(FC_Ventas[cliente_clave]), DATESBETWEEN(DM_Calendario[fecha], ini, fin), FILTER(ALL(FC_Ventas[primera_compra_cliente]), FC_Ventas[primera_compra_cliente] >= ini && FC_Ventas[primera_compra_cliente] <= fin))
		formatString: #,0
		displayFolder: 13 Clientes nuevos

	/// Venta de esos clientes dentro de la ventana.
	measure 'Ventas de clientes nuevos en ventana' = VAR ini = [Inicio de ventana] VAR fin = [Corte de ventas] RETURN CALCULATE([Ventas netas], DATESBETWEEN(DM_Calendario[fecha], ini, fin), FILTER(ALL(FC_Ventas[primera_compra_cliente]), FC_Ventas[primera_compra_cliente] >= ini && FC_Ventas[primera_compra_cliente] <= fin))
		formatString: "Q" #,0
		displayFolder: 13 Clientes nuevos

	/// Venta total de esos clientes (todo el histórico cargado, no solo la ventana).
	measure 'Ventas totales de clientes nuevos' = VAR ini = [Inicio de ventana] VAR fin = [Corte de ventas] RETURN CALCULATE([Ventas netas], REMOVEFILTERS(DM_Calendario), FILTER(ALL(FC_Ventas[primera_compra_cliente]), FC_Ventas[primera_compra_cliente] >= ini && FC_Ventas[primera_compra_cliente] <= fin))
		formatString: "Q" #,0
		displayFolder: 13 Clientes nuevos

	/// Venta por mes de esos clientes (eje = mes del calendario, recortado a la ventana).
	measure 'Ventas de clientes nuevos del mes' = VAR ini = [Inicio de ventana] VAR fin = [Corte de ventas] RETURN CALCULATE([Ventas netas], KEEPFILTERS(DATESBETWEEN(DM_Calendario[fecha], ini, fin)), FILTER(ALL(FC_Ventas[primera_compra_cliente]), FC_Ventas[primera_compra_cliente] >= ini && FC_Ventas[primera_compra_cliente] <= fin))
		formatString: "Q" #,0
		displayFolder: 13 Clientes nuevos

	/// Cuántos clientes nuevos aporta cada mes (línea del gráfico): los que estrenan en ese mes.
	measure 'Clientes nuevos del mes' = VAR ini = [Inicio de ventana] VAR fin = [Corte de ventas] RETURN CALCULATE(DISTINCTCOUNT(FC_Ventas[cliente_clave]), KEEPFILTERS(DATESBETWEEN(DM_Calendario[fecha], ini, fin)), FC_Ventas[es_primer_mes_cliente] = TRUE())
		formatString: #,0
		displayFolder: 13 Clientes nuevos

	/// Venta de nuevos en su primer mes (barra oscura de la retención).
	measure 'Venta de nuevos en su primer mes' = CALCULATE([Ventas de clientes nuevos del mes], FC_Ventas[es_primer_mes_cliente] = TRUE())
		formatString: "Q" #,0
		displayFolder: 13 Clientes nuevos

	/// Venta de nuevos en meses posteriores al de estreno (recompra: la prueba de retención).
	measure 'Venta de nuevos en recompra' = CALCULATE([Ventas de clientes nuevos del mes], NOT FC_Ventas[es_primer_mes_cliente] = TRUE())
		formatString: "Q" #,0
		displayFolder: 13 Clientes nuevos

	/// Retenidos: nuevos de la ventana que volvieron a comprar en un mes distinto al de estreno.
	measure 'Clientes nuevos retenidos' = VAR ini = [Inicio de ventana] VAR fin = [Corte de ventas] RETURN CALCULATE(DISTINCTCOUNT(FC_Ventas[cliente_clave]), DATESBETWEEN(DM_Calendario[fecha], ini, fin), FILTER(ALL(FC_Ventas[primera_compra_cliente]), FC_Ventas[primera_compra_cliente] >= ini && FC_Ventas[primera_compra_cliente] <= fin), NOT FC_Ventas[es_primer_mes_cliente] = TRUE())
		formatString: #,0
		displayFolder: 13 Clientes nuevos

	/// Los que no volvieron a comprar.
	measure 'Clientes nuevos no retenidos' = [Clientes nuevos en ventana] - [Clientes nuevos retenidos]
		formatString: #,0
		displayFolder: 13 Clientes nuevos

	measure '% Retención de nuevos' = DIVIDE([Clientes nuevos retenidos], [Clientes nuevos en ventana])
		formatString: 0%
		displayFolder: 13 Clientes nuevos

	measure '% Abandono de nuevos' = DIVIDE([Clientes nuevos no retenidos], [Clientes nuevos en ventana])
		formatString: 0%
		displayFolder: 13 Clientes nuevos

	/// Venta en ventana de los nuevos retenidos (por cliente deja en blanco a los no retenidos: la tabla los omite sola).
	measure 'Ventas de nuevos retenidos' = IF([Clientes nuevos retenidos] > 0, [Ventas de clientes nuevos en ventana])
		formatString: "Q" #,0
		displayFolder: 13 Clientes nuevos

	/// Venta en ventana de los nuevos que no volvieron.
	measure 'Ventas de nuevos no retenidos' = IF([Clientes nuevos en ventana] > 0 && [Clientes nuevos retenidos] = 0, [Ventas de clientes nuevos en ventana])
		formatString: "Q" #,0
		displayFolder: 13 Clientes nuevos

	/// Clientes recuperados: con una compra de retorno (6+ meses sin comprar) dentro de la ventana. Ventana = mes de partida → corte.
	measure 'Clientes recuperados en ventana' = VAR ini = [Inicio de ventana] VAR fin = [Corte de ventas] RETURN CALCULATE(DISTINCTCOUNT(FC_Ventas[cliente_clave]), DATESBETWEEN(DM_Calendario[fecha], ini, fin), FILTER(VALUES(FC_Ventas[cliente_clave]), CALCULATE(COUNTROWS(FC_Ventas), DATESBETWEEN(DM_Calendario[fecha], ini, fin), FC_Ventas[es_compra_recuperacion] = TRUE()) > 0))
		formatString: #,0
		displayFolder: 13 Clientes recuperados

	/// Venta de esos clientes dentro de la ventana.
	measure 'Ventas de clientes recuperados en ventana' = VAR ini = [Inicio de ventana] VAR fin = [Corte de ventas] RETURN CALCULATE([Ventas netas], DATESBETWEEN(DM_Calendario[fecha], ini, fin), FILTER(VALUES(FC_Ventas[cliente_clave]), CALCULATE(COUNTROWS(FC_Ventas), DATESBETWEEN(DM_Calendario[fecha], ini, fin), FC_Ventas[es_compra_recuperacion] = TRUE()) > 0))
		formatString: "Q" #,0
		displayFolder: 13 Clientes recuperados

	/// Venta total de esos clientes (todo el histórico cargado, no solo la ventana).
	measure 'Ventas totales de clientes recuperados' = VAR ini = [Inicio de ventana] VAR fin = [Corte de ventas] RETURN CALCULATE([Ventas netas], REMOVEFILTERS(DM_Calendario), FILTER(VALUES(FC_Ventas[cliente_clave]), CALCULATE(COUNTROWS(FC_Ventas), DATESBETWEEN(DM_Calendario[fecha], ini, fin), FC_Ventas[es_compra_recuperacion] = TRUE()) > 0))
		formatString: "Q" #,0
		displayFolder: 13 Clientes recuperados

	/// Venta por mes de esos clientes (eje = mes del calendario, recortado a la ventana).
	measure 'Ventas de clientes recuperados del mes' = VAR ini = [Inicio de ventana] VAR fin = [Corte de ventas] RETURN CALCULATE([Ventas netas], KEEPFILTERS(DATESBETWEEN(DM_Calendario[fecha], ini, fin)), FILTER(VALUES(FC_Ventas[cliente_clave]), CALCULATE(COUNTROWS(FC_Ventas), DATESBETWEEN(DM_Calendario[fecha], ini, fin), FC_Ventas[es_compra_recuperacion] = TRUE()) > 0))
		formatString: "Q" #,0
		displayFolder: 13 Clientes recuperados

	/// Cuántos clientes recuperados aporta cada mes (línea del gráfico): los que estrenan en ese mes.
	measure 'Clientes recuperados del mes' = VAR ini = [Inicio de ventana] VAR fin = [Corte de ventas] RETURN CALCULATE(DISTINCTCOUNT(FC_Ventas[cliente_clave]), KEEPFILTERS(DATESBETWEEN(DM_Calendario[fecha], ini, fin)), FC_Ventas[es_compra_recuperacion] = TRUE())
		formatString: #,0
		displayFolder: 13 Clientes recuperados

	/// Venta de recuperados en su mes de retorno (barra oscura de la retención).
	measure 'Venta de recuperados en su mes de retorno' = CALCULATE([Ventas de clientes recuperados del mes], FC_Ventas[es_compra_recuperacion] = TRUE())
		formatString: "Q" #,0
		displayFolder: 13 Clientes recuperados

	/// Venta de recuperados en meses posteriores al de estreno (recompra: la prueba de retención).
	measure 'Venta de recuperados en recompra' = CALCULATE([Ventas de clientes recuperados del mes], NOT FC_Ventas[es_compra_recuperacion] = TRUE())
		formatString: "Q" #,0
		displayFolder: 13 Clientes recuperados

	/// Retenidos: recuperados de la ventana que volvieron a comprar en un mes distinto al de estreno.
	measure 'Clientes recuperados retenidos' = VAR ini = [Inicio de ventana] VAR fin = [Corte de ventas] RETURN CALCULATE(DISTINCTCOUNT(FC_Ventas[cliente_clave]), DATESBETWEEN(DM_Calendario[fecha], ini, fin), FILTER(VALUES(FC_Ventas[cliente_clave]), CALCULATE(COUNTROWS(FC_Ventas), DATESBETWEEN(DM_Calendario[fecha], ini, fin), FC_Ventas[es_compra_recuperacion] = TRUE()) > 0), NOT FC_Ventas[es_compra_recuperacion] = TRUE())
		formatString: #,0
		displayFolder: 13 Clientes recuperados

	/// Los que no volvieron a comprar.
	measure 'Clientes recuperados no retenidos' = [Clientes recuperados en ventana] - [Clientes recuperados retenidos]
		formatString: #,0
		displayFolder: 13 Clientes recuperados

	measure '% Retención de recuperados' = DIVIDE([Clientes recuperados retenidos], [Clientes recuperados en ventana])
		formatString: 0%
		displayFolder: 13 Clientes recuperados

	measure '% Abandono de recuperados' = DIVIDE([Clientes recuperados no retenidos], [Clientes recuperados en ventana])
		formatString: 0%
		displayFolder: 13 Clientes recuperados

	/// Venta en ventana de los recuperados retenidos (por cliente deja en blanco a los no retenidos: la tabla los omite sola).
	measure 'Ventas de recuperados retenidos' = IF([Clientes recuperados retenidos] > 0, [Ventas de clientes recuperados en ventana])
		formatString: "Q" #,0
		displayFolder: 13 Clientes recuperados

	/// Venta en ventana de los recuperados que no volvieron.
	measure 'Ventas de recuperados no retenidos' = IF([Clientes recuperados en ventana] > 0 && [Clientes recuperados retenidos] = 0, [Ventas de clientes recuperados en ventana])
		formatString: "Q" #,0
		displayFolder: 13 Clientes recuperados

	/// Títulos del dashboard de clientes.
	measure 'Título de Matriz de oportunidades' = "Matriz de oportunidades"
		displayFolder: _Narrativa
	measure 'Título de Cartera de clientes' = "Cartera de clientes"
		displayFolder: _Narrativa
	measure 'Título de Clientes nuevos' = "Clientes nuevos"
		displayFolder: _Narrativa
	measure 'Título de Clientes recuperados' = "Clientes recuperados"
		displayFolder: _Narrativa

	/// Unidades vendidas en los últimos 12 meses; respeta el mes del eje (KEEPFILTERS).
	measure 'Unidades vendidas 12 meses' = CALCULATE([Unidades vendidas], KEEPFILTERS(DATESBETWEEN(DM_Calendario[fecha], [Inicio 12 meses], [Corte de ventas])))
		formatString: #,0
		displayFolder: 14 Inventario

	/// Primer día del mes que abre los últimos 24 meses (tendencia larga de unidades).
	measure 'Inicio 24 meses' = VAR f = [Corte de ventas] VAR e = EDATE(f, -23) RETURN DATE(YEAR(e), MONTH(e), 1)
		formatString: dd/MM/yyyy
		displayFolder: _Auxiliar

	/// Unidades vendidas en los últimos 24 meses por mes.
	measure 'Unidades vendidas 24 meses' = CALCULATE([Unidades vendidas], KEEPFILTERS(DATESBETWEEN(DM_Calendario[fecha], [Inicio 24 meses], [Corte de ventas])))
		formatString: #,0
		displayFolder: 14 Inventario

	/// Promedio mensual de unidades de los últimos 12 meses: la línea punteada de referencia del gráfico (constante en todos los meses).
	measure 'Promedio mensual de unidades 12 meses' = VAR enVentana = CALCULATE(COUNTROWS(DM_Calendario), KEEPFILTERS(DATESBETWEEN(DM_Calendario[fecha], [Inicio 12 meses], [Corte de ventas]))) > 0 RETURN IF(enVentana, DIVIDE(CALCULATE([Unidades vendidas], REMOVEFILTERS(DM_Calendario), DATESBETWEEN(DM_Calendario[fecha], [Inicio 12 meses], [Corte de ventas])), 12))
		formatString: #,0
		displayFolder: 14 Inventario

	/// Costo de lo vendido en los últimos 12 meses, dividido entre 12: el "costo desplazado promedio mensual" de Kraken.
	measure 'Costo desplazado promedio mensual' = DIVIDE([Costo desplazado 12 meses], 12)
		formatString: "Q" #,0
		displayFolder: 14 Inventario

	/// Costo de lo vendido en los últimos 12 meses (el "costo desplazado" por producto). Si el ERP no trae costo en la línea (Odoo: la factura no lo guarda; el paquete base no extrae standard_price), se estima con unidades vendidas × costo unitario actual del producto.
	measure 'Costo desplazado 12 meses' = VAR directo = CALCULATE([Costo de ventas], REMOVEFILTERS(DM_Calendario), DATESBETWEEN(DM_Calendario[fecha], [Inicio 12 meses], [Corte de ventas])) RETURN IF(directo <> 0, directo, SUMX(VALUES(DM_Producto[producto_clave]), CALCULATE([Unidades vendidas], REMOVEFILTERS(DM_Calendario), DATESBETWEEN(DM_Calendario[fecha], [Inicio 12 meses], [Corte de ventas])) * CALCULATE(MAX('DM_Análisis de producto'[costo_unitario_actual]))))
		formatString: "Q" #,0
		displayFolder: 14 Inventario

	/// Meses que dura el inventario al ritmo de costo de los últimos 12 meses (valor ÷ costo desplazado mensual).
	measure 'Meses de inventario al costo' = DIVIDE([Valor de inventario], [Costo desplazado promedio mensual])
		formatString: #,0.0
		displayFolder: 14 Inventario

	/// Precio promedio al que se vendió el producto en los últimos 12 meses (venta ÷ unidades).
	measure 'Precio promedio de venta 12 meses' = DIVIDE(CALCULATE([Ventas netas], REMOVEFILTERS(DM_Calendario), DATESBETWEEN(DM_Calendario[fecha], [Inicio 12 meses], [Corte de ventas])), CALCULATE([Unidades vendidas], REMOVEFILTERS(DM_Calendario), DATESBETWEEN(DM_Calendario[fecha], [Inicio 12 meses], [Corte de ventas])))
		formatString: "Q" #,0.00
		displayFolder: 14 Inventario

	/// Precio de lista del producto en el ERP (Odoo: list_price). En SAP B1 no se extrae aún.
	measure 'Precio de lista' = IF(HASONEVALUE(DM_Producto[producto_clave]), MAX(DM_Producto[precio_lista]))
		formatString: "Q" #,0.00
		displayFolder: 14 Inventario

	/// Consumo (unidades vendidas) del mes más bajo de los últimos 12; un mes sin venta cuenta como 0.
	measure 'Consumo mínimo mensual' = VAR meses = CALCULATETABLE(VALUES(DM_Calendario[anio_mes]), REMOVEFILTERS(DM_Calendario), DATESBETWEEN(DM_Calendario[fecha], [Inicio 12 meses], [Corte de ventas])) RETURN MINX(meses, CALCULATE([Unidades vendidas]) + 0)
		formatString: #,0
		displayFolder: 14 Inventario

	/// Consumo mensual promedio de los últimos 12 meses (meses sin venta incluidos como 0).
	measure 'Consumo promedio mensual' = VAR meses = CALCULATETABLE(VALUES(DM_Calendario[anio_mes]), REMOVEFILTERS(DM_Calendario), DATESBETWEEN(DM_Calendario[fecha], [Inicio 12 meses], [Corte de ventas])) RETURN AVERAGEX(meses, CALCULATE([Unidades vendidas]) + 0)
		formatString: #,0
		displayFolder: 14 Inventario

	/// Consumo del mes más alto de los últimos 12.
	measure 'Consumo máximo mensual' = VAR meses = CALCULATETABLE(VALUES(DM_Calendario[anio_mes]), REMOVEFILTERS(DM_Calendario), DATESBETWEEN(DM_Calendario[fecha], [Inicio 12 meses], [Corte de ventas])) RETURN MAXX(meses, CALCULATE([Unidades vendidas]) + 0)
		formatString: #,0
		displayFolder: 14 Inventario

	/// Días de reposición del proveedor (segmentador "Lead time"; 15 por defecto). Odoo lo guarda por proveedor en product_supplierinfo.delay — pendiente de extraer.
	measure 'Lead time (días)' = SELECTEDVALUE('MD_Lead time'[Lead time], 15)
		formatString: 0
		displayFolder: 14 Inventario

	/// Stock mínimo = consumo mínimo mensual × lead time en meses.
	measure 'Stock mínimo' = [Consumo mínimo mensual] * [Lead time (días)] / 30
		formatString: #,0
		displayFolder: 14 Inventario

	/// Punto de pedido = stock mínimo + consumo promedio mensual × lead time en meses.
	measure 'Punto de pedido' = [Stock mínimo] + [Consumo promedio mensual] * [Lead time (días)] / 30
		formatString: #,0
		displayFolder: 14 Inventario

	/// Stock máximo = stock mínimo + consumo máximo mensual × lead time en meses.
	measure 'Stock máximo' = [Stock mínimo] + [Consumo máximo mensual] * [Lead time (días)] / 30
		formatString: #,0
		displayFolder: 14 Inventario

	/// Cuánto comprar: si la existencia está bajo el punto de pedido, lo que falta para el stock máximo.
	measure 'Sugerencia de compra' = VAR e = COALESCE([Unidades en existencia], 0) VAR pp = [Punto de pedido] RETURN IF(NOT ISBLANK(pp) && pp > 0 && e < pp, [Stock máximo] - e, BLANK())
		formatString: #,0
		displayFolder: 14 Inventario

	/// Monto de la sugerencia al costo unitario actual del producto.
	measure 'Monto de sugerencia de compra' = [Sugerencia de compra] * COALESCE([Costo promedio ponderado], CALCULATE(MAX('DM_Análisis de producto'[costo_unitario_actual])))
		formatString: "Q" #,0
		displayFolder: 14 Inventario

	/// Icono de la tabla de análisis: ↓ bajo el punto de pedido, ↑ por encima.
	measure 'Semáforo de existencias' = VAR e = COALESCE([Unidades en existencia], 0) VAR pp = [Punto de pedido] RETURN IF(ISBLANK(pp) || pp = 0, "", IF(e < pp, "↓", "↑"))
		displayFolder: 14 Inventario

	/// Productos con sugerencia de compra mayor que cero.
	measure 'Productos con sugerencia de compra' = COUNTROWS(FILTER(VALUES(DM_Producto[producto_clave]), [Sugerencia de compra] > 0))
		formatString: #,0
		displayFolder: 14 Inventario

	/// Fondo gris del ranking de existencias por bodega / línea.
	measure 'Resto a máximo bodega existencias' = VAR m = MAXX(ALLSELECTED(DM_Bodega[nombre]), [Unidades en existencia]) VAR v = [Unidades en existencia] RETURN IF(ISBLANK(v), BLANK(), m - v)
		formatString: #,0
		displayFolder: _Auxiliar
	measure 'Resto a máximo línea existencias' = VAR m = MAXX(ALLSELECTED(DM_Producto[grupo_nombre]), [Unidades en existencia]) VAR v = [Unidades en existencia] RETURN IF(ISBLANK(v), BLANK(), m - v)
		formatString: #,0
		displayFolder: _Auxiliar
	measure 'Resto a máximo bodega valor' = VAR m = MAXX(ALLSELECTED(DM_Bodega[nombre]), [Valor de inventario]) VAR v = [Valor de inventario] RETURN IF(ISBLANK(v), BLANK(), m - v)
		formatString: "Q" #,0
		displayFolder: _Auxiliar
	measure 'Resto a máximo línea valor' = VAR m = MAXX(ALLSELECTED(DM_Producto[grupo_nombre]), [Valor de inventario]) VAR v = [Valor de inventario] RETURN IF(ISBLANK(v), BLANK(), m - v)
		formatString: "Q" #,0
		displayFolder: _Auxiliar

	/// Títulos del dashboard de inventarios.
	measure 'Título de Existencias de inventario' = "Existencias de inventario"
		displayFolder: _Narrativa
	measure 'Título de Costo del inventario' = "Costo del inventario"
		displayFolder: _Narrativa
	measure 'Título de Análisis de inventario' = "Análisis de inventario"
		displayFolder: _Narrativa

	/// Cargos del mes = facturación con IVA de los últimos 12 meses, por mes del eje.
	measure 'Cargos del mes' = CALCULATE([Ventas netas con IVA], KEEPFILTERS(DATESBETWEEN(DM_Calendario[fecha], [Inicio 12 meses], [Corte de ventas])))
		formatString: "Q" #,0
		displayFolder: 16 Cobros

	/// Abonos del mes = cobros de clientes de los últimos 12 meses, por mes del eje.
	measure 'Abonos del mes' = CALCULATE([Cobros de clientes], KEEPFILTERS(DATESBETWEEN(DM_Calendario[fecha], [Inicio 12 meses], [Corte de ventas])))
		formatString: "Q" #,0
		displayFolder: 16 Cobros

	measure 'Cargos totales 12 meses' = CALCULATE([Ventas netas con IVA], REMOVEFILTERS(DM_Calendario), DATESBETWEEN(DM_Calendario[fecha], [Inicio 12 meses], [Corte de ventas]))
		formatString: "Q" #,0
		displayFolder: 16 Cobros
	measure 'Abonos totales 12 meses' = CALCULATE([Cobros de clientes], REMOVEFILTERS(DM_Calendario), DATESBETWEEN(DM_Calendario[fecha], [Inicio 12 meses], [Corte de ventas]))
		formatString: "Q" #,0
		displayFolder: 16 Cobros
	measure 'Cargos menos abonos 12 meses' = [Cargos totales 12 meses] - [Abonos totales 12 meses]
		formatString: "Q" #,0;-"Q" #,0;"Q" 0
		displayFolder: 16 Cobros

	/// Utilidad: nombres como los muestra Kraken.
	measure 'Ganancia' = [Margen bruto]
		formatString: "Q" #,0
		displayFolder: 18 Utilidad
	measure 'Costo de lo vendido' = [Costo de ventas]
		formatString: "Q" #,0
		displayFolder: 18 Utilidad
	measure 'Título de Utilidad' = "Análisis de utilidad"
		displayFolder: _Narrativa

	partition FC_Ventas = m
		mode: import
		source =
				let
				    Origen = PostgreSQL.Database(Servidor, BaseDatos),
				    Tabla = Origen{[Schema="oro",Item="hecho_venta_linea"]}[Data]
				in
				    Tabla
