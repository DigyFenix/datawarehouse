table FC_Compras
	lineageTag: ff15f3bd-dfd2-4f18-a616-338439032e38

	/// Compra sin impuestos en MONEDA DE PRESENTACIÓN (consolidable entre sociedades).
	measure 'Compras netas' = SUM(FC_Compras[monto_sin_impuesto])
		formatString: "Q" #,0
		displayFolder: 01 Importes
		lineageTag: 78925f05-bd11-4c29-988a-84e9f40dd13a

	/// Compra con impuesto incluido, desde la cabecera del documento por la misma razón que en ventas.
	measure 'Compras netas con IVA' = SUM(FC_Compras[monto_con_impuesto])
		formatString: "Q" #,0
		displayFolder: 01 Importes
		lineageTag: 40346ded-4b57-444b-9126-cc554e583034

	/// IVA soportado en las compras, en moneda local.
	measure 'Impuesto de compras' = SUM(FC_Compras[monto_impuesto])
		formatString: "Q" #,0
		displayFolder: 01 Importes
		lineageTag: 1bd5ba25-6d30-4b1d-a11c-1dd989e17e69

	/// Saldo pendiente de pago de las facturas de compra, prorrateado por línea. INFORMATIVO: la cartera oficial sale del mayor.
	measure 'Saldo de facturas de compra' = SUM(FC_Compras[saldo_pendiente])
		formatString: "Q" #,0
		displayFolder: 01 Importes
		lineageTag: 08340f31-21f2-4917-98aa-fe83c5ffd8f7

	/// Compra a proveedores reales, sin el movimiento entre empresas del grupo.
	measure 'Compras a terceros' = CALCULATE([Compras netas], DM_Proveedor[es_intercompania] = FALSE)
		formatString: "Q" #,0
		displayFolder: 02 Terceros vs grupo
		lineageTag: aa566e1f-c1e5-4132-826d-964bd63dcbee

	/// Compra a otras empresas del propio grupo: traslado interno, no abastecimiento.
	measure 'Compras al grupo' = CALCULATE([Compras netas], DM_Proveedor[es_intercompania] = TRUE)
		formatString: "Q" #,0
		displayFolder: 02 Terceros vs grupo
		lineageTag: aa3aa4a5-df46-436d-bd6e-69695e68e9eb

	/// Qué parte del abastecimiento es interno.
	measure '% Compra al grupo' = DIVIDE([Compras al grupo], [Compras netas])
		formatString: 0.0%
		displayFolder: 02 Terceros vs grupo
		lineageTag: 46986382-498c-48da-87dc-5d420d1c44df

	/// Cantidad neta recibida; la nota de crédito a proveedor resta.
	measure 'Unidades compradas' = SUM(FC_Compras[cantidad])
		formatString: #,0
		displayFolder: 03 Conteos
		lineageTag: 5e5e35d9-990a-402c-ba8a-2a0059999a20

	/// Número de líneas de documento de compra.
	measure 'Líneas de compra' = COUNTROWS(FC_Compras)
		formatString: #,0
		displayFolder: 03 Conteos
		lineageTag: 7f6ddda4-01f2-4643-a12f-17accf4470de

	/// Facturas y notas de crédito de compra distintas del período.
	measure 'Documentos de compra' = DISTINCTCOUNT(FC_Compras[documento_id])
		formatString: #,0
		displayFolder: 03 Conteos
		lineageTag: eb730ba5-7413-4029-b706-154ea96852e5

	/// Proveedores distintos con movimiento en el período.
	measure 'Proveedores con compra' = CALCULATE(DISTINCTCOUNT(FC_Compras[proveedor_clave]), KEEPFILTERS(FC_Compras[monto_sin_impuesto] <> 0))
		formatString: #,0
		displayFolder: 03 Conteos
		lineageTag: c79f8b56-b763-4e9b-9f39-f758235d0db5

	/// Tamaño medio de la factura de compra.
	measure 'Compra promedio por documento' = DIVIDE([Compras netas], [Documentos de compra])
		formatString: "Q" #,0
		displayFolder: 04 Promedios
		lineageTag: a69b05df-c083-4e6b-bd39-f4693fb21361

	/// Cuánto se le compra en promedio a cada proveedor activo.
	measure 'Compra promedio por proveedor' = DIVIDE([Compras netas], [Proveedores con compra])
		formatString: "Q" #,0
		displayFolder: 04 Promedios
		lineageTag: 6f9beeb8-c76c-4a94-9e7c-c3ec66869d43

	/// Promedio sobre los días que SÍ hubo compra.
	measure 'Compra promedio diaria' = DIVIDE([Compras netas], CALCULATE(DISTINCTCOUNT(DM_Calendario[fecha]), FC_Compras))
		formatString: "Q" #,0
		displayFolder: 04 Promedios
		lineageTag: 259f2c3d-029f-46d5-b1ee-6012643a66ed

	/// Compra del mes previo, para ver si el abastecimiento se aceleró.
	measure 'Compras mes anterior' = CALCULATE([Compras netas], DATEADD(DM_Calendario[fecha], -1, MONTH))
		formatString: "Q" #,0
		displayFolder: 05 Comparativos
		lineageTag: 0881ad5d-dd7b-4525-b0fb-a67883e70278

	/// Mismo período del año pasado, libre de estacionalidad.
	measure 'Compras año anterior' = CALCULATE([Compras netas], DATEADD(DM_Calendario[fecha], -1, YEAR))
		formatString: "Q" #,0
		displayFolder: 05 Comparativos
		lineageTag: b5c06bd0-4627-4903-be26-b1482860a0e6

	/// Acumulado desde el primer día del mes.
	measure 'Compras acumuladas mes' = TOTALMTD([Compras netas], DM_Calendario[fecha])
		formatString: "Q" #,0
		displayFolder: 05 Comparativos
		lineageTag: eafbc7ba-3d21-4023-9fc6-4b60076d4864

	/// Acumulado del ejercicio.
	measure 'Compras acumuladas año' = TOTALYTD([Compras netas], DM_Calendario[fecha])
		formatString: "Q" #,0
		displayFolder: 05 Comparativos
		lineageTag: c125f0c4-4145-47d2-9f31-6864ae5e14fb

	/// Acumulado del ejercicio anterior a la misma altura del año.
	measure 'Compras acumuladas año anterior' = CALCULATE(TOTALYTD([Compras netas], DM_Calendario[fecha]), DATEADD(DM_Calendario[fecha], -1, YEAR))
		formatString: "Q" #,0
		displayFolder: 05 Comparativos
		lineageTag: 0b847216-379e-4785-9e83-048f7a13973b

	/// Cambio contra el mes previo.
	measure 'Variación compras vs mes anterior' = DIVIDE([Compras netas] - [Compras mes anterior], [Compras mes anterior])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 05 Comparativos
		lineageTag: 95782543-778a-4d86-b0b8-c2976ddf81a8

	/// Cambio contra el mismo período del año pasado.
	measure 'Variación compras vs año anterior' = DIVIDE([Compras netas] - [Compras año anterior], [Compras año anterior])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 05 Comparativos
		lineageTag: d73fd481-21b5-45a7-b717-5f109632f8b5

	/// Suaviza el ruido mensual del abastecimiento. Promedia MESES, no días.
	measure 'Media móvil 3 meses compras' = CALCULATE(AVERAGEX(VALUES(DM_Calendario[anio_mes]), [Compras netas]), DATESINPERIOD(DM_Calendario[fecha], [_Fecha ancla móvil], -3, MONTH))
		formatString: "Q" #,0
		displayFolder: 05 Comparativos
		lineageTag: 2c6b6443-53e4-4692-bf0b-78815628b16d

	/// Compra de líneas sin código de artículo (servicios, fletes, gastos). En operaciones con mucho gasto indirecto puede ser la mayoría de las líneas de compra.
	measure 'Compras de servicios' = CALCULATE([Compras netas], KEEPFILTERS(DM_Producto[producto_codigo] = "SERVICIO"))
		formatString: "Q" #,0
		displayFolder: 01 Importes
		lineageTag: a2aef50c-03ab-4ae4-b857-4fb6cc8b8fc2

	/// Posición del proveedor por compra dentro del filtro vigente.
	measure 'Ranking de proveedor por compra' = RANKX(ALLSELECTED(DM_Proveedor), [Compras a terceros])
		formatString: #,0
		displayFolder: 06 Pareto
		lineageTag: 8b30d2c9-bb25-4ba0-8413-656652011bd3

	/// Curva de Pareto: % de la compra a terceros que acumulan este proveedor y los mayores que él.
	measure '% acumulado de compra proveedores' = VAR base = ADDCOLUMNS(ALLSELECTED(DM_Proveedor), "@v", [Compras a terceros]) VAR actual = [Compras a terceros] VAR total = SUMX(base, [@v]) VAR acum = SUMX(FILTER(base, [@v] >= actual), [@v]) RETURN DIVIDE(acum, total)
		formatString: 0.0%
		displayFolder: 06 Pareto
		lineageTag: 8df9e856-d297-4dd6-a035-bcbab46bb033

	/// Dependencia del proveedor más grande. Un número alto es riesgo de suministro y cero poder de negociación.
	measure '% Compra en el mayor proveedor' = DIVIDE(MAXX(ALLSELECTED(DM_Proveedor), [Compras a terceros]), CALCULATE([Compras a terceros], ALLSELECTED(DM_Proveedor)))
		formatString: 0.0%
		displayFolder: 06 Pareto
		lineageTag: 16642f58-9d60-46fd-89b4-56d9ccb2950c

	/// Concentración del abastecimiento en los diez mayores proveedores.
	measure '% Compra en top 10 proveedores' = DIVIDE(CALCULATE([Compras a terceros], TOPN(10, ALLSELECTED(DM_Proveedor), [Compras a terceros])), CALCULATE([Compras a terceros], ALLSELECTED(DM_Proveedor)))
		formatString: 0.0%
		displayFolder: 06 Pareto
		lineageTag: fca5c947-c904-44b6-8b10-7cbab59b412b

	/// Faltaba el espejo del acumulado trimestral de ventas.
	measure 'Compras acumuladas trimestre' = TOTALQTD([Compras netas], DM_Calendario[fecha])
		formatString: "Q" #,0
		displayFolder: 05 Comparativos
		lineageTag: fb46bba4-4e4a-48fc-a50b-89c45bcd40c1

	/// Compra de los últimos doce meses. Es la base de la rotación de inventario y de los días de pago.
	measure 'Compras 12 meses móviles' = CALCULATE([Compras netas], DATESINPERIOD(DM_Calendario[fecha], [_Fecha ancla móvil], -12, MONTH))
		formatString: "Q" #,0
		displayFolder: 05 Comparativos
		lineageTag: e7cec379-34bd-4ffb-9e52-c656b4779821

	/// Cómo va el abastecimiento del ejercicio completo contra el anterior.
	measure 'Variación compras acumulada vs año anterior' = DIVIDE([Compras acumuladas año] - [Compras acumuladas año anterior], [Compras acumuladas año anterior])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 05 Comparativos
		lineageTag: b6e23794-7e4f-472a-bb71-f231acac25db

	/// Precio unitario promedio pagado. Filtrar un producto para que signifique algo: mezclado entre artículos distintos no dice nada.
	measure 'Precio promedio de compra' = DIVIDE([Compras netas], [Unidades compradas])
		formatString: "Q" #,0.00
		displayFolder: 07 Inflación de insumos
		lineageTag: 6b5fb415-26c6-4971-8142-9259116268c4

	/// Precio unitario medio pagado el año pasado, base de la comparación de inflación de insumos.
	measure 'Precio de compra año anterior' = CALCULATE([Precio promedio de compra], SAMEPERIODLASTYEAR(DM_Calendario[fecha]))
		formatString: "Q" #,0.00
		displayFolder: 07 Inflación de insumos
		lineageTag: d455be0c-7663-4d6c-a3c1-edd2001cc52a

	/// Cuánto subió lo que compramos. Es la inflación REAL del negocio, medida sobre lo pagado, no sobre un índice.
	measure '% Variación de precio de compra' = DIVIDE([Precio promedio de compra] - [Precio de compra año anterior], [Precio de compra año anterior])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 07 Inflación de insumos
		lineageTag: c1c8ff92-75f7-4a92-87ce-6ee2a6e0113d

	/// Lo que costó de más comprar el volumen de hoy a los precios de hoy en vez de a los del año pasado.
	measure 'Sobrecosto por precio de compra' = ([Precio promedio de compra] - [Precio de compra año anterior]) * [Unidades compradas]
		formatString: "Q" #,0
		displayFolder: 07 Inflación de insumos
		lineageTag: 3b42d3c4-bb69-427a-b627-165294bcb643

