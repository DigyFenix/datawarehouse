table 'DM_Clasificación ABC'
	lineageTag: 06729aac-8f52-47a2-8bfb-fcef56f2447e

	/// Cuántos clientes concentran el 80% de la venta. En una cartera sana no son dos. Cuenta clientes DISTINTOS: la tabla tiene una fila por cliente y año, así que sin acotar el año un COUNTROWS contaría cliente-años.
	measure 'Clientes A' = CALCULATE(DISTINCTCOUNT('DM_Clasificación ABC'[cliente_clave]), KEEPFILTERS('DM_Clasificación ABC'[clase_abc] = "A"))
		formatString: #,0
		displayFolder: 01 Conteos
		lineageTag: 116072b2-458e-428d-affc-102e9838ed2a

	/// Clientes del tramo intermedio: entre el 80% y el 95% acumulado de la venta.
	measure 'Clientes B' = CALCULATE(DISTINCTCOUNT('DM_Clasificación ABC'[cliente_clave]), KEEPFILTERS('DM_Clasificación ABC'[clase_abc] = "B"))
		formatString: #,0
		displayFolder: 01 Conteos
		lineageTag: bb202961-1ced-4230-bb87-525ebba6a74a

	/// Cola larga. Muchos nombres y poca venta; el costo de atenderlos es lo que hay que vigilar.
	measure 'Clientes C' = CALCULATE(DISTINCTCOUNT('DM_Clasificación ABC'[cliente_clave]), KEEPFILTERS('DM_Clasificación ABC'[clase_abc] = "C"))
		formatString: #,0
		displayFolder: 01 Conteos
		lineageTag: 1fd85c49-b280-418e-b8cf-2e7306f3f526

	/// Clientes del catálogo sin venta en el año, o con solo devoluciones.
	measure 'Clientes sin venta neta' = CALCULATE(DISTINCTCOUNT('DM_Clasificación ABC'[cliente_clave]), KEEPFILTERS('DM_Clasificación ABC'[clase_abc] = "S"))
		formatString: #,0
		displayFolder: 01 Conteos
		lineageTag: 736b3230-c308-40ce-a0cc-db4f5114ab2f

	/// Clientes distintos en el catálogo ABC, excluida la intercompañía.
	measure 'Clientes clasificados' = DISTINCTCOUNT('DM_Clasificación ABC'[cliente_clave])
		formatString: #,0
		displayFolder: 01 Conteos
		lineageTag: 83460de4-49a2-497b-bed7-8ff133961ede

	/// Clientes que facturaron algún año anterior y nada en el año seleccionado: la lista de llamadas pendientes.
	measure 'Clientes perdidos' = CALCULATE(DISTINCTCOUNT('DM_Clasificación ABC'[cliente_clave]), KEEPFILTERS('DM_Clasificación ABC'[es_perdido] = TRUE))
		formatString: #,0
		displayFolder: 01 Conteos
		lineageTag: 8124fe88-0591-4930-9622-b6f632b62678

	/// Clientes cuya PRIMERA factura cae en el año seleccionado.
	measure 'Clientes estrenados en el año' = CALCULATE(DISTINCTCOUNT('DM_Clasificación ABC'[cliente_clave]), KEEPFILTERS('DM_Clasificación ABC'[es_nuevo] = TRUE))
		formatString: #,0
		displayFolder: 01 Conteos
		lineageTag: 53c0bdae-dbe8-4b12-a014-e0c9e882a9dd

	/// Riesgo de concentración: si los A son el 90% de la venta, perder uno duele de verdad.
	measure '% Venta en clientes A' = DIVIDE(CALCULATE(SUM('DM_Clasificación ABC'[venta]), KEEPFILTERS('DM_Clasificación ABC'[clase_abc] = "A")), SUM('DM_Clasificación ABC'[venta]))
		formatString: 0.0%
		displayFolder: 02 Concentración
		lineageTag: 1b84fa51-f5fc-480b-8fb3-93905c78f6c2

	/// Venta a terceros del año según el catálogo ABC. Sin filtrar un año en 'Año de clasificación' suma TODOS los años cargados.
	measure 'Venta del año clasificada' = SUM('DM_Clasificación ABC'[venta])
		formatString: "Q" #,0
		displayFolder: 02 Concentración
		lineageTag: bd6c4634-5bcb-4158-9c05-b3148b356e1a

	/// Cuánto factura en promedio un cliente clave.
	measure 'Venta promedio cliente A' = DIVIDE(CALCULATE(SUM('DM_Clasificación ABC'[venta]), KEEPFILTERS('DM_Clasificación ABC'[clase_abc] = "A")), [Clientes A])
		formatString: "Q" #,0
		displayFolder: 02 Concentración
		lineageTag: 822ce348-25e7-4e99-8d8e-fc552d29f47d

	/// Margen que dejan los clientes que hacen el negocio. Que sean los que más venden no garantiza que sean los que más dejan.
	measure 'Margen de clientes A' = CALCULATE(SUM('DM_Clasificación ABC'[margen]), KEEPFILTERS('DM_Clasificación ABC'[clase_abc] = "A"))
		formatString: "Q" #,0
		displayFolder: 02 Concentración
		lineageTag: 79ee6f4b-042f-4ee3-8d14-edfc070a3442

