table 'FC_Campos de usuario'
	lineageTag: bdc1c2cd-4a7a-410c-b6b6-01306746ae1d

	/// Cuántos valores de campos de usuario hay capturados en el filtro vigente.
	measure 'Valores de usuario capturados' = COUNTROWS('FC_Campos de usuario')
		formatString: #,0
		displayFolder: 01 Conteos
		lineageTag: 5e12cd02-f66f-48ff-ac4a-91088b165f77

	/// Cuántos campos de usuario del ERP tienen valores capturados en el filtro vigente.
	measure 'Campos de usuario distintos' = DISTINCTCOUNT('FC_Campos de usuario'[campo])
		formatString: #,0
		displayFolder: 01 Conteos
		lineageTag: 8d6a8baf-5bac-413b-8703-b19016acfa41

