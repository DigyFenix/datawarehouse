table DM_Proveedor

	column proveedor_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: proveedor_clave

	column empresa_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: empresa_id

	column proveedor_codigo
		dataType: string
		summarizeBy: none
		sourceColumn: proveedor_codigo

	column nombre
		dataType: string
		summarizeBy: none
		sourceColumn: nombre

	column nit
		dataType: string
		summarizeBy: none
		sourceColumn: nit

	column grupo_codigo
		dataType: string
		summarizeBy: none
		sourceColumn: grupo_codigo

	column condicion_pago_codigo
		dataType: string
		summarizeBy: none
		sourceColumn: condicion_pago_codigo

	column pais
		dataType: string
		summarizeBy: none
		sourceColumn: pais

	column region
		dataType: string
		summarizeBy: none
		sourceColumn: region

	column es_tambien_cliente
		dataType: boolean
		summarizeBy: none
		sourceColumn: es_tambien_cliente

	column es_intercompania
		dataType: boolean
		summarizeBy: none
		sourceColumn: es_intercompania

	column activo
		dataType: boolean
		summarizeBy: none
		sourceColumn: activo

	column clase_abc_actual
		dataType: string
		summarizeBy: none
		sourceColumn: clase_abc_actual

	column clase_abc_actual_nombre
		dataType: string
		summarizeBy: none
		sourceColumn: clase_abc_actual_nombre

	column valido_desde
		dataType: dateTime
		isHidden
		summarizeBy: none
		sourceColumn: valido_desde
		formatString: dd/MM/yyyy

	column valido_hasta
		dataType: dateTime
		isHidden
		summarizeBy: none
		sourceColumn: valido_hasta
		formatString: dd/MM/yyyy

	column es_vigente
		dataType: boolean
		isHidden
		summarizeBy: none
		sourceColumn: es_vigente

	partition DM_Proveedor = m
		mode: import
		source =
				let
				    Origen = PostgreSQL.Database(Servidor, BaseDatos),
				    Tabla = Origen{[Schema="oro",Item="dim_proveedor"]}[Data]
				in
				    Tabla
