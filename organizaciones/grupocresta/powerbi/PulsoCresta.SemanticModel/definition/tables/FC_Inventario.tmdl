table FC_Inventario
	lineageTag: e1fed18b-31fb-4341-9883-b8f1930a9afc

	/// Valor del inventario a la fecha de corte en MONEDA DE PRESENTACIÓN (SAP: OnHand × costo promedio; Odoo: capas de valoración).
	measure 'Valor de inventario' = SUM(FC_Inventario[valor])
		formatString: "Q" #,0
		displayFolder: 01 Importes
		lineageTag: 75fde140-f621-4e80-937c-4170a42829cb

	/// Cantidad física en bodega a la fecha de corte.
	measure 'Unidades en existencia' = SUM(FC_Inventario[cantidad])
		formatString: #,0
		displayFolder: 02 Conteos
		lineageTag: 5110e380-2663-4ba8-a9da-7d46313e5e22

	/// Artículos distintos con saldo en bodega.
	measure 'Productos con existencia' = CALCULATE(DISTINCTCOUNT(FC_Inventario[producto_clave]), KEEPFILTERS(FC_Inventario[cantidad] <> 0))
		formatString: #,0
		displayFolder: 02 Conteos
		lineageTag: 07d8da94-1a03-42da-b6ac-2ae87c2a640a

	/// Almacenes con movimiento vivo.
	measure 'Bodegas con existencia' = CALCULATE(DISTINCTCOUNT(FC_Inventario[almacen_clave]), KEEPFILTERS(FC_Inventario[cantidad] <> 0))
		formatString: #,0
		displayFolder: 02 Conteos
		lineageTag: 1569123c-68f2-4789-8f16-af08b7a3449c

	/// Costo unitario medio de lo que hay en bodega.
	measure 'Costo promedio ponderado' = DIVIDE([Valor de inventario], [Unidades en existencia])
		formatString: "Q" #,0.00
		displayFolder: 03 Promedios
		lineageTag: 5c737ffb-4f18-4f6e-9273-5b5da94582f6

	/// Veces que el inventario rota al año: costo de ventas de los últimos 12 meses sobre el valor actual.
	measure 'Rotación de inventario 12M' = DIVIDE(CALCULATE([Costo de ventas], DATESINPERIOD(DM_Calendario[fecha], [_Fecha ancla móvil], -12, MONTH)), [Valor de inventario])
		formatString: #,0.0
		displayFolder: 04 Rotación
		lineageTag: 3614ba6e-abed-4b45-846e-7ae6a5a21cc0

	/// Cuántos días tarda en consumirse la existencia actual. Es una de las tres patas del ciclo de conversión de efectivo.
	measure 'Días de inventario' = DIVIDE(365, [Rotación de inventario 12M])
		formatString: #,0
		displayFolder: 04 Rotación
		lineageTag: 9b44d241-a9ef-4500-bd57-b0293e8998d1

	/// Los días de inventario en la unidad con la que suele razonar compras.
	measure 'Meses de inventario' = DIVIDE([Días de inventario], 30)
		formatString: #,0.0
		displayFolder: 04 Rotación
		lineageTag: be218e29-c896-43f9-8411-1257403c6d1a

	/// Cuánto capital hay inmovilizado en bodega por cada quetzal de venta del período. Sube cuando se compra más rápido de lo que se vende.
	measure 'Inventario sobre ventas' = DIVIDE([Valor de inventario], [Ventas netas])
		formatString: 0.0%
		displayFolder: 04 Rotación
		lineageTag: e4b81189-52db-4ba6-9339-d20f4900e0a4

