	partition FC_Inventario = m
		mode: import
		source =
				let
				    Origen = PostgreSQL.Database(Servidor, BaseDatos),
				    Tabla = Origen{[Schema="oro",Item="hecho_inventario"]}[Data]
				in
				    Tabla

