	partition 'FC_Tipo de cambio' = m
		mode: import
		source =
				let
				    Origen = PostgreSQL.Database(Servidor, BaseDatos),
				    Tabla = Origen{[Schema="oro",Item="tipo_cambio"]}[Data]
				in
