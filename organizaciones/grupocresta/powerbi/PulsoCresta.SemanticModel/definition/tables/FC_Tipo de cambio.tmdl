table 'FC_Tipo de cambio'
	lineageTag: 626119ef-12a6-4a85-b1d3-8a74afb12890

	/// Tasa promedio del período filtrado (moneda local por 1 unidad). Filtrar una moneda para leerla.
	measure 'Tipo de cambio promedio' = AVERAGE('FC_Tipo de cambio'[tasa])
		formatString: #,0.0000
		displayFolder: 01 Tasa
		lineageTag: c5acc85e-1f1a-4535-b92a-bc858910af2f

	/// La tasa del último día con registro dentro del filtro.
	measure 'Tipo de cambio de cierre' = CALCULATE(AVERAGE('FC_Tipo de cambio'[tasa]), LASTDATE('FC_Tipo de cambio'[fecha]))
		formatString: #,0.0000
		displayFolder: 01 Tasa
		lineageTag: c65258a6-2ad7-440d-b88a-adc07e9ce190

	column tiempo_clave
		dataType: int64
		isHidden
		lineageTag: ab5db88b-0108-489d-93f3-b4e7101cc7d3
		summarizeBy: none
		sourceColumn: tiempo_clave

	column moneda_clave
