table 'DM_Clasificación ABC Proveedor'
	lineageTag: 537e2d9d-bbb3-4675-ae08-4c6b79cf2bf0

	/// Cuántos proveedores concentran el 80% de la compra: dependencia de suministro. Cuenta proveedores DISTINTOS, porque la tabla tiene una fila por proveedor y año.
	measure 'Proveedores A' = CALCULATE(DISTINCTCOUNT('DM_Clasificación ABC Proveedor'[proveedor_clave]), KEEPFILTERS('DM_Clasificación ABC Proveedor'[clase_abc] = "A"))
		formatString: #,0
		displayFolder: 01 Conteos
		lineageTag: 71ed4f29-bca5-4377-9f73-61020a3602ba

	/// Proveedores del tramo intermedio de la compra.
	measure 'Proveedores B' = CALCULATE(DISTINCTCOUNT('DM_Clasificación ABC Proveedor'[proveedor_clave]), KEEPFILTERS('DM_Clasificación ABC Proveedor'[clase_abc] = "B"))
		formatString: #,0
		displayFolder: 01 Conteos
		lineageTag: f38e0435-fc8e-4bfd-8315-d5494a415453

	/// Cola larga de proveedores: muchos, con poco volumen cada uno.
	measure 'Proveedores C' = CALCULATE(DISTINCTCOUNT('DM_Clasificación ABC Proveedor'[proveedor_clave]), KEEPFILTERS('DM_Clasificación ABC Proveedor'[clase_abc] = "C"))
		formatString: #,0
		displayFolder: 01 Conteos
		lineageTag: e4663d4c-204f-4e79-b421-9f214aca7bbb

	/// Proveedores del catálogo sin compra en el año.
	measure 'Proveedores sin compra neta' = CALCULATE(DISTINCTCOUNT('DM_Clasificación ABC Proveedor'[proveedor_clave]), KEEPFILTERS('DM_Clasificación ABC Proveedor'[clase_abc] = "S"))
		formatString: #,0
		displayFolder: 01 Conteos
		lineageTag: f7bec29b-6ac5-4622-a979-72693bfb6648

	/// Proveedores distintos en el catálogo ABC, excluida la intercompañía.
	measure 'Proveedores clasificados' = DISTINCTCOUNT('DM_Clasificación ABC Proveedor'[proveedor_clave])
		formatString: #,0
		displayFolder: 01 Conteos
		lineageTag: dab42f42-72fe-432b-93da-5f04af436fdb

	/// Proveedores a los que se compró algún año anterior y nada en el año seleccionado. No es una pérdida como la de un cliente, pero un abastecimiento que se apaga suele venir con una concentración que crece en otro lado.
	measure 'Proveedores inactivos' = CALCULATE(DISTINCTCOUNT('DM_Clasificación ABC Proveedor'[proveedor_clave]), KEEPFILTERS('DM_Clasificación ABC Proveedor'[es_inactivo] = TRUE))
		formatString: #,0
		displayFolder: 01 Conteos
		lineageTag: 12963461-0368-46f5-9d34-a63f0156d93f

	/// Proveedores cuya PRIMERA compra cae en el año seleccionado.
	measure 'Proveedores estrenados en el año' = CALCULATE(DISTINCTCOUNT('DM_Clasificación ABC Proveedor'[proveedor_clave]), KEEPFILTERS('DM_Clasificación ABC Proveedor'[es_nuevo] = TRUE))
		formatString: #,0
		displayFolder: 01 Conteos
		lineageTag: 1619ab5c-63de-4c1e-a029-6783e68f78de

	/// Riesgo de dependencia: si los A concentran el 90% de la compra, perder uno para la operación.
	measure '% Compra en proveedores A' = DIVIDE(CALCULATE(SUM('DM_Clasificación ABC Proveedor'[compra]), KEEPFILTERS('DM_Clasificación ABC Proveedor'[clase_abc] = "A")), SUM('DM_Clasificación ABC Proveedor'[compra]))
		formatString: 0.0%
		displayFolder: 02 Concentración
		lineageTag: b805e87c-3b97-476f-8d12-2f08fae725ab

	/// Compra a terceros del año según el catálogo ABC. Sin filtrar un año en 'Año de clasificación' suma TODOS los años cargados.
	measure 'Compra del año clasificada' = SUM('DM_Clasificación ABC Proveedor'[compra])
		formatString: "Q" #,0
		displayFolder: 02 Concentración
		lineageTag: 295f6f25-7734-4ed5-b5d3-09d3d7d086bf

	/// Volumen medio con un proveedor crítico.
	measure 'Compra promedio proveedor A' = DIVIDE(CALCULATE(SUM('DM_Clasificación ABC Proveedor'[compra]), KEEPFILTERS('DM_Clasificación ABC Proveedor'[clase_abc] = "A")), [Proveedores A])
		formatString: "Q" #,0
		displayFolder: 02 Concentración
		lineageTag: ec8f1a01-5ad5-461c-b0cd-c11ea313bb88

