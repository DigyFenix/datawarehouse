table 'FC_Pagos recibidos'
	lineageTag: c90a7355-79dd-48fb-a236-c7ace5eb2fc6

	/// Flujo de cobros del período en MONEDA DE PRESENTACIÓN. INFORMATIVO para caja: el saldo de cartera sale del mayor.
	measure 'Monto cobrado' = SUM('FC_Pagos recibidos'[monto])
		formatString: "Q" #,0
		displayFolder: 01 Importes
		lineageTag: 18dcbf75-63bf-487f-b1b0-0ef86bb053da

	/// Solo cobranza de CLIENTES. Los pagos recibidos del ERP mezclan cobranza con operaciones de tesorería contra cuenta contable (depósitos, traslados); sin este filtro la cobranza se infla.
	measure 'Cobros de clientes' = CALCULATE([Monto cobrado], KEEPFILTERS('FC_Pagos recibidos'[contraparte] = "cliente"))
		formatString: "Q" #,0
		displayFolder: 01 Importes
		lineageTag: 4e177c15-cc1f-4e5d-8c37-a5290edd63f9

	/// Movimientos contra cuenta contable —depósitos y traslados—, no cobranza de clientes. En SAP viven en la misma tabla que los cobros y sin separarlos la cobranza se triplica.
	measure 'Cobros de tesorería' = CALCULATE([Monto cobrado], KEEPFILTERS('FC_Pagos recibidos'[contraparte] = "cuenta_contable"))
		formatString: "Q" #,0
		displayFolder: 01 Importes
		lineageTag: e5f31830-def9-44a3-89e7-abb04d51777d

	/// Cobranza de clientes contra la venta con IVA del mismo período: el pulso de la recuperación.
	measure '% Cobrado vs facturado' = DIVIDE([Cobros de clientes], [Ventas netas con IVA])
		formatString: 0.0%
		displayFolder: 01 Importes
		lineageTag: 5e7d0f18-c7d8-453b-b596-907e7bfc1756

	/// Número de documentos de cobro recibidos.
	measure 'Cantidad de cobros' = COUNTROWS('FC_Pagos recibidos')
		formatString: #,0
		displayFolder: 02 Conteos
		lineageTag: 64d22ab7-7e2e-4ac1-86d6-9d5031ad26c2

	/// Clientes distintos que hicieron algún pago en el período.
	measure 'Clientes que pagaron' = DISTINCTCOUNT('FC_Pagos recibidos'[cliente_clave])
		formatString: #,0
		displayFolder: 02 Conteos
		lineageTag: 6dd8e56d-fe65-48c9-90d7-d5172d29aacd

	/// Importe medio por documento de cobro.
	measure 'Cobro promedio' = DIVIDE([Monto cobrado], [Cantidad de cobros])
		formatString: "Q" #,0
		displayFolder: 03 Promedios
		lineageTag: f4eb0b01-8e1c-4c8e-953d-cb09c50d54b7

	/// Cobranza del mes previo.
	measure 'Cobros mes anterior' = CALCULATE([Monto cobrado], DATEADD(DM_Calendario[fecha], -1, MONTH))
		formatString: "Q" #,0
		displayFolder: 04 Comparativos
		lineageTag: d7a14815-7411-4212-a4ca-95a960c683c5

	/// Cobranza acumulada del ejercicio.
	measure 'Cobros acumulados año' = TOTALYTD([Monto cobrado], DM_Calendario[fecha])
		formatString: "Q" #,0
		displayFolder: 04 Comparativos
		lineageTag: 05cfa204-be5b-49c2-9890-3074c555fba5

	/// Cobranza del mismo período del año pasado.
	measure 'Cobros año anterior' = CALCULATE([Monto cobrado], SAMEPERIODLASTYEAR(DM_Calendario[fecha]))
		formatString: "Q" #,0
		displayFolder: 04 Comparativos
		lineageTag: 55f8ef10-e3bd-4501-a29d-4cfd032d1ee3

	/// Cobranza acumulada desde el primer día del mes.
	measure 'Cobros acumulados mes' = TOTALMTD([Monto cobrado], DM_Calendario[fecha])
		formatString: "Q" #,0
		displayFolder: 04 Comparativos
		lineageTag: d474d023-35ca-4ee4-b9ae-4e064141338e

	/// Cambio en la cobranza contra el año pasado.
	measure 'Variación de cobros vs año anterior' = DIVIDE([Monto cobrado] - [Cobros año anterior], [Cobros año anterior])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 04 Comparativos
		lineageTag: 49751f87-0ec2-445a-9edc-f15765c2d3ea

	/// Reparto del cobro por instrumento. Un salto del efectivo o una caída de la transferencia cambia el riesgo operativo y el costo bancario.
	measure '% Cobro en el medio principal' = DIVIDE(MAXX(ALLSELECTED('FC_Pagos recibidos'[medio_pago]), [Cobros de clientes]), CALCULATE([Cobros de clientes], ALLSELECTED('FC_Pagos recibidos'[medio_pago])))
		formatString: 0.0%
		displayFolder: 05 Mix de cobro
		lineageTag: 17914ccc-1a3a-4f7b-ac39-864cb8ba2c88

