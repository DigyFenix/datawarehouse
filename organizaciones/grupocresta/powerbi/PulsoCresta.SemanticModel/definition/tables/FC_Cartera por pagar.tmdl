table 'FC_Cartera por pagar'
	lineageTag: b9d92fb6-cda2-473f-9953-dbf884a54efa

	/// En positivo para poder compararlo con la cartera por cobrar sin invertir signos en cada visual. MONEDA DE PRESENTACIÓN.
	measure 'Saldo por pagar' = SUM('FC_Cartera por pagar'[saldo_pendiente_absoluto])
		formatString: "Q" #,0
		displayFolder: 01 Saldo
		lineageTag: bd21ecba-cecc-47ea-bd2f-131171368215

	/// Lo que se debe a proveedores reales.
	measure 'Saldo por pagar terceros' = CALCULATE([Saldo por pagar], DM_Proveedor[es_intercompania] = FALSE)
		formatString: "Q" #,0
		displayFolder: 01 Saldo
		lineageTag: cf606d12-59f4-4108-a3c6-b21ff5e170f2

	/// Deuda con empresas del propio grupo: se netea al consolidar.
	measure 'Saldo por pagar grupo' = CALCULATE([Saldo por pagar], DM_Proveedor[es_intercompania] = TRUE)
		formatString: "Q" #,0
		displayFolder: 01 Saldo
		lineageTag: 49be9133-931e-4a75-bfca-d52ddc03c687

	/// Lo que se cobra menos lo que se debe: la liquidez estructural del negocio.
	measure 'Posición neta' = [Saldo por cobrar] - [Saldo por pagar]
		formatString: "Q" #,0
		displayFolder: 01 Saldo
		lineageTag: 89817d3d-f52b-4dfe-828f-8581b5087265

	/// Número de partidas abiertas de deuda.
	measure 'Partidas por pagar' = COUNTROWS('FC_Cartera por pagar')
		formatString: #,0
		displayFolder: 02 Conteos
		lineageTag: e2409fad-07e8-4c19-b4a7-e286648e332c

	/// Proveedores distintos a los que se les debe.
	measure 'Proveedores con saldo' = DISTINCTCOUNT('FC_Cartera por pagar'[proveedor_clave])
		formatString: #,0
		displayFolder: 02 Conteos
		lineageTag: 70ff67e2-9f66-4e3f-948e-73255726ea11

	/// Deuda que ya pasó su fecha de pago. Sostenida en el tiempo es señal de tensión de caja, no de buena negociación.
	measure 'Por pagar vencido' = CALCULATE([Saldo por pagar], KEEPFILTERS('DM_Antigüedad'[es_vencido] = TRUE))
		formatString: "Q" #,0
		displayFolder: 03 Antigüedad
		lineageTag: 94f226c4-be82-43e1-9823-7fddb2c5ca50

	/// Qué parte de lo que se debe ya está vencido.
	measure '% Por pagar vencido' = DIVIDE([Por pagar vencido], [Saldo por pagar])
		formatString: 0.0%
		displayFolder: 03 Antigüedad
		lineageTag: 62a4f7a8-0c0c-462d-a795-46d797e82c52

	/// Deuda vieja con proveedores; suele venir con suministro en riesgo.
	measure 'Por pagar más de 90' = CALCULATE([Saldo por pagar], KEEPFILTERS('DM_Antigüedad'[rango_aging] = "+90"))
		formatString: "Q" #,0
		displayFolder: 03 Antigüedad
		lineageTag: c47faac7-d4ff-4bba-ba85-a4b62321da1b

	/// Foto de HOY: ignora el filtro de fechas de la página (el saldo es una foto, no un flujo).
	measure 'Por pagar hoy' = CALCULATE([Saldo por pagar], REMOVEFILTERS(DM_Calendario))
		formatString: "Q" #,0
		displayFolder: 04 Foto de hoy
		lineageTag: 43b71187-9e43-4e92-b4b8-e3cc43cb3e98

	/// Cobrar menos deber, foto de hoy, sin el filtro de período.
	measure 'Posición neta hoy' = CALCULATE([Posición neta], REMOVEFILTERS(DM_Calendario))
		formatString: "Q" #,0
		displayFolder: 04 Foto de hoy
		lineageTag: f45c8cc3-0c85-4963-beb3-45ce92a6a9c3

	/// DPO: días que tardamos en pagar a proveedores. Misma convención que 'Días de cartera terceros' para que el ciclo de efectivo cuadre.
	measure 'Días de pago terceros' = DIVIDE([Saldo por pagar terceros], DIVIDE([Compras a terceros], CALCULATE(DISTINCTCOUNT(DM_Calendario[fecha]), FC_Compras)))
		formatString: #,0.0
		displayFolder: 05 Ciclo de efectivo
		lineageTag: c07c3842-807d-47a6-a191-0880c92a7145

	/// Veces al año que se paga la deuda completa. Es el recíproco de los días de pago.
	measure 'Rotación de cuentas por pagar' = DIVIDE(365, [Días de pago terceros])
		formatString: #,0.0
		displayFolder: 05 Ciclo de efectivo
		lineageTag: b72392e4-0a59-4f69-bf7b-6bc4e146ec88

	/// CICLO DE CONVERSIÓN DE EFECTIVO: días que el dinero pasa atrapado en el negocio antes de volver a caja. Cobrar + inventario − pagar. Bajarlo libera capital de trabajo sin pedir un préstamo; es la métrica de liquidez que más mueve la aguja en una PyME. Negativo significa que los proveedores financian la operación.
	measure 'Ciclo de conversión de efectivo' = [Días de cartera terceros] + [Días de inventario] - [Días de pago terceros]
		formatString: #,0.0
		displayFolder: 05 Ciclo de efectivo
		lineageTag: bea9d15e-e24e-4991-81f4-65172f8934e7

	/// A cuántos proveedores se les debe algo ya vencido.
	measure 'Proveedores con saldo vencido' = CALCULATE(DISTINCTCOUNT('FC_Cartera por pagar'[proveedor_clave]), KEEPFILTERS('DM_Antigüedad'[es_vencido] = TRUE))
		formatString: #,0
		displayFolder: 02 Conteos
		lineageTag: c73c496f-10f4-43f4-be09-0808502c87a1

	/// Partidas sin fecha de pago pactada: normalmente anticipos o ajustes sin depurar.
	measure 'Por pagar sin vencimiento' = CALCULATE([Saldo por pagar], KEEPFILTERS('DM_Antigüedad'[rango_aging] = "sin_vencimiento"))
		formatString: "Q" #,0
		displayFolder: 03 Antigüedad
		lineageTag: 65253ba8-3d5e-4113-991b-7f44122c9de3

	/// Concentración de la deuda: cuánto pesa el acreedor más grande sobre el total por pagar.
	measure '% Deuda en el mayor acreedor' = DIVIDE(MAXX(ALLSELECTED(DM_Proveedor), [Saldo por pagar terceros]), CALCULATE([Saldo por pagar terceros], ALLSELECTED(DM_Proveedor)))
		formatString: 0.0%
		displayFolder: 03 Antigüedad
		lineageTag: d06ebd80-503b-455d-89ce-c1fdccb058aa

