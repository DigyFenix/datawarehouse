table 'DM_Comportamiento de pago'
	lineageTag: 088795ba-6ced-48d2-bc18-2b2328c3218e

	/// Clientes sin nada vencido. El objetivo de la gestión de cobranza.
	measure 'Clientes al día' = CALCULATE(COUNTROWS('DM_Comportamiento de pago'), KEEPFILTERS('DM_Comportamiento de pago'[perfil_riesgo] = "al_dia"))
		formatString: #,0
		displayFolder: 01 Conteos
		lineageTag: 58063a18-2942-41ac-b118-7b8ee717d07a

	/// Más de 90 días vencido o más de la mitad del saldo vencido: revisar antes de despachar.
	measure 'Clientes en vencido crítico' = CALCULATE(COUNTROWS('DM_Comportamiento de pago'), KEEPFILTERS('DM_Comportamiento de pago'[perfil_riesgo] = "vencido_critico"))
		formatString: #,0
		displayFolder: 01 Conteos
		lineageTag: cbf66a68-1480-4923-9af9-21eeb3e776c0

	/// Clientes con al menos una partida en mora.
	measure 'Clientes con saldo vencido' = CALCULATE(COUNTROWS('DM_Comportamiento de pago'), 'DM_Comportamiento de pago'[perfil_riesgo] IN {"vencido_leve", "vencido_moderado", "vencido_critico"})
		formatString: #,0
		displayFolder: 01 Conteos
		lineageTag: ddfee187-f396-4850-8049-a9c18f9acde7

	/// Dinero expuesto en los clientes de peor perfil de pago.
	measure 'Saldo en clientes críticos' = CALCULATE(SUM('DM_Comportamiento de pago'[saldo_total]), KEEPFILTERS('DM_Comportamiento de pago'[perfil_riesgo] = "vencido_critico"))
		formatString: "Q" #,0
		displayFolder: 02 Montos
		lineageTag: e00ef10b-2865-432a-b13c-197f0aa02ba7

	/// Del saldo total abierto, cuánto ya venció. El termómetro de la salud de la cartera.
	measure '% cartera vencida (clientes)' = DIVIDE(SUM('DM_Comportamiento de pago'[saldo_vencido]), SUM('DM_Comportamiento de pago'[saldo_total]))
		formatString: 0.0%
		displayFolder: 02 Montos
		lineageTag: 6a20982c-d664-4a18-9249-aa5d3e0a1c8e

