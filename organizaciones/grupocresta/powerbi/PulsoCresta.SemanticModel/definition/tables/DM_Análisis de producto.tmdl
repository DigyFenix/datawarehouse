table 'DM_Análisis de producto'
	lineageTag: 8ef64f28-cf65-45fc-9b33-e730f6cb6d48

	/// Dinero parado: productos que SÍ se vendieron alguna vez, tienen existencia, y llevan más de 90 días sin facturarse. Es la primera lista que debería recibir compras. Usa TREATAS porque la relación con Producto es unidireccional: el filtro de la ficha se aplica explícitamente y solo donde esta medida lo necesita, sin propagación global.
	measure 'Valor de inventario ocioso' = CALCULATE([Valor de inventario], TREATAS(CALCULATETABLE(VALUES('DM_Análisis de producto'[producto_clave]), KEEPFILTERS('DM_Análisis de producto'[es_ocioso] = TRUE)), DM_Producto[producto_clave]))
		formatString: "Q" #,0
		displayFolder: 01 Inventario muerto
		lineageTag: ad9a2786-35ce-4bdb-8660-74bf1de5262e

	/// Artículos con existencia que se vendieron alguna vez y llevan más de 90 días parados.
	measure 'Productos ociosos' = CALCULATE(COUNTROWS('DM_Análisis de producto'), KEEPFILTERS('DM_Análisis de producto'[es_ocioso] = TRUE))
		formatString: #,0
		displayFolder: 01 Inventario muerto
		lineageTag: 7ff442bb-ae29-4f45-82bf-fdb1599a3163

	/// Qué parte del valor en bodega está muerto y es accionable.
	measure '% Inventario ocioso' = DIVIDE([Valor de inventario ocioso], [Valor de inventario])
		formatString: 0.0%
		displayFolder: 01 Inventario muerto
		lineageTag: db743a2e-771e-4df6-95a6-90da8e36f180

	/// Existencia de artículos que NUNCA se han facturado. En una comercializadora es alarma; en una productora es insumo normal (alimento, medicina, empaque) que se consume sin pasar por una factura. Se separa del ocioso justamente para no confundir las dos cosas.
	measure 'Valor sin rotación comercial' = CALCULATE([Valor de inventario], TREATAS(CALCULATETABLE(VALUES('DM_Análisis de producto'[producto_clave]), KEEPFILTERS('DM_Análisis de producto'[es_sin_rotacion_comercial] = TRUE)), DM_Producto[producto_clave]))
		formatString: "Q" #,0
		displayFolder: 01 Inventario muerto
		lineageTag: aa6bfb3d-2998-46d8-a334-caace5c680ed

	/// Artículos con existencia que NUNCA se facturaron. En una productora son insumos normales; en una comercializadora, alarma.
	measure 'Productos sin rotación comercial' = CALCULATE(COUNTROWS('DM_Análisis de producto'), KEEPFILTERS('DM_Análisis de producto'[es_sin_rotacion_comercial] = TRUE))
		formatString: #,0
		displayFolder: 01 Inventario muerto
		lineageTag: 57b234e0-72df-42ef-9475-7d1d1418fefb

	/// Productos con demanda en los últimos 30 días y CERO existencia hoy: venta que se está perdiendo ahora mismo.
	measure 'Productos en quiebre' = CALCULATE(COUNTROWS('DM_Análisis de producto'), KEEPFILTERS('DM_Análisis de producto'[es_quiebre] = TRUE))
		formatString: #,0
		displayFolder: 02 Quiebre de stock
		lineageTag: 1cf30ece-e67c-44e7-9c80-a2e5917becf5

	/// Cuánto facturaron en 12 meses los productos que hoy están agotados. Dimensiona lo que está en juego mientras no se reponga.
	measure 'Venta anual en riesgo por quiebre' = CALCULATE(SUM('DM_Análisis de producto'[venta_12m]), KEEPFILTERS('DM_Análisis de producto'[es_quiebre] = TRUE))
		formatString: "Q" #,0
		displayFolder: 02 Quiebre de stock
		lineageTag: 2f04b622-de5e-43e3-955b-93aa008689ac

	/// Cuántos días de venta cubre la existencia al ritmo de los últimos 12 meses.
	measure 'Cobertura promedio en días' = AVERAGE('DM_Análisis de producto'[dias_cobertura])
		formatString: #,0
		displayFolder: 03 Cobertura
		lineageTag: 58e2f250-c903-4828-a823-cba972abe4dc

	/// Artículos del catálogo sin nada en bodega hoy.
	measure 'Productos sin existencia' = CALCULATE(COUNTROWS('DM_Análisis de producto'), KEEPFILTERS('DM_Análisis de producto'[stock_cantidad] <= 0))
		formatString: #,0
		displayFolder: 03 Cobertura
		lineageTag: 5a559143-ef9f-4934-94cd-196559352490

	/// Cuántos artículos hacen el 80% de la venta. Sobre estos se cuida el nivel de servicio; el resto puede esperar.
	measure 'Productos A' = CALCULATE(COUNTROWS('DM_Análisis de producto'), KEEPFILTERS('DM_Análisis de producto'[clase_abc_producto] = "A"))
		formatString: #,0
		displayFolder: 04 Concentración
		lineageTag: 9cb53431-3fc2-40f8-aa5f-2d4a6db3fd62

	/// Artículos del tramo intermedio de la venta.
	measure 'Productos B' = CALCULATE(COUNTROWS('DM_Análisis de producto'), KEEPFILTERS('DM_Análisis de producto'[clase_abc_producto] = "B"))
		formatString: #,0
		displayFolder: 04 Concentración
		lineageTag: 02a85f73-20f1-436a-93c4-6292e546acff

	/// Cola larga del catálogo: poca venta y, con frecuencia, mucha bodega.
	measure 'Productos C' = CALCULATE(COUNTROWS('DM_Análisis de producto'), KEEPFILTERS('DM_Análisis de producto'[clase_abc_producto] = "C"))
		formatString: #,0
		displayFolder: 04 Concentración
		lineageTag: 35d201b3-7118-42f5-8856-f0a11013fa87

	/// Concentración de la venta en los artículos clave.
	measure '% Venta en productos A' = DIVIDE(CALCULATE(SUM('DM_Análisis de producto'[venta_12m]), KEEPFILTERS('DM_Análisis de producto'[clase_abc_producto] = "A")), SUM('DM_Análisis de producto'[venta_12m]))
		formatString: 0.0%
		displayFolder: 04 Concentración
		lineageTag: 3cca8024-397a-4831-83de-e8ac7486ce70

	/// Inventario inmovilizado en artículos de cola larga: lo que menos vende ocupando bodega.
	measure 'Inventario en productos C' = CALCULATE([Valor de inventario], TREATAS(CALCULATETABLE(VALUES('DM_Análisis de producto'[producto_clave]), KEEPFILTERS('DM_Análisis de producto'[clase_abc_producto] = "C")), DM_Producto[producto_clave]))
		formatString: "Q" #,0
		displayFolder: 04 Concentración
		lineageTag: e1a7c2ad-790a-45dd-ae07-313ff5028347

