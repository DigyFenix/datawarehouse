table 'FC_Pagos efectuados'
	lineageTag: 69d38049-2574-487a-a219-2fa5bb1b044c

	/// Salidas de caja del período, cualquiera sea la contraparte.
	measure 'Monto pagado' = SUM('FC_Pagos efectuados'[monto])
		formatString: "Q" #,0
		displayFolder: 01 Importes
		lineageTag: 480443ec-0842-4855-9817-627622c5fe47

	/// Solo pagos a PROVEEDORES (excluye operaciones de tesorería contra cuenta contable).
	measure 'Pagos a proveedores' = CALCULATE([Monto pagado], KEEPFILTERS('FC_Pagos efectuados'[contraparte] = "proveedor"))
		formatString: "Q" #,0
		displayFolder: 01 Importes
		lineageTag: ad25ff34-4478-4dc4-a34d-bddae63f0cda

	/// Lo cobrado menos lo pagado en el período filtrado: el pulso de caja operativo.
	measure 'Flujo neto de caja' = [Monto cobrado] - [Monto pagado]
		formatString: "Q" #,0
		displayFolder: 01 Importes
		lineageTag: b1a4230f-f39e-4112-b490-f0c9e7cd65cb

	/// Número de documentos de pago emitidos.
	measure 'Cantidad de pagos' = COUNTROWS('FC_Pagos efectuados')
		formatString: #,0
		displayFolder: 02 Conteos
		lineageTag: f8cf3a3b-6113-4b55-9c7b-5fb7ab1edf31

	/// Proveedores distintos a los que se les pagó.
	measure 'Proveedores pagados' = DISTINCTCOUNT('FC_Pagos efectuados'[proveedor_clave])
		formatString: #,0
		displayFolder: 02 Conteos
		lineageTag: 5e214149-6334-41c7-908b-a5c15d93750c

	/// Importe medio por documento de pago.
	measure 'Pago promedio' = DIVIDE([Monto pagado], [Cantidad de pagos])
		formatString: "Q" #,0
		displayFolder: 03 Promedios
		lineageTag: 8354510d-c566-42c0-adf5-a165f8301478

	/// Salidas del mes previo.
	measure 'Pagos mes anterior' = CALCULATE([Monto pagado], DATEADD(DM_Calendario[fecha], -1, MONTH))
		formatString: "Q" #,0
		displayFolder: 04 Comparativos
		lineageTag: 1178f82d-168b-46b2-b8a2-c47ee2e372a6

	/// Salidas acumuladas del ejercicio.
	measure 'Pagos acumulados año' = TOTALYTD([Monto pagado], DM_Calendario[fecha])
		formatString: "Q" #,0
		displayFolder: 04 Comparativos
		lineageTag: b90fadce-3b92-4923-9943-6d498631bd2a

	/// Salidas del mismo período del año pasado.
	measure 'Pagos año anterior' = CALCULATE([Monto pagado], SAMEPERIODLASTYEAR(DM_Calendario[fecha]))
		formatString: "Q" #,0
		displayFolder: 04 Comparativos
		lineageTag: f468b9cf-d267-4d9a-8308-04042786dc44

	/// Salidas acumuladas desde el primer día del mes.
	measure 'Pagos acumulados mes' = TOTALMTD([Monto pagado], DM_Calendario[fecha])
		formatString: "Q" #,0
		displayFolder: 04 Comparativos
		lineageTag: 84ca680f-5ade-4048-a329-f9dea38ba1ca

	/// Cambio en las salidas contra el año pasado.
	measure 'Variación de pagos vs año anterior' = DIVIDE([Monto pagado] - [Pagos año anterior], [Pagos año anterior])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 04 Comparativos
		lineageTag: 953370ee-4563-4100-b681-616276358f77

	/// Caja neta acumulada del año: lo cobrado menos lo pagado desde el 1 de enero.
	measure 'Flujo neto acumulado año' = [Cobros acumulados año] - [Pagos acumulados año]
		formatString: "Q" #,0
		displayFolder: 04 Comparativos
		lineageTag: 0c815571-b150-43f6-837c-aa24df085b61

