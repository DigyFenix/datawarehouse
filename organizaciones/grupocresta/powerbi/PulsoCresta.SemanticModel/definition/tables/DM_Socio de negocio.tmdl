	partition 'DM_Socio de negocio' = m
		mode: import
		source =
				let
				    Origen = PostgreSQL.Database(Servidor, BaseDatos),
				    Tabla = Origen{[Schema="oro",Item="dim_socio_negocio"]}[Data]
				in
				    Tabla
