		isHidden
		summarizeBy: none
		sourceColumn: empresa_id

	column socio_codigo
		dataType: string
		summarizeBy: none
		sourceColumn: socio_codigo

	column nombre
		dataType: string
		summarizeBy: none
		sourceColumn: nombre

	column socio_unificado
		dataType: string
		summarizeBy: none
		sourceColumn: socio_unificado

	column nit
		dataType: string
		summarizeBy: none
		sourceColumn: nit

	column grupo_codigo
		dataType: string
		summarizeBy: none
		sourceColumn: grupo_codigo

	column condicion_pago_codigo
		dataType: string
		summarizeBy: none
		sourceColumn: condicion_pago_codigo

	column pais
		dataType: string
		summarizeBy: none
