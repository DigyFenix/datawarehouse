table DM_Antigüedad

	column rango_aging_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: rango_aging_clave

	column rango_aging
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: rango_aging
		sortByColumn: rango_aging_orden

	column rango_aging_nombre
		dataType: string
		summarizeBy: none
		sourceColumn: rango_aging_nombre
		sortByColumn: rango_aging_orden

	column rango_aging_orden
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: rango_aging_orden
		formatString: #,0

	column dias_desde
		dataType: int64
		summarizeBy: none
		sourceColumn: dias_desde
		formatString: #,0

	column dias_hasta
		dataType: int64
		summarizeBy: none
		sourceColumn: dias_hasta
		formatString: #,0

	column es_vencido
		dataType: boolean
		summarizeBy: none
		sourceColumn: es_vencido

	column severidad
		dataType: string
		summarizeBy: none
		sourceColumn: severidad

	column valido_desde
		dataType: dateTime
		isHidden
		summarizeBy: none
		sourceColumn: valido_desde
		formatString: dd/MM/yyyy

	column valido_hasta
		dataType: dateTime
		isHidden
		summarizeBy: none
		sourceColumn: valido_hasta
		formatString: dd/MM/yyyy

	column es_vigente
		dataType: boolean
		isHidden
		summarizeBy: none
		sourceColumn: es_vigente

	partition DM_Antigüedad = m
		mode: import
		source =
				let
				    Origen = PostgreSQL.Database(Servidor, BaseDatos),
				    Tabla = Origen{[Schema="oro",Item="dim_rango_aging"]}[Data]
				in
				    Tabla
