table 'FC_Cartera pagar histórico'
	lineageTag: 2a80ee97-91fc-49df-9d25-8f06d50ec475

	/// Saldo por pagar a la fecha de corte de la foto, en positivo. MONEDA DE PRESENTACIÓN.
	measure 'Saldo histórico por pagar' = SUM('FC_Cartera pagar histórico'[saldo_pendiente_absoluto])
		formatString: "Q" #,0
		displayFolder: 01 Evolución
		lineageTag: 0dc08004-f939-485c-9fa2-a0e59d197532

	/// Deuda vencida en la fecha de corte de la foto.
	measure 'Vencido histórico por pagar' = CALCULATE([Saldo histórico por pagar], KEEPFILTERS('FC_Cartera pagar histórico'[dias_vencido] > 0))
		formatString: "Q" #,0
		displayFolder: 01 Evolución
		lineageTag: 3d774ac8-f750-4af5-b08b-d89163a213e9

	/// Posición neta a lo largo del tiempo: la serie que muestra si la liquidez estructural mejora o se deteriora.
	measure 'Posición neta histórica' = [Saldo histórico por cobrar] - [Saldo histórico por pagar]
		formatString: "Q" #,0
		displayFolder: 01 Evolución
		lineageTag: 2dbf1b62-b81f-4134-b0f7-2ef64739e436

