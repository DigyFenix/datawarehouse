table FC_Pedidos
	lineageTag: 35000572-bccc-49c1-9c2e-c185881ff061

	/// Base SIN impuesto de lo pedido en el período. El COMPROMISO, no el resultado (eso es Ventas).
	measure 'Monto pedido' = SUM(FC_Pedidos[monto_sin_impuesto])
		formatString: "Q" #,0
		displayFolder: 01 Pedido
		lineageTag: 02d92019-feba-41f7-b3d7-e1b7ccab01b3

	/// Unidades comprometidas en los pedidos del período.
	measure 'Cantidad pedida' = SUM(FC_Pedidos[cantidad])
		formatString: #,0
		displayFolder: 01 Pedido
		lineageTag: d7f7dc76-a483-41df-add2-b667591e47cd

	/// Número de pedidos distintos captados.
	measure 'Pedidos del período' = DISTINCTCOUNT(FC_Pedidos[pedido_id])
		formatString: #,0
		displayFolder: 01 Pedido
		lineageTag: 4e0836f0-26d4-4e05-a545-c38e95f13877

	/// Pedido y AÚN no cumplido (líneas abiertas): lo que la operación debe entregar/facturar.
	measure Backlog = CALCULATE(SUM(FC_Pedidos[monto_abierto]), KEEPFILTERS(FC_Pedidos[es_abierta] = TRUE))
		formatString: "Q" #,0
		displayFolder: 02 Backlog
		lineageTag: ac42d95d-8bb0-4e04-835d-983533f53153

	/// Unidades que faltan por entregar.
	measure 'Cantidad pendiente' = CALCULATE(SUM(FC_Pedidos[cantidad_abierta]), KEEPFILTERS(FC_Pedidos[es_abierta] = TRUE))
		formatString: #,0
		displayFolder: 02 Backlog
		lineageTag: 4c89e138-7e2e-4aca-b0f9-e28381b068ec

	/// Líneas de pedido con saldo por despachar.
	measure 'Líneas abiertas' = CALCULATE(COUNTROWS(FC_Pedidos), KEEPFILTERS(FC_Pedidos[es_abierta] = TRUE))
		formatString: #,0
		displayFolder: 02 Backlog
		lineageTag: 149d33a2-bd6d-4a2c-866f-7fd94e9259da

	/// De lo pedido, cuánto ya se cumplió (1 − backlog/pedido). El pulso de la operación.
	measure 'Fill rate' = 1 - DIVIDE([Backlog], [Monto pedido], 0)
		formatString: 0.0%
		displayFolder: 02 Backlog
		lineageTag: b0d8b048-15b5-4fe0-80ec-75b26fc6d309

	/// Líneas abiertas cuya fecha de entrega prometida YA PASÓ. Es incumplimiento en curso: el cliente lo está viviendo hoy.
	measure 'Líneas de pedido vencidas' = CALCULATE([Líneas abiertas], KEEPFILTERS(FC_Pedidos[fecha_entrega] < TODAY()))
		formatString: #,0
		displayFolder: 03 Cumplimiento
		lineageTag: ffadfdb0-c0ae-43bb-aac6-82dc7bd60574

	/// Compromiso cuya fecha de entrega prometida ya pasó. El cliente lo está viviendo hoy.
	measure 'Backlog vencido' = CALCULATE([Backlog], KEEPFILTERS(FC_Pedidos[fecha_entrega] < TODAY()))
		formatString: "Q" #,0
		displayFolder: 03 Cumplimiento
		lineageTag: 11128aae-f76f-4b81-bec9-71f036b7f15c

	/// Qué parte del compromiso pendiente ya está en incumplimiento.
	measure '% Backlog vencido' = DIVIDE([Backlog vencido], [Backlog])
		formatString: 0.0%
		displayFolder: 03 Cumplimiento
		lineageTag: 81dc4310-8d40-4ae6-a3f1-cb18ac746269

	/// Lo que hay que ENTREGAR en el período, por fecha de entrega prometida y no de pedido. Es la carga de trabajo comprometida de la operación: 'Backlog' dice cuánto se debe, esta dice cuándo toca. Sin ella no hay forma de preguntar "¿qué prometí entregar la semana entrante?".
	measure 'Entrega comprometida en el período' = CALCULATE([Backlog], USERELATIONSHIP(FC_Pedidos[tiempo_vencimiento_clave], DM_Calendario[tiempo_clave]))
		formatString: "Q" #,0
		displayFolder: 03 Cumplimiento
		lineageTag: 3dbfa217-b4cf-49e2-a63a-f3de8174ed62

	/// Días que se promete al cliente entre el pedido y la entrega. Si sube, la promesa comercial se está estirando.
	measure 'Lead time prometido' = AVERAGEX(FC_Pedidos, DATEDIFF(FC_Pedidos[fecha_pedido], FC_Pedidos[fecha_entrega], DAY))
		formatString: #,0.0
		displayFolder: 03 Cumplimiento
		lineageTag: a09cc8aa-afe6-49e2-8f52-e0cfbfd32a86

	/// Backlog traducido a días de venta: cuánto tiempo de operación hay ya comprometido.
	measure 'Backlog en días de venta' = DIVIDE([Backlog], DIVIDE([Ventas netas], CALCULATE(DISTINCTCOUNT(DM_Calendario[fecha]), FC_Ventas)))
		formatString: #,0.0
		displayFolder: 02 Backlog
		lineageTag: e1a03be1-c115-4232-99cb-c61f8b8f0fe8

	/// Tamaño medio del pedido captado.
	measure 'Ticket promedio de pedido' = DIVIDE([Monto pedido], [Pedidos del período])
		formatString: "Q" #,0
		displayFolder: 04 Promedios
		lineageTag: 78c147a1-5d15-48dc-acb2-809f9d7725d3

	/// Clientes distintos que colocaron pedido en el período.
	measure 'Clientes con pedido' = DISTINCTCOUNT(FC_Pedidos[cliente_clave])
		formatString: #,0
		displayFolder: 01 Pedido
		lineageTag: f65a56d5-f8cd-4dbd-9423-adcfb104d63c

	/// Captación del mes previo.
	measure 'Pedidos mes anterior' = CALCULATE([Monto pedido], DATEADD(DM_Calendario[fecha], -1, MONTH))
		formatString: "Q" #,0
		displayFolder: 05 Comparativos
		lineageTag: 2c6c879b-bc8d-4e5b-9405-4c46df3602a0

	/// Captación del mismo período del año pasado.
	measure 'Pedidos año anterior' = CALCULATE([Monto pedido], SAMEPERIODLASTYEAR(DM_Calendario[fecha]))
		formatString: "Q" #,0
		displayFolder: 05 Comparativos
		lineageTag: a6031101-f5cc-4ee2-a2e0-8f11bf337ebf

	/// Pedido contra facturación del mismo período: mide si la demanda captada se está convirtiendo en venta o se está represando.
	measure 'Pedido sobre facturado' = DIVIDE([Monto pedido], [Ventas netas])
		formatString: 0.0%
		displayFolder: 05 Comparativos
		lineageTag: 882a0d13-93bc-49b3-aa87-b7321999bc9d

	/// Texto del foco de backlog (página 01). Lo comprometido con fecha de entrega ya pasada: cada quetzal aquí es una promesa incumplida hoy.
	measure 'Alerta de backlog' = VAR v = [Backlog vencido] VAR p = [% Backlog vencido] RETURN IF(ISBLANK(v) || v = 0, "Sin entregas comprometidas vencidas", (IF(v < 0, "-", "") & "Q" & SWITCH(TRUE(), ABS(v) >= 1000000, FORMAT(ABS(v) / 1000000, "#,##0.0") & "M", ABS(v) >= 10000, FORMAT(ABS(v) / 1000, "#,##0") & "K", FORMAT(ABS(v), "#,##0"))) & " comprometido y no entregado · " & FORMAT(p, "0.0%") & " del backlog")
		displayFolder: _Narrativa
		lineageTag: 0f4d96b8-40a7-45cc-9aff-1aa0aaee1187

