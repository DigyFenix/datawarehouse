		dataType: int64
		isHidden
		lineageTag: 7fe5fb70-0a27-4968-a1f2-cd1f47de93aa
		summarizeBy: none
		sourceColumn: cuenta_clave

	column centro_costo_clave
		dataType: int64
		isHidden
		lineageTag: 0da4395b-cb7e-4022-959b-7be04fcbb23a
