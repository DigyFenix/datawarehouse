		dataType: int64
		isHidden
		lineageTag: 3dc83076-e42b-4753-bde3-661aef25cc7d
		summarizeBy: none
		sourceColumn: vendedor_clave

	column organizacion_clave
		dataType: int64
		isHidden
		lineageTag: b7d8e58a-0d78-4715-973f-7c06906aab4d
		summarizeBy: none
		sourceColumn: organizacion_clave

	column almacen_clave
		dataType: int64
		isHidden
