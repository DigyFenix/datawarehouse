table FC_Ventas
	lineageTag: 673866f4-43bb-49be-abd8-f0d0e0a45bb3

	/// Base de todo: venta sin impuestos en MONEDA DE PRESENTACIÓN (consolidable entre sociedades), con la nota de crédito ya en negativo. Una sociedad sin tasa válida no suma aquí (regla: sin tipo de cambio, no se consolida).
	measure 'Ventas netas' = SUM(FC_Ventas[monto_sin_impuesto])
		formatString: "Q" #,0
		displayFolder: 01 Importes
		lineageTag: f2f6eb28-219e-4546-9500-1c62136ec687

	/// Lo que el cliente realmente paga. Sale de la CABECERA del documento y no de la suma de líneas: el IVA se calcula por documento y sumarlo línea a línea desvía centavos contra el ERP.
	measure 'Ventas netas con IVA' = SUM(FC_Ventas[monto_con_impuesto])
		formatString: "Q" #,0
		displayFolder: 01 Importes
		lineageTag: 7fd5e456-eac2-4a4e-8340-7780b9980ca0

	/// Facturación del período antes de restar devoluciones.
	measure 'Ventas brutas' = CALCULATE([Ventas netas], KEEPFILTERS('DM_Tipo de documento'[tipo_documento] = "factura"))
		formatString: "Q" #,0
		displayFolder: 01 Importes
		lineageTag: 41310a0a-a9cc-4799-9a0f-49b681825ef3

	/// Notas de crédito del período, en positivo para poder compararlas contra la venta.
	measure Devoluciones = ABS(CALCULATE([Ventas netas], KEEPFILTERS('DM_Tipo de documento'[tipo_documento] = "nota_credito")))
		formatString: "Q" #,0
		displayFolder: 01 Importes
		lineageTag: 37ec4934-e6fa-4a16-8fd6-ca04665e5d45

	/// IVA de las ventas. Se queda en moneda LOCAL aunque el resto del modelo esté en moneda de presentación: es un concepto fiscal del país de cada sociedad.
	measure 'Impuesto facturado' = SUM(FC_Ventas[monto_impuesto])
		formatString: "Q" #,0
		displayFolder: 01 Importes
		lineageTag: 79fab610-8a3d-4fb7-b71f-a96964ad55f9

	/// Descuento concedido, tomado de lo realmente grabado en cada línea y no de una lista de precios teórica.
	measure 'Descuento otorgado' = SUM(FC_Ventas[monto_descuento])
		formatString: "Q" #,0
		displayFolder: 01 Importes
		lineageTag: fbd8daa4-8d16-4323-befe-0683a1a5c111

	/// Cuánto del precio se está cediendo. Que suba sin que suba el volumen es erosión de precio, no una promoción que funciona.
	measure '% Descuento' = DIVIDE([Descuento otorgado], [Ventas netas] + [Descuento otorgado])
		formatString: 0.0%
		displayFolder: 01 Importes
		lineageTag: 309981a1-c3cd-4855-899d-c2475689bfc8

	/// Saldo pendiente de las facturas visibles, prorrateado por línea (suma = saldo del documento). INFORMATIVO: la cartera oficial sale del mayor.
	measure 'Saldo de facturas' = SUM(FC_Ventas[saldo_pendiente])
		formatString: "Q" #,0
		displayFolder: 01 Importes
		lineageTag: 8642766f-243c-43d8-947c-7b5139a51c57

	/// El mercado real. La venta al grupo no compite por precio: mezclarla distorsiona todo indicador comercial.
	measure 'Ventas a terceros' = CALCULATE([Ventas netas], DM_Cliente[es_intercompania] = FALSE)
		formatString: "Q" #,0
		displayFolder: 02 Terceros vs grupo
		lineageTag: fababa6c-e22f-42bc-8b22-e7b206e213f0

	/// Facturación a otras empresas del propio grupo. Ni compite por precio ni la trabaja un vendedor.
	measure 'Ventas al grupo' = CALCULATE([Ventas netas], DM_Cliente[es_intercompania] = TRUE)
		formatString: "Q" #,0
		displayFolder: 02 Terceros vs grupo
		lineageTag: 56ac2339-733f-4c23-bce8-affed849cbba

	/// Qué parte de la facturación es movimiento interno entre compañías del grupo. Cuando pesa, cambia la lectura de cualquier ranking comercial: revisarla antes de comparar clientes.
	measure '% Venta al grupo' = DIVIDE([Ventas al grupo], [Ventas netas])
		formatString: 0.0%
		displayFolder: 02 Terceros vs grupo
		lineageTag: 4b9d7244-023c-4aea-9c79-562c25e7f74f

	/// Cantidad neta despachada; la nota de crédito resta.
	measure 'Unidades vendidas' = SUM(FC_Ventas[cantidad])
		formatString: #,0
		displayFolder: 03 Conteos
		lineageTag: c9897f4a-6001-4c69-ba0f-c9f1e2b2f083

	/// Número de líneas de documento — el grano del hecho.
	measure 'Líneas de venta' = COUNTROWS(FC_Ventas)
		formatString: #,0
		displayFolder: 03 Conteos
		lineageTag: 5b3e92d6-cb90-4726-acbf-b0beda3f9c2d

	/// Facturas y notas de crédito distintas emitidas en el período.
	measure 'Documentos de venta' = DISTINCTCOUNT(FC_Ventas[documento_id])
		formatString: #,0
		displayFolder: 03 Conteos
		lineageTag: a25a8426-ee63-4a68-87a4-e1cfddcaf16f

	/// Clientes distintos con movimiento neto en el período.
	measure 'Clientes con venta' = CALCULATE(DISTINCTCOUNT(FC_Ventas[cliente_clave]), KEEPFILTERS(FC_Ventas[monto_sin_impuesto] <> 0))
		formatString: #,0
		displayFolder: 03 Conteos
		lineageTag: 9c135a37-d951-444a-941e-bb191af4c7c1

	/// Artículos distintos con movimiento: la parte del catálogo que de verdad rota.
	measure 'Productos vendidos' = DISTINCTCOUNT(FC_Ventas[producto_clave])
		formatString: #,0
		displayFolder: 03 Conteos
		lineageTag: 85eb447a-98ec-4c23-b798-480ed6c2753f

	/// Venta media por documento. Subirlo suele costar menos que conseguir un cliente nuevo.
	measure 'Ticket promedio' = DIVIDE([Ventas netas], [Documentos de venta])
		formatString: "Q" #,0
		displayFolder: 04 Promedios
		lineageTag: d096d611-ba54-4cb0-9a62-c5afba12dd60

	/// Precio medio realmente cobrado. Solo significa algo con UN producto filtrado: mezclado entre artículos distintos no dice nada.
	measure 'Precio promedio unidad' = DIVIDE([Ventas netas], [Unidades vendidas])
		formatString: "Q" #,0.00
		displayFolder: 04 Promedios
		lineageTag: d44eea21-48d7-49f1-8b6f-a3c1825d28dd

	/// Tamaño medio de la línea de documento.
	measure 'Venta promedio por línea' = DIVIDE([Ventas netas], [Líneas de venta])
		formatString: "Q" #,0
		displayFolder: 04 Promedios
		lineageTag: daa929ca-cfc5-4a35-a30b-0812627eabea

	/// Promedio sobre los días que SÍ hubo venta: no diluye con domingos y feriados.
	measure 'Venta promedio diaria' = DIVIDE([Ventas netas], CALCULATE(DISTINCTCOUNT(DM_Calendario[fecha]), FC_Ventas))
		formatString: "Q" #,0
		displayFolder: 04 Promedios
		lineageTag: d753df92-a5c5-4eb3-8ef5-1f3e8711c388

	/// Facturación media por cliente activo en el período.
	measure 'Venta promedio por cliente' = DIVIDE([Ventas netas], [Clientes con venta])
		formatString: "Q" #,0
		displayFolder: 04 Promedios
		lineageTag: a5e674e6-565d-4440-a357-97bdb5878d0b

	/// Costo registrado en la línea al momento de facturar. Solo existe en SAP B1; en Odoo la línea no lo trae y la medida sale en cero.
	measure 'Costo de ventas' = SUM(FC_Ventas[costo])
		formatString: "Q" #,0
		displayFolder: 05 Rentabilidad
		lineageTag: 091fbaba-dbec-4aa1-a29c-31ad463ac7e2

	/// Venta neta menos costo, calculado línea a línea. Cero en Odoo por la misma razón que el costo.
	measure 'Margen bruto' = SUM(FC_Ventas[margen])
		formatString: "Q" #,0
		displayFolder: 05 Rentabilidad
		lineageTag: 3824e396-3c31-4caf-8101-d3e4c2363d47

	/// Rentabilidad sobre la venta, grupo incluido. Para el margen del mercado real usar '% Margen terceros'.
	measure '% Margen' = DIVIDE([Margen bruto], [Ventas netas])
		formatString: 0.0%
		displayFolder: 05 Rentabilidad
		lineageTag: 155e9033-15c7-46fe-bb52-59eff4fefed7

	/// El margen de mercado. Incluir la venta al grupo, que no compite por precio, infla el indicador.
	measure '% Margen terceros' = DIVIDE(CALCULATE([Margen bruto], DM_Cliente[es_intercompania] = FALSE), [Ventas a terceros])
		formatString: 0.0%
		displayFolder: 05 Rentabilidad
		lineageTag: bc658553-3726-4211-8113-6f8410519e38

	/// Mismo período del mes anterior (respeta el filtro de fechas del visual).
	measure 'Ventas mes anterior' = CALCULATE([Ventas netas], DATEADD(DM_Calendario[fecha], -1, MONTH))
		formatString: "Q" #,0
		displayFolder: 06 Comparativos
		lineageTag: 42bc250e-de9d-463e-a875-6a341138a96e

	/// El mismo período del año pasado. En un negocio con temporada dice más que la comparación contra el mes anterior.
	measure 'Ventas año anterior' = CALCULATE([Ventas netas], DATEADD(DM_Calendario[fecha], -1, YEAR))
		formatString: "Q" #,0
		displayFolder: 06 Comparativos
		lineageTag: 90fe2204-c2a2-41e8-b7eb-e0cc94f1f4f3

	/// Acumulado del mes en curso hasta el último día con datos del filtro.
	measure 'Ventas acumuladas mes' = TOTALMTD([Ventas netas], DM_Calendario[fecha])
		formatString: "Q" #,0
		displayFolder: 06 Comparativos
		lineageTag: dcc02a8d-db3c-4180-abf3-1e45a686d730

	/// Acumulado desde el inicio del trimestre hasta la fecha del contexto.
	measure 'Ventas acumuladas trimestre' = TOTALQTD([Ventas netas], DM_Calendario[fecha])
		formatString: "Q" #,0
		displayFolder: 06 Comparativos
		lineageTag: 1f1a33fd-0227-4784-bf18-82b7ca947569

	/// Acumulado desde el 1 de enero: la cifra con la que se mide el ejercicio.
	measure 'Ventas acumuladas año' = TOTALYTD([Ventas netas], DM_Calendario[fecha])
		formatString: "Q" #,0
		displayFolder: 06 Comparativos
		lineageTag: 8a3883da-0c3c-410c-8331-80e049d69a7d

	/// El acumulado del año PASADO al mismo corte: el comparable correcto del YTD.
	measure 'Ventas acumuladas año anterior' = CALCULATE(TOTALYTD([Ventas netas], DM_Calendario[fecha]), DATEADD(DM_Calendario[fecha], -1, YEAR))
		formatString: "Q" #,0
		displayFolder: 06 Comparativos
		lineageTag: 20f23f5d-b3ec-4af2-96f5-2ae66183847d

	/// Crecimiento contra el mes previo. Cuidado con la estacionalidad: un mes flojo puede ser normal para la época.
	measure 'Variación vs mes anterior' = DIVIDE([Ventas netas] - [Ventas mes anterior], [Ventas mes anterior])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 06 Comparativos
		lineageTag: 274559ce-d4b1-4b56-9c4b-f06fa04065e1

	/// Crecimiento contra el mismo período del año pasado, ya libre del efecto estacional.
	measure 'Variación vs año anterior' = DIVIDE([Ventas netas] - [Ventas año anterior], [Ventas año anterior])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 06 Comparativos
		lineageTag: 1b01ca8d-30ac-45c8-82f6-365598446604

	/// Cómo va el ejercicio completo contra el anterior. Es la que se lleva a una junta.
	measure 'Variación acumulada vs año anterior' = DIVIDE([Ventas acumuladas año] - [Ventas acumuladas año anterior], [Ventas acumuladas año anterior])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 06 Comparativos
		lineageTag: 1fa43ed4-c56c-4702-ae36-1697a493d2b1

	/// Fin de la ventana móvil: el corte del contexto, pero nunca más allá del último día CON DATO. El calendario llega a 2032 para cubrir vencimientos y series proyectadas del ERP, así que anclar en MAX(Calendario[fecha]) dejaba toda ventana móvil apuntando a un futuro vacío y devolviendo BLANK. Con un período filtrado el ancla es el fin del período, que es lo correcto.
	measure '_Fecha ancla móvil' = VAR fin = MAX(DM_Calendario[fecha]) VAR ultimo_dato = CALCULATE(MAX(FC_Ventas[fecha_documento]), ALL(DM_Calendario)) RETURN MIN(fin, ultimo_dato)
		formatString: yyyy-mm-dd
		isHidden
		displayFolder: _Auxiliar
		lineageTag: a49addd1-e2ec-4ea8-aceb-6bf9e0e46fb4

	/// Promedio MENSUAL de los últimos 3 meses: alisa el diente de sierra de la facturación. (Iterar días con DATESINPERIOD daba un promedio diario disfrazado de mensual.)
	measure 'Media móvil 3 meses' = CALCULATE(AVERAGEX(VALUES(DM_Calendario[anio_mes]), [Ventas netas]), DATESINPERIOD(DM_Calendario[fecha], [_Fecha ancla móvil], -3, MONTH))
		formatString: "Q" #,0
		displayFolder: 06 Comparativos
		lineageTag: a5021f07-0c83-42fc-a709-8a926af02779

	/// Año móvil: los últimos 12 meses completos desde el corte. Quita la estacionalidad del calendario.
	measure 'Ventas 12 meses móviles' = CALCULATE([Ventas netas], DATESINPERIOD(DM_Calendario[fecha], [_Fecha ancla móvil], -12, MONTH))
		formatString: "Q" #,0
		displayFolder: 06 Comparativos
		lineageTag: 3b747669-4e95-417c-8dc7-94bb45048584

	/// Venta de líneas sin artículo (servicios, fletes, gastos) — el miembro SERVICIO de Producto.
	measure 'Ventas de servicios' = CALCULATE([Ventas netas], KEEPFILTERS(DM_Producto[producto_codigo] = "SERVICIO"))
		formatString: "Q" #,0
		displayFolder: 01 Importes
		lineageTag: 7f50dddb-9021-4e0e-8a0e-645e2da0aadc

	/// Posición del cliente ordenado por venta a terceros, dentro del filtro vigente.
	measure 'Ranking de cliente por venta' = RANKX(ALLSELECTED(DM_Cliente), [Ventas a terceros])
		formatString: #,0
		displayFolder: 07 Pareto
		lineageTag: 191d8fbd-3e3f-4646-8c7c-e84ad5a21f4f

	/// Curva de Pareto: % de la venta a terceros que acumulan este cliente y los mayores que él. La venta por cliente se materializa UNA vez en `base`: la versión anterior reevaluaba la medida dentro del FILTER, una vez por cliente y por cliente, lo que es cuadrático y se nota con miles de clientes.
	measure '% acumulado de venta clientes' = VAR base = ADDCOLUMNS(ALLSELECTED(DM_Cliente), "@v", [Ventas a terceros]) VAR actual = [Ventas a terceros] VAR total = SUMX(base, [@v]) VAR acum = SUMX(FILTER(base, [@v] >= actual), [@v]) RETURN DIVIDE(acum, total)
		formatString: 0.0%
		displayFolder: 07 Pareto
		lineageTag: 1c1193ff-0483-4081-9a6a-7be22bb3f617

	/// Posición del producto por venta neta dentro del filtro vigente.
	measure 'Ranking de producto por venta' = RANKX(ALLSELECTED(DM_Producto), [Ventas netas])
		formatString: #,0
		displayFolder: 07 Pareto
		lineageTag: 185665fd-408b-43e2-9ac2-dba6a174b06f

	/// Curva de Pareto de productos sobre la venta neta. Misma materialización en `base` que la curva de clientes.
	measure '% acumulado de venta productos' = VAR base = ADDCOLUMNS(ALLSELECTED(DM_Producto), "@v", [Ventas netas]) VAR actual = [Ventas netas] VAR total = SUMX(base, [@v]) VAR acum = SUMX(FILTER(base, [@v] >= actual), [@v]) RETURN DIVIDE(acum, total)
		formatString: 0.0%
		displayFolder: 07 Pareto
		lineageTag: e3b198b7-e5aa-4301-90ed-f0127eb99627

	/// Peso de los 10 mayores clientes: la medida de riesgo comercial. Si perder un cliente hunde el año, se sabe aquí.
	measure '% Venta en top 10 clientes' = DIVIDE(CALCULATE([Ventas a terceros], TOPN(10, ALLSELECTED(DM_Cliente), [Ventas a terceros])), CALCULATE([Ventas a terceros], ALLSELECTED(DM_Cliente)))
		formatString: 0.0%
		displayFolder: 07 Pareto
		lineageTag: 1fa85994-ae7c-497e-a3da-da60cec95c76

	/// Amplitud de catálogo: cuántos productos distintos se le venden al cliente promedio. Subirla es la venta cruzada.
	measure 'Productos por cliente' = DIVIDE([Productos vendidos], [Clientes con venta])
		formatString: #,0.0
		displayFolder: 04 Promedios
		lineageTag: 6e29fe24-0f5a-44ec-b21b-3b029569a938

	/// Venta facturada por DEBAJO del costo registrado en la línea. Es fuga de margen pura, no una promoción: nadie la autorizó.
	measure 'Ventas bajo costo' = CALCULATE([Ventas netas], KEEPFILTERS(FC_Ventas[margen] < 0))
		formatString: "Q" #,0
		displayFolder: 08 Fugas de margen
		lineageTag: 89e22b2f-c3e9-4d34-bf5a-df75941bd250

	/// Cuántas líneas se facturaron por debajo del costo registrado.
	measure 'Líneas bajo costo' = CALCULATE(COUNTROWS(FC_Ventas), KEEPFILTERS(FC_Ventas[margen] < 0))
		formatString: #,0
		displayFolder: 08 Fugas de margen
		lineageTag: be92ed6f-9f92-4db4-a125-e31dc2f913bf

	/// Cuánto margen se dejó en la mesa, en positivo para poder sumarlo y priorizarlo.
	measure 'Margen perdido bajo costo' = -CALCULATE(SUM(FC_Ventas[margen]), KEEPFILTERS(FC_Ventas[margen] < 0))
		formatString: "Q" #,0
		displayFolder: 08 Fugas de margen
		lineageTag: fa9f6157-3b0a-47a8-a135-f320dad5b1f1

	/// Qué porción de la venta se hizo perdiendo margen. Cualquier cifra de dos dígitos aquí merece una revisión de política de precios.
	measure '% Ventas bajo costo' = DIVIDE([Ventas bajo costo], [Ventas netas])
		formatString: 0.0%
		displayFolder: 08 Fugas de margen
		lineageTag: 102d8a9d-9edf-40fc-b9c8-8d51d59b508f

	/// Artículos distintos que se vendieron perdiendo margen: la lista corta por donde empezar.
	measure 'Productos vendidos bajo costo' = CALCULATE(DISTINCTCOUNT(FC_Ventas[producto_clave]), KEEPFILTERS(FC_Ventas[margen] < 0))
		formatString: #,0
		displayFolder: 08 Fugas de margen
		lineageTag: 5d1da0c2-8849-4a89-a22c-96f668c2d3e4

	/// Clientes a los que se les facturó por debajo del costo. Suele concentrarse en pocos y negociados.
	measure 'Clientes con venta bajo costo' = CALCULATE(DISTINCTCOUNT(FC_Ventas[cliente_clave]), KEEPFILTERS(FC_Ventas[margen] < 0))
		formatString: #,0
		displayFolder: 08 Fugas de margen
		lineageTag: d7c021bd-31d6-4d22-871f-2fc533d6564e

	/// Precio promedio del mismo período del año pasado, base del desglose precio/volumen.
	measure 'Precio promedio año anterior' = CALCULATE([Precio promedio unidad], SAMEPERIODLASTYEAR(DM_Calendario[fecha]))
		formatString: "Q" #,0.00
		displayFolder: 09 Precio y volumen
		lineageTag: cbcdfa17-5004-4886-953e-1895b0a3c474

	/// Volumen del mismo período del año pasado, base del desglose precio/volumen.
	measure 'Unidades año anterior' = CALCULATE([Unidades vendidas], SAMEPERIODLASTYEAR(DM_Calendario[fecha]))
		formatString: #,0
		displayFolder: 09 Precio y volumen
		lineageTag: 61ab198b-bdc9-4b0a-a97d-a1bdd2ff5378

	/// Cuánto de la variación anual viene de haber vendido MÁS CARO: diferencia de precio aplicada al volumen actual.
	measure 'Efecto precio' = ([Precio promedio unidad] - [Precio promedio año anterior]) * [Unidades vendidas]
		formatString: "Q" #,0
		displayFolder: 09 Precio y volumen
		lineageTag: b308de34-da73-4189-80bf-0d3e1b023644

	/// Cuánto viene de haber vendido MÁS UNIDADES: diferencia de volumen valorada al precio del año pasado.
	measure 'Efecto volumen' = ([Unidades vendidas] - [Unidades año anterior]) * [Precio promedio año anterior]
		formatString: "Q" #,0
		displayFolder: 09 Precio y volumen
		lineageTag: 63c22574-72d0-45d6-9341-181688c8ed3f

	/// El resto: cambio en la MEZCLA de productos y clientes. Los tres efectos suman exactamente la variación anual.
	measure 'Efecto mezcla' = [Ventas netas] - [Ventas año anterior] - [Efecto precio] - [Efecto volumen]
		formatString: "Q" #,0
		displayFolder: 09 Precio y volumen
		lineageTag: 863cda55-8007-490c-ad2e-6d3f0949180d

	/// Título de la página 01.
	measure 'Título de Dirección' = "01 · Dirección · " & [Período activo]
		displayFolder: _Narrativa
		lineageTag: 5f91a665-5147-4002-b805-85fdb8cd4283

	/// Subtítulo del visual de ejercicio (página 01). Habla de la serie del año en curso, no de un comparativo: el modelo arranca en 2026 y no hay año anterior que comparar (decisión de Edwin, 2026-08-08). Señala el mejor mes, que es la referencia contra la que el resto se lee.
	measure 'Subtítulo del ejercicio' = VAR t = [Ventas netas] VAR meses = VALUES(DM_Calendario[anio_mes]) VAR n = COUNTROWS(meses) VAR mejor = MAXX(meses, CALCULATE([Ventas netas])) VAR etiq = CONCATENATEX(TOPN(1, meses, CALCULATE([Ventas netas]), DESC), CALCULATE(MAX(DM_Calendario[mes_anio_etiqueta])), ", ") RETURN SWITCH(TRUE(), ISBLANK(t) || t = 0, "Sin venta en el período seleccionado", n <= 1, (IF(t < 0, "-", "") & "Q" & SWITCH(TRUE(), ABS(t) >= 1000000, FORMAT(ABS(t) / 1000000, "#,##0.0") & "M", ABS(t) >= 10000, FORMAT(ABS(t) / 1000, "#,##0") & "K", FORMAT(ABS(t), "#,##0"))) & " en el período", (IF(t < 0, "-", "") & "Q" & SWITCH(TRUE(), ABS(t) >= 1000000, FORMAT(ABS(t) / 1000000, "#,##0.0") & "M", ABS(t) >= 10000, FORMAT(ABS(t) / 1000, "#,##0") & "K", FORMAT(ABS(t), "#,##0"))) & " en el período · mejor mes: " & etiq & " con " & (IF(mejor < 0, "-", "") & "Q" & SWITCH(TRUE(), ABS(mejor) >= 1000000, FORMAT(ABS(mejor) / 1000000, "#,##0.0") & "M", ABS(mejor) >= 10000, FORMAT(ABS(mejor) / 1000, "#,##0") & "K", FORMAT(ABS(mejor), "#,##0"))))
		displayFolder: _Narrativa
		lineageTag: 0ce0749e-9518-4a22-9eff-3340823ee3ac

	/// Subtítulo de la tabla de alertas (página 01). Cuenta focos, NO suma sus importes: venta en riesgo, margen perdido, saldo vencido y backlog son cifras de distinta naturaleza y sumarlas produce un total que nadie puede reconstruir.
	measure 'Subtítulo de focos de la semana' = VAR n = IF([Venta anual en riesgo por quiebre] > 0, 1, 0) + IF([Margen perdido bajo costo] > 0, 1, 0) + IF([Vencido terceros hoy] > 0, 1, 0) + IF([Backlog vencido] > 0, 1, 0) + IF([Flujo neto próximas 4 semanas] < 0, 1, 0) RETURN IF(n = 0, "Ningún foco exige acción esta semana", FORMAT(n, "0") & IF(n = 1, " foco exige acción", " focos exigen acción") & " · cada uno se lee en su propia unidad, no se suman entre sí")
		displayFolder: _Narrativa
		lineageTag: 8690316c-cac1-4ada-b69e-b0caf552b1cb

	/// Subtítulo del aporte por sociedad (página 01). Cuánto concentra la mayor: en un grupo de diez sociedades, la dependencia de una sola es la lectura que no da el ERP.
	measure 'Subtítulo de aporte por sociedad' = VAR t = [Ventas a terceros] VAR soc = FILTER(VALUES(DM_Empresa[nombre]), [Ventas a terceros] <> 0) VAR n = COUNTROWS(soc) VAR mayor = MAXX(soc, [Ventas a terceros]) RETURN IF(ISBLANK(t) || t = 0, "Sin venta a terceros en el período", FORMAT(n, "0") & IF(n = 1, " sociedad con venta a terceros · ", " sociedades con venta a terceros · ") & "la mayor concentra " & FORMAT(DIVIDE(mayor, t), "0.0%"))
		displayFolder: _Narrativa
		lineageTag: dee0db43-3b2f-4fd7-b77a-9135ea1f8523

	/// Texto del foco de venta bajo costo (página 01). Margen regalado en el período filtrado: líneas facturadas por debajo del costo del artículo.
	measure 'Alerta de venta bajo costo' = VAR m = [Margen perdido bajo costo] VAR p = [% Ventas bajo costo] RETURN IF(ISBLANK(m) || m = 0, "Sin venta bajo costo en el período", (IF(m < 0, "-", "") & "Q" & SWITCH(TRUE(), ABS(m) >= 1000000, FORMAT(ABS(m) / 1000000, "#,##0.0") & "M", ABS(m) >= 10000, FORMAT(ABS(m) / 1000, "#,##0") & "K", FORMAT(ABS(m), "#,##0"))) & " de margen perdido vendiendo bajo costo · " & FORMAT(p, "0.0%") & " de la venta")
		displayFolder: _Narrativa
		lineageTag: 1a01b045-8e26-4cc9-9c61-d4520e3505f0

