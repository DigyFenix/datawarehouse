table 'FC_Resultados contables'
	lineageTag: 69a4e570-3bad-46f8-a003-cc93697fc10d

	/// Gasto operativo del MAYOR (cuentas de gasto), con jerarquía de cuenta y centro de costo.
	measure 'Gasto operativo' = CALCULATE(SUM('FC_Resultados contables'[monto_resultado]), KEEPFILTERS('FC_Resultados contables'[naturaleza] = "gasto"))
		formatString: "Q" #,0
		displayFolder: 01 P&L
		lineageTag: cbf3f3a8-1358-402e-838c-8fa2bb0a12e4

	/// Costo del período según el mayor. Es la cifra contable, no el costo de línea de la factura.
	measure 'Costo (contable)' = CALCULATE(SUM('FC_Resultados contables'[monto_resultado]), KEEPFILTERS('FC_Resultados contables'[naturaleza] = "costo"))
		formatString: "Q" #,0
		displayFolder: 01 P&L
		lineageTag: d35565ad-0544-4f66-9729-c35f8bcea0cc

	/// Ingresos según el LIBRO MAYOR. Cuadra al centavo con Ventas Netas cuando todo ingreso pasa por factura.
	measure 'Ingresos contables' = CALCULATE(SUM('FC_Resultados contables'[monto_resultado]), KEEPFILTERS('FC_Resultados contables'[naturaleza] = "ingreso"))
		formatString: "Q" #,0
		displayFolder: 01 P&L
		lineageTag: 7a851963-10af-4b98-a96f-2c8a6f21540e

	/// Ingresos − costos − gastos, todo desde el mayor: el resultado operativo contable.
	measure 'Resultado contable' = [Ingresos contables] - [Costo (contable)] - [Gasto operativo]
		formatString: "Q" #,0
		displayFolder: 01 P&L
		lineageTag: 11583eb4-2fb2-4e65-863a-c631691eeed3

	/// Número de partidas del mayor en el filtro vigente.
	measure 'Partidas contables' = COUNTROWS('FC_Resultados contables')
		formatString: #,0
		displayFolder: 01 P&L
		lineageTag: 3dab0cc4-b1ef-4742-b710-181dbcd362e4

	/// Margen operativo real, el del mayor contable — no el margen de línea de factura. Es el número que mira un banco.
	measure '% Margen operativo' = DIVIDE([Resultado contable], [Ingresos contables])
		formatString: 0.0%
		displayFolder: 02 Estructura
		lineageTag: 2a4b6ec8-a226-4aba-9984-74c9bc496ae3

	/// Cuánto del ingreso se come la estructura. Subir la venta con este porcentaje subiendo no mejora nada.
	measure '% Gasto sobre ingreso' = DIVIDE([Gasto operativo], [Ingresos contables])
		formatString: 0.0%
		displayFolder: 02 Estructura
		lineageTag: 9f280031-961a-4d1d-a74d-4f2075f0b7ea

	/// Qué parte del ingreso se va en costo directo.
	measure '% Costo sobre ingreso' = DIVIDE([Costo (contable)], [Ingresos contables])
		formatString: 0.0%
		displayFolder: 02 Estructura
		lineageTag: 37933ae6-1671-41dd-88e8-4b7c77b22317

	/// Peso del rubro de gasto más grande dentro del total. Filtrar por nivel de la jerarquía contable para leerlo.
	measure '% Gasto en el mayor rubro' = DIVIDE(MAXX(ALLSELECTED('DM_Cuenta contable'), [Gasto operativo]), CALCULATE([Gasto operativo], ALLSELECTED('DM_Cuenta contable')))
		formatString: 0.0%
		displayFolder: 02 Estructura
		lineageTag: e72c2de8-69a8-4468-8237-ac5310311897

	/// Estructura media mensual: el piso que hay que cubrir cada mes.
	measure 'Gasto promedio mensual' = DIVIDE([Gasto operativo], DISTINCTCOUNT(DM_Calendario[anio_mes]))
		formatString: "Q" #,0
		displayFolder: 02 Estructura
		lineageTag: 406e17ac-bf12-4e22-963a-6eedd0ccef1b

	/// Gasto del mes previo.
	measure 'Gasto mes anterior' = CALCULATE([Gasto operativo], DATEADD(DM_Calendario[fecha], -1, MONTH))
		formatString: "Q" #,0
		displayFolder: 03 Comparativos
		lineageTag: 2e4cf262-ee7b-4dc1-9300-767c27212ef7

	/// Gasto del mismo período del año pasado.
	measure 'Gasto año anterior' = CALCULATE([Gasto operativo], SAMEPERIODLASTYEAR(DM_Calendario[fecha]))
		formatString: "Q" #,0
		displayFolder: 03 Comparativos
		lineageTag: a4f76ef3-232c-469d-9319-f271cf810211

	/// Gasto acumulado del ejercicio.
	measure 'Gasto acumulado año' = TOTALYTD([Gasto operativo], DM_Calendario[fecha])
		formatString: "Q" #,0
		displayFolder: 03 Comparativos
		lineageTag: d12a4cb6-e6a1-4888-852a-7f4e04f61196

	/// Cómo crece la estructura. Que crezca más rápido que el ingreso es la señal más temprana de deterioro.
	measure 'Variación de gasto vs año anterior' = DIVIDE([Gasto operativo] - [Gasto año anterior], [Gasto año anterior])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 03 Comparativos
		lineageTag: 8b1bf7a1-6e99-44ac-9530-22467316cc6f

	/// Ingreso contable acumulado del ejercicio.
	measure 'Ingresos acumulados año' = TOTALYTD([Ingresos contables], DM_Calendario[fecha])
		formatString: "Q" #,0
		displayFolder: 03 Comparativos
		lineageTag: 29c4c6c6-dc45-4cf7-9e8f-8746e8f7fa2d

	/// Resultado del ejercicio a la fecha, antes de ajustes de cierre.
	measure 'Resultado acumulado año' = TOTALYTD([Resultado contable], DM_Calendario[fecha])
		formatString: "Q" #,0
		displayFolder: 03 Comparativos
		lineageTag: 58745978-88a8-4fb5-8c6b-e57657e5313f

	/// Resultado del mes previo.
	measure 'Resultado mes anterior' = CALCULATE([Resultado contable], DATEADD(DM_Calendario[fecha], -1, MONTH))
		formatString: "Q" #,0
		displayFolder: 03 Comparativos
		lineageTag: 7c786112-dfe7-4b66-9df0-dbba93893b96

	/// Diferencia entre lo que dice contabilidad y lo que dice facturación. Debería ser cerca de cero; si no, hay anticipos, ajustes o cuentas de ingreso mal clasificadas. Es un control, no un KPI: cuando se despega, hay que ir a buscar por qué.
	measure 'Brecha contable vs facturado' = [Ingresos contables] - [Ventas netas]
		formatString: "Q" #,0
		displayFolder: 04 Control
		lineageTag: b026d07e-b8d5-40e6-8b1a-d5df39a74624

	/// La brecha contra facturación en porcentaje. Debería rondar cero; cuando se despega hay que buscar anticipos, ajustes o cuentas mal clasificadas.
	measure '% Brecha contable' = DIVIDE([Brecha contable vs facturado], [Ventas netas])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 04 Control
		lineageTag: 3894aa49-a629-4f12-b942-659042122a61

