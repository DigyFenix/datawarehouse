model Model
	culture: es-GT
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: es-GT
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Servidor","BaseDatos","DM_Calendario","DM_Cliente","DM_Proveedor","DM_Socio de negocio","DM_Dirección de entrega","DM_Producto","DM_Vendedor","DM_Empresa","DM_Bodega","DM_Moneda","DM_Cuenta contable","DM_Centro de costo","DM_Tipo de documento","DM_Antigüedad","DM_Clasificación ABC","DM_Clasificación ABC Proveedor","DM_Clasificación RFM","DM_Comportamiento de pago","DM_Análisis de producto","DM_Año de clasificación","FC_Ventas","FC_Compras","FC_Cartera por cobrar","FC_Cartera por pagar","FC_Cartera cobrar histórico","FC_Cartera pagar histórico","FC_Pagos recibidos","FC_Pagos efectuados","FC_Inventario","FC_Tipo de cambio","FC_Campos de usuario","FC_Venta diaria","FC_Proyección de caja","FC_Pedidos","FC_Resultados contables","FC_Estado de carga"]

annotation PBI_ProTooling = ["DevMode"]

ref table DM_Calendario
ref table DM_Cliente
ref table DM_Proveedor
ref table 'DM_Socio de negocio'
ref table 'DM_Dirección de entrega'
ref table DM_Producto
ref table DM_Vendedor
ref table DM_Empresa
ref table DM_Bodega
ref table DM_Moneda
ref table 'DM_Cuenta contable'
ref table 'DM_Centro de costo'
ref table 'DM_Tipo de documento'
ref table DM_Antigüedad
ref table 'DM_Clasificación ABC'
ref table 'DM_Clasificación ABC Proveedor'
ref table 'DM_Clasificación RFM'
ref table 'DM_Comportamiento de pago'
ref table 'DM_Análisis de producto'
ref table 'DM_Año de clasificación'
ref table FC_Ventas
ref table FC_Compras
ref table 'FC_Cartera por cobrar'
ref table 'FC_Cartera por pagar'
ref table 'FC_Cartera cobrar histórico'
ref table 'FC_Cartera pagar histórico'
ref table 'FC_Pagos recibidos'
ref table 'FC_Pagos efectuados'
ref table FC_Inventario
ref table 'FC_Tipo de cambio'
ref table 'FC_Campos de usuario'
ref table 'FC_Venta diaria'
ref table 'FC_Proyección de caja'
ref table FC_Pedidos
ref table 'FC_Resultados contables'
ref table 'FC_Estado de carga'
ref table 'MD_Moneda de análisis'
ref table 'MD_Vista de ventas'
ref table 'MD_Vista de cartera'
ref table 'MD_Vista de compras'
ref table 'MD_Vista de liquidez'
ref table 'MD_Vista de inventario'
ref table 'MD_Vista de rentabilidad'

