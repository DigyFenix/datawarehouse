# Secretos y entorno — NUNCA versionar
.env
.env.*
!.env.example
!.env.produccion.example
*.pem
*.key
secrets.*
credentials.*

# Node
node_modules/
dist/
build/
out/
*.log

# Artefactos de compilación incremental (se regeneran; no aportan al diff)
*.tsbuildinfo
.angular/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# dbt
target/
dbt_packages/
logs/

# Docker (datos persistentes locales)
infra/local/data/
infra/local/respaldos/
pgdata/

# Producción: respaldos y datos de Caddy — nunca versionar
infra/produccion/backups/
infra/produccion/caddy_data/

# Power BI: el PBIP (TMDL en texto) SÍ se versiona; lo demás no.
# - .pbix es binario propietario y se regenera abriendo el PBIP en Desktop.
# - localSettings.json guarda rutas locales y credenciales de la máquina.
# - cache.abf es el caché del modelo, lo rehace Desktop.
*.pbix
**/.pbi/localSettings.json
**/.pbi/cache.abf

# Editor / SO
.vscode/
.idea/
.DS_Store
Thumbs.db
