# =====================================================================
# Plantilla de variables de entorno — Tenant Grupo Cresta (Fase 0)
# Copiar a `.env` y completar. El `.env` NUNCA se versiona (.gitignore).
# NO poner secretos reales en este archivo de ejemplo.
# =====================================================================

# --- Postgres (plano de datos, medallion + metadata) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cresta_dw
POSTGRES_USER=cresta_admin
POSTGRES_PASSWORD=changeme

# --- pgAdmin (opcional, perfil "tools") ---
PGADMIN_EMAIL=admin@grupocresta.local
PGADMIN_PORT=5050
PGADMIN_PASSWORD=changeme

# --- SAP Business One / HANA (extracción read-only) ---
# Una sola instancia HANA; cada sociedad es un schema/BD distinto (ver
# organizaciones/grupocresta/config/empresas.md). La password real va aquí
# en el .env, NUNCA en el repo ni en el metadata-store.
HANA_HOST=
HANA_PORT=30015
HANA_USER=
HANA_PASSWORD=
# Sociedades piloto (Fase 1). Schemas HANA separados por coma.
HANA_SCHEMAS_PILOTO=SBOPROAVISA_,SBOLORETO_

# --- Portal / API (plano de control) ---
API_PORT=3001
WEB_PORT=8080
# Secreto para firmar JWT del portal. Mínimo 16 caracteres. Generar uno fuerte por entorno.
JWT_SECRET=
JWT_EXPIRA_EN=8h
# Admin de arranque: se crea si la tabla de usuarios está vacía. Cambiar la contraseña tras el primer login.
PORTAL_ADMIN_EMAIL=admin@grupocresta.local
PORTAL_ADMIN_PASSWORD=

# --- Agente de IA (Fase 4) ---
ANTHROPIC_API_KEY=
