table 'Clasificación ABC Proveedor'

	column empresa_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: empresa_id

	column proveedor_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: proveedor_clave

	column ranking_historico
		dataType: int64
		summarizeBy: none
		sourceColumn: ranking_historico
		formatString: #,0

	column compra_historico
		dataType: decimal
		summarizeBy: none
		sourceColumn: compra_historico
		formatString: #,0.00

	column lineas_historico
		dataType: int64
		summarizeBy: none
		sourceColumn: lineas_historico
		formatString: #,0

	column participacion_historico
		dataType: decimal
		summarizeBy: none
		sourceColumn: participacion_historico
		formatString: 0.0%

	column participacion_acumulada_historico
		dataType: decimal
		summarizeBy: none
		sourceColumn: participacion_acumulada_historico
		formatString: 0.0%

	column clase_abc_historico
		dataType: string
		summarizeBy: none
		sourceColumn: clase_abc_historico

	column ranking_anio
		dataType: int64
		summarizeBy: none
		sourceColumn: ranking_anio
		formatString: #,0

	column compra_anio
		dataType: decimal
		summarizeBy: none
		sourceColumn: compra_anio
		formatString: #,0.00

	column lineas_anio
		dataType: int64
		summarizeBy: none
		sourceColumn: lineas_anio
		formatString: #,0

	column participacion_anio
		dataType: decimal
		summarizeBy: none
		sourceColumn: participacion_anio
		formatString: 0.0%

	column participacion_acumulada_anio
		dataType: decimal
		summarizeBy: none
		sourceColumn: participacion_acumulada_anio
		formatString: 0.0%

	column clase_abc_anio
		dataType: string
		summarizeBy: none
		sourceColumn: clase_abc_anio

	column clase_abc_anio_nombre
		dataType: string
		summarizeBy: none
		sourceColumn: clase_abc_anio_nombre

	column ultimo_anio_compra
		dataType: int64
		summarizeBy: none
		sourceColumn: ultimo_anio_compra
		formatString: #,0

	column inactivo_en_anio
		dataType: boolean
		summarizeBy: none
		sourceColumn: inactivo_en_anio

	column proceso_transformacion
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: proceso_transformacion

	column version_proceso
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: version_proceso

	/// Cuántos proveedores concentran el 80% de la compra del año: dependencia de suministro.
	measure 'Proveedores A' = CALCULATE(COUNTROWS('Clasificación ABC Proveedor'), 'Clasificación ABC Proveedor'[clase_abc_anio] = "A")
		formatString: #,0
		displayFolder: 01 Conteos

	measure 'Proveedores B' = CALCULATE(COUNTROWS('Clasificación ABC Proveedor'), 'Clasificación ABC Proveedor'[clase_abc_anio] = "B")
		formatString: #,0
		displayFolder: 01 Conteos

	measure 'Proveedores C' = CALCULATE(COUNTROWS('Clasificación ABC Proveedor'), 'Clasificación ABC Proveedor'[clase_abc_anio] = "C")
		formatString: #,0
		displayFolder: 01 Conteos

	measure 'Proveedores sin compra neta' = CALCULATE(COUNTROWS('Clasificación ABC Proveedor'), 'Clasificación ABC Proveedor'[clase_abc_anio] = "S")
		formatString: #,0
		displayFolder: 01 Conteos

	measure 'Proveedores clasificados' = COUNTROWS('Clasificación ABC Proveedor')
		formatString: #,0
		displayFolder: 01 Conteos

	/// Proveedores a los que se les compró algún año anterior y nada en el año en curso.
	measure 'Proveedores inactivos' = CALCULATE(COUNTROWS('Clasificación ABC Proveedor'), 'Clasificación ABC Proveedor'[inactivo_en_anio] = TRUE)
		formatString: #,0
		displayFolder: 01 Conteos

	/// Riesgo de dependencia: si los A concentran el 90% de la compra, perder uno para la operación.
	measure '% Compra en proveedores A' = DIVIDE(CALCULATE(SUM('Clasificación ABC Proveedor'[compra_anio]), 'Clasificación ABC Proveedor'[clase_abc_anio] = "A"), SUM('Clasificación ABC Proveedor'[compra_anio]))
		formatString: 0.0%
		displayFolder: 02 Concentración

	measure 'Compra del año clasificada' = SUM('Clasificación ABC Proveedor'[compra_anio])
		formatString: "Q" #,0
		displayFolder: 02 Concentración

	measure 'Compra promedio proveedor A' = DIVIDE(CALCULATE(SUM('Clasificación ABC Proveedor'[compra_anio]), 'Clasificación ABC Proveedor'[clase_abc_anio] = "A"), [Proveedores A])
		formatString: "Q" #,0
		displayFolder: 02 Concentración

	partition 'Clasificación ABC Proveedor' = m
		mode: import
		source =
				let
				    Origen = PostgreSQL.Database(Servidor, BaseDatos),
				    Tabla = Origen{[Schema="oro",Item="clasificacion_abc_proveedor"]}[Data]
				in
				    Tabla
