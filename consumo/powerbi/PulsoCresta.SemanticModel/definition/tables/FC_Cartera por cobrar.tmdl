table 'FC_Cartera por cobrar'

	column tiempo_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: tiempo_clave

	column tiempo_vencimiento_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: tiempo_vencimiento_clave

	column cliente_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: cliente_clave

	column socio_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: socio_clave

	column organizacion_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: organizacion_clave

	column moneda_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: moneda_clave

	column cuenta_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: cuenta_clave

	column empresa_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: empresa_id

	column partida_id
		dataType: string
		summarizeBy: none
		sourceColumn: partida_id

	column documento_origen
		dataType: string
		summarizeBy: none
		sourceColumn: documento_origen

	column tipo_documento_origen
		dataType: string
		summarizeBy: none
		sourceColumn: tipo_documento_origen

	column origen_partida
		dataType: string
		summarizeBy: none
		sourceColumn: origen_partida

	column fecha_documento
		dataType: dateTime
		summarizeBy: none
		sourceColumn: fecha_documento
		formatString: dd/MM/yyyy

	column fecha_vencimiento
		dataType: dateTime
		summarizeBy: none
		sourceColumn: fecha_vencimiento
		formatString: dd/MM/yyyy

	column fecha_corte
		dataType: dateTime
		summarizeBy: none
		sourceColumn: fecha_corte
		formatString: dd/MM/yyyy

	column monto_original
		dataType: decimal
		summarizeBy: none
		sourceColumn: monto_original
		formatString: #,0.00

	column monto_original_doc
		dataType: decimal
		summarizeBy: none
		sourceColumn: monto_original_doc
		formatString: #,0.00

	column saldo_pendiente
		dataType: decimal
		summarizeBy: none
		sourceColumn: saldo_pendiente
		formatString: #,0.00

	column saldo_pendiente_doc
		dataType: decimal
		summarizeBy: none
		sourceColumn: saldo_pendiente_doc
		formatString: #,0.00

	column dias_vencido
		dataType: int64
		summarizeBy: none
		sourceColumn: dias_vencido
		formatString: #,0

	column rango_aging
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: rango_aging

	column rango_aging_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: rango_aging_clave

	column proceso_transformacion
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: proceso_transformacion

	column version_proceso
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: version_proceso

	/// Saldo del MAYOR CONTABLE, no del documento, en MONEDA DE PRESENTACIÓN (foto convertida a la tasa vigente).
	measure 'Saldo por cobrar' = SUM('FC_Cartera por cobrar'[saldo_pendiente])
		formatString: "Q" #,0
		displayFolder: 01 Saldo

	measure 'Saldo por cobrar terceros' = CALCULATE([Saldo por cobrar], DM_Cliente[es_intercompania] = FALSE)
		formatString: "Q" #,0
		displayFolder: 01 Saldo

	/// Saldo entre empresas del propio grupo. Leerlo junto al de terceros hace parecer una crisis de cobranza que no existe.
	measure 'Saldo por cobrar grupo' = CALCULATE([Saldo por cobrar], DM_Cliente[es_intercompania] = TRUE)
		formatString: "Q" #,0
		displayFolder: 01 Saldo

	measure 'Partidas por cobrar' = COUNTROWS('FC_Cartera por cobrar')
		formatString: #,0
		displayFolder: 02 Conteos

	measure 'Clientes con saldo' = DISTINCTCOUNT('FC_Cartera por cobrar'[cliente_clave])
		formatString: #,0
		displayFolder: 02 Conteos

	measure 'Saldo promedio por cliente' = DIVIDE([Saldo por cobrar], [Clientes con saldo])
		formatString: "Q" #,0
		displayFolder: 02 Conteos

	measure 'Saldo corriente' = CALCULATE([Saldo por cobrar], KEEPFILTERS('DM_Antigüedad'[es_vencido] = FALSE))
		formatString: "Q" #,0
		displayFolder: 03 Antigüedad

	measure 'Saldo vencido' = CALCULATE([Saldo por cobrar], KEEPFILTERS('DM_Antigüedad'[es_vencido] = TRUE))
		formatString: "Q" #,0
		displayFolder: 03 Antigüedad

	/// La mora que de verdad hay que cobrar: vencida y fuera del grupo.
	measure 'Saldo vencido terceros' = CALCULATE([Saldo por cobrar], KEEPFILTERS('DM_Antigüedad'[es_vencido] = TRUE), DM_Cliente[es_intercompania] = FALSE)
		formatString: "Q" #,0
		displayFolder: 03 Antigüedad

	measure '% Vencido' = DIVIDE([Saldo vencido], [Saldo por cobrar])
		formatString: 0.0%
		displayFolder: 03 Antigüedad

	measure '% Vencido terceros' = DIVIDE([Saldo vencido terceros], [Saldo por cobrar terceros])
		formatString: 0.0%
		displayFolder: 03 Antigüedad

	measure 'Vencido 1 a 30' = CALCULATE([Saldo por cobrar], KEEPFILTERS('DM_Antigüedad'[rango_aging] = "1-30"))
		formatString: "Q" #,0
		displayFolder: 03 Antigüedad

	measure 'Vencido 31 a 60' = CALCULATE([Saldo por cobrar], KEEPFILTERS('DM_Antigüedad'[rango_aging] = "31-60"))
		formatString: "Q" #,0
		displayFolder: 03 Antigüedad

	measure 'Vencido 61 a 90' = CALCULATE([Saldo por cobrar], KEEPFILTERS('DM_Antigüedad'[rango_aging] = "61-90"))
		formatString: "Q" #,0
		displayFolder: 03 Antigüedad

	measure 'Vencido más de 90' = CALCULATE([Saldo por cobrar], KEEPFILTERS('DM_Antigüedad'[rango_aging] = "+90"))
		formatString: "Q" #,0
		displayFolder: 03 Antigüedad

	/// Riesgo alto: lo que pasó de 90 días pesa distinto en una provisión que lo que apenas venció.
	measure '% Crítico más de 90' = DIVIDE([Vencido más de 90], [Saldo por cobrar])
		formatString: 0.0%
		displayFolder: 03 Antigüedad

	/// Días vencidos promedio ponderados por saldo: un promedio simple deja que una partida chica de 400 días arruine el indicador.
	measure 'Días vencido promedio' = DIVIDE(SUMX('FC_Cartera por cobrar', 'FC_Cartera por cobrar'[saldo_pendiente] * 'FC_Cartera por cobrar'[dias_vencido]), [Saldo por cobrar])
		formatString: #,0.0
		displayFolder: 04 Riesgo

	/// Días de venta a terceros pendientes de cobro. Mezclar el saldo del grupo lo triplica.
	measure 'Días de cartera terceros' = DIVIDE([Saldo por cobrar terceros], DIVIDE([Ventas a terceros], CALCULATE(DISTINCTCOUNT(DM_Calendario[fecha]), FC_Ventas)))
		formatString: #,0.0
		displayFolder: 04 Riesgo

	/// Foto de HOY: ignora el filtro de fechas de la página. El saldo es una foto, no un flujo — recortarlo al trimestre ocultaría las facturas viejas abiertas.
	measure 'Por cobrar terceros hoy' = CALCULATE([Saldo por cobrar terceros], REMOVEFILTERS(DM_Calendario))
		formatString: "Q" #,0
		displayFolder: 05 Foto de hoy

	measure 'Por cobrar grupo hoy' = CALCULATE([Saldo por cobrar grupo], REMOVEFILTERS(DM_Calendario))
		formatString: "Q" #,0
		displayFolder: 05 Foto de hoy

	measure 'Vencido terceros hoy' = CALCULATE([Saldo vencido terceros], REMOVEFILTERS(DM_Calendario))
		formatString: "Q" #,0
		displayFolder: 05 Foto de hoy

	measure '% Vencido terceros hoy' = DIVIDE([Vencido terceros hoy], [Por cobrar terceros hoy])
		formatString: 0.0%
		displayFolder: 05 Foto de hoy

	/// Veces al año que se cobra la cartera completa. Es el recíproco de los días de cartera, más fácil de comparar entre empresas.
	measure 'Rotación de cartera' = DIVIDE(365, [Días de cartera terceros])
		formatString: #,0.0
		displayFolder: 04 Riesgo

	/// Partidas sin fecha de vencimiento pactada: no son ni corrientes ni vencidas, y suelen ser anticipos o ajustes sin depurar.
	measure 'Saldo sin vencimiento' = CALCULATE([Saldo por cobrar], KEEPFILTERS('DM_Antigüedad'[rango_aging] = "sin_vencimiento"))
		formatString: "Q" #,0
		displayFolder: 03 Antigüedad

	/// Cuánto nos debe el cliente más expuesto. Si un solo deudor concentra la cartera, el riesgo no está diversificado.
	measure 'Exposición mayor deudor' = MAXX(ALLSELECTED(DM_Cliente), [Saldo por cobrar terceros])
		formatString: "Q" #,0
		displayFolder: 06 Concentración

	measure '% Exposición mayor deudor' = DIVIDE([Exposición mayor deudor], CALCULATE([Saldo por cobrar terceros], ALLSELECTED(DM_Cliente)))
		formatString: 0.0%
		displayFolder: 06 Concentración

	measure '% Saldo en top 5 deudores' = DIVIDE(CALCULATE([Saldo por cobrar terceros], TOPN(5, ALLSELECTED(DM_Cliente), [Saldo por cobrar terceros])), CALCULATE([Saldo por cobrar terceros], ALLSELECTED(DM_Cliente)))
		formatString: 0.0%
		displayFolder: 06 Concentración

	partition 'FC_Cartera por cobrar' = m
		mode: import
		source =
				let
				    Origen = PostgreSQL.Database(Servidor, BaseDatos),
				    Tabla = Origen{[Schema="oro",Item="hecho_cartera_cobrar"]}[Data]
				in
				    Tabla
