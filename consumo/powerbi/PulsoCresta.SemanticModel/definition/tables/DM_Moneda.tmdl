table DM_Moneda

	column moneda_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: moneda_clave

	column empresa_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: empresa_id

	column moneda_codigo
		dataType: string
		summarizeBy: none
		sourceColumn: moneda_codigo

	column nombre
		dataType: string
		summarizeBy: none
		sourceColumn: nombre

	column es_local
		dataType: boolean
		summarizeBy: none
		sourceColumn: es_local

	column valido_desde
		dataType: dateTime
		isHidden
		summarizeBy: none
		sourceColumn: valido_desde
		formatString: dd/MM/yyyy

	column valido_hasta
		dataType: dateTime
		isHidden
		summarizeBy: none
		sourceColumn: valido_hasta
		formatString: dd/MM/yyyy

	column es_vigente
		dataType: boolean
		isHidden
		summarizeBy: none
		sourceColumn: es_vigente

	partition DM_Moneda = m
		mode: import
		source =
				let
				    Origen = PostgreSQL.Database(Servidor, BaseDatos),
				    Tabla = Origen{[Schema="oro",Item="dim_moneda"]}[Data]
				in
				    Tabla
