table FC_Compras

	column tiempo_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: tiempo_clave

	column proveedor_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: proveedor_clave

	column socio_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: socio_clave

	column producto_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: producto_clave

	column organizacion_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: organizacion_clave

	column almacen_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: almacen_clave

	column moneda_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: moneda_clave

	column cuenta_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: cuenta_clave

	column centro_costo_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: centro_costo_clave

	column tipo_documento_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: tipo_documento_clave

	column empresa_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: empresa_id

	column documento_id
		dataType: string
		summarizeBy: none
		sourceColumn: documento_id

	column documento_numero
		dataType: string
		summarizeBy: none
		sourceColumn: documento_numero

	column serie_codigo
		dataType: string
		summarizeBy: none
		sourceColumn: serie_codigo

	column tipo_documento_origen
		dataType: string
		summarizeBy: none
		sourceColumn: tipo_documento_origen

	column referencia_externa
		dataType: string
		summarizeBy: none
		sourceColumn: referencia_externa

	column linea_numero
		dataType: int64
		summarizeBy: none
		sourceColumn: linea_numero
		formatString: #,0

	column tipo_documento
		dataType: string
		summarizeBy: none
		sourceColumn: tipo_documento

	column fecha_documento
		dataType: dateTime
		summarizeBy: none
		sourceColumn: fecha_documento
		formatString: dd/MM/yyyy

	column cantidad
		dataType: decimal
		summarizeBy: none
		sourceColumn: cantidad
		formatString: #,0.00

	column monto_sin_impuesto
		dataType: decimal
		summarizeBy: none
		sourceColumn: monto_sin_impuesto
		formatString: #,0.00

	column monto_impuesto
		dataType: decimal
		summarizeBy: none
		sourceColumn: monto_impuesto
		formatString: #,0.00

	column monto_con_impuesto
		dataType: decimal
		summarizeBy: none
		sourceColumn: monto_con_impuesto
		formatString: #,0.00

	column monto_sin_impuesto_doc
		dataType: decimal
		summarizeBy: none
		sourceColumn: monto_sin_impuesto_doc
		formatString: #,0.00

	column monto_impuesto_doc
		dataType: decimal
		summarizeBy: none
		sourceColumn: monto_impuesto_doc
		formatString: #,0.00

	column monto_con_impuesto_doc
		dataType: decimal
		summarizeBy: none
		sourceColumn: monto_con_impuesto_doc
		formatString: #,0.00

	column monto_descuento
		dataType: decimal
		summarizeBy: none
		sourceColumn: monto_descuento
		formatString: #,0.00

	column descuento_pct
		dataType: decimal
		summarizeBy: none
		sourceColumn: descuento_pct
		formatString: 0.0"%"

	column saldo_pendiente
		dataType: decimal
		summarizeBy: none
		sourceColumn: saldo_pendiente
		formatString: #,0.00

	column estado_pago
		dataType: string
		summarizeBy: none
		sourceColumn: estado_pago

	column proceso_transformacion
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: proceso_transformacion

	column version_proceso
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: version_proceso

	/// Compra sin impuestos en MONEDA DE PRESENTACIÓN (consolidable entre sociedades).
	measure 'Compras netas' = SUM(FC_Compras[monto_sin_impuesto])
		formatString: "Q" #,0
		displayFolder: 01 Importes

	measure 'Compras netas con IVA' = SUM(FC_Compras[monto_con_impuesto])
		formatString: "Q" #,0
		displayFolder: 01 Importes

	measure 'Impuesto de compras' = SUM(FC_Compras[monto_impuesto])
		formatString: "Q" #,0
		displayFolder: 01 Importes

	/// Saldo pendiente de pago de las facturas de compra, prorrateado por línea. INFORMATIVO: la cartera oficial sale del mayor.
	measure 'Saldo de facturas de compra' = SUM(FC_Compras[saldo_pendiente])
		formatString: "Q" #,0
		displayFolder: 01 Importes

	measure 'Compras a terceros' = CALCULATE([Compras netas], DM_Proveedor[es_intercompania] = FALSE)
		formatString: "Q" #,0
		displayFolder: 02 Terceros vs grupo

	measure 'Compras al grupo' = CALCULATE([Compras netas], DM_Proveedor[es_intercompania] = TRUE)
		formatString: "Q" #,0
		displayFolder: 02 Terceros vs grupo

	measure '% Compra al grupo' = DIVIDE([Compras al grupo], [Compras netas])
		formatString: 0.0%
		displayFolder: 02 Terceros vs grupo

	measure 'Unidades compradas' = SUM(FC_Compras[cantidad])
		formatString: #,0
		displayFolder: 03 Conteos

	measure 'Líneas de compra' = COUNTROWS(FC_Compras)
		formatString: #,0
		displayFolder: 03 Conteos

	measure 'Documentos de compra' = DISTINCTCOUNT(FC_Compras[documento_id])
		formatString: #,0
		displayFolder: 03 Conteos

	measure 'Proveedores con compra' = CALCULATE(DISTINCTCOUNT(FC_Compras[proveedor_clave]), FC_Compras[monto_sin_impuesto] <> 0)
		formatString: #,0
		displayFolder: 03 Conteos

	measure 'Compra promedio por documento' = DIVIDE([Compras netas], [Documentos de compra])
		formatString: "Q" #,0
		displayFolder: 04 Promedios

	measure 'Compra promedio por proveedor' = DIVIDE([Compras netas], [Proveedores con compra])
		formatString: "Q" #,0
		displayFolder: 04 Promedios

	/// Promedio sobre los días que SÍ hubo compra.
	measure 'Compra promedio diaria' = DIVIDE([Compras netas], CALCULATE(DISTINCTCOUNT(DM_Calendario[fecha]), FC_Compras))
		formatString: "Q" #,0
		displayFolder: 04 Promedios

	measure 'Compras mes anterior' = CALCULATE([Compras netas], DATEADD(DM_Calendario[fecha], -1, MONTH))
		formatString: "Q" #,0
		displayFolder: 05 Comparativos

	measure 'Compras año anterior' = CALCULATE([Compras netas], DATEADD(DM_Calendario[fecha], -1, YEAR))
		formatString: "Q" #,0
		displayFolder: 05 Comparativos

	measure 'Compras acumuladas mes' = TOTALMTD([Compras netas], DM_Calendario[fecha])
		formatString: "Q" #,0
		displayFolder: 05 Comparativos

	measure 'Compras acumuladas año' = TOTALYTD([Compras netas], DM_Calendario[fecha])
		formatString: "Q" #,0
		displayFolder: 05 Comparativos

	measure 'Compras acumuladas año anterior' = CALCULATE(TOTALYTD([Compras netas], DM_Calendario[fecha]), DATEADD(DM_Calendario[fecha], -1, YEAR))
		formatString: "Q" #,0
		displayFolder: 05 Comparativos

	measure 'Variación compras vs mes anterior' = DIVIDE([Compras netas] - [Compras mes anterior], [Compras mes anterior])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 05 Comparativos

	measure 'Variación compras vs año anterior' = DIVIDE([Compras netas] - [Compras año anterior], [Compras año anterior])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 05 Comparativos

	measure 'Media móvil 3 meses compras' = CALCULATE(AVERAGEX(VALUES(DM_Calendario[anio_mes]), [Compras netas]), DATESINPERIOD(DM_Calendario[fecha], MAX(DM_Calendario[fecha]), -3, MONTH))
		formatString: "Q" #,0
		displayFolder: 05 Comparativos

	/// Compra de líneas sin artículo (servicios, fletes, gastos) — en Cresta son el 60% de las líneas.
	measure 'Compras de servicios' = CALCULATE([Compras netas], DM_Producto[producto_codigo] = "SERVICIO")
		formatString: "Q" #,0
		displayFolder: 01 Importes

	measure 'Ranking de proveedor por compra' = RANKX(ALLSELECTED(DM_Proveedor), [Compras a terceros])
		formatString: #,0
		displayFolder: 06 Pareto

	/// Curva de Pareto: % de la compra a terceros que acumulan este proveedor y los mayores que él.
	measure '% acumulado de compra proveedores' = VAR actual = [Compras a terceros] RETURN DIVIDE(SUMX(FILTER(ALLSELECTED(DM_Proveedor), [Compras a terceros] >= actual), [Compras a terceros]), CALCULATE([Compras a terceros], ALLSELECTED(DM_Proveedor)))
		formatString: 0.0%
		displayFolder: 06 Pareto

	partition FC_Compras = m
		mode: import
		source =
				let
				    Origen = PostgreSQL.Database(Servidor, BaseDatos),
				    Tabla = Origen{[Schema="oro",Item="hecho_compra_linea"]}[Data]
				in
				    Tabla
