table 'FC_Venta diaria'

	column empresa_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: empresa_id

	column organizacion_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: organizacion_clave

	column fecha
		dataType: dateTime
		summarizeBy: none
		sourceColumn: fecha
		formatString: dd/MM/yyyy

	column tiempo_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: tiempo_clave

	column ventas_brutas
		dataType: decimal
		summarizeBy: none
		sourceColumn: ventas_brutas
		formatString: #,0.00

	column devoluciones
		dataType: decimal
		summarizeBy: none
		sourceColumn: devoluciones
		formatString: #,0.00

	column ventas_netas
		dataType: decimal
		summarizeBy: none
		sourceColumn: ventas_netas
		formatString: #,0.00

	column costo
		dataType: decimal
		summarizeBy: none
		sourceColumn: costo
		formatString: #,0.00

	column margen
		dataType: decimal
		summarizeBy: none
		sourceColumn: margen
		formatString: #,0.00

	column cantidad_vendida
		dataType: decimal
		summarizeBy: none
		sourceColumn: cantidad_vendida
		formatString: #,0.00

	column documentos
		dataType: int64
		summarizeBy: none
		sourceColumn: documentos
		formatString: #,0

	column clientes_activos
		dataType: int64
		summarizeBy: none
		sourceColumn: clientes_activos
		formatString: #,0

	column es_dia_sin_venta
		dataType: boolean
		summarizeBy: none
		sourceColumn: es_dia_sin_venta

	column proceso_transformacion
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: proceso_transformacion

	column version_proceso
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: version_proceso

	/// Serie continua (un día sin ventas es un CERO, no un hueco): la única base correcta para tendencias.
	measure 'Venta diaria neta' = SUM('FC_Venta diaria'[ventas_netas])
		formatString: "Q" #,0
		displayFolder: 01 Serie

	measure 'Venta media móvil 7d' = AVERAGEX(DATESINPERIOD('DM_Calendario'[fecha], MAX('DM_Calendario'[fecha]), -7, DAY), CALCULATE(SUM('FC_Venta diaria'[ventas_netas])))
		formatString: "Q" #,0
		displayFolder: 01 Serie

	measure 'Venta media móvil 30d' = AVERAGEX(DATESINPERIOD('DM_Calendario'[fecha], MAX('DM_Calendario'[fecha]), -30, DAY), CALCULATE(SUM('FC_Venta diaria'[ventas_netas])))
		formatString: "Q" #,0
		displayFolder: 01 Serie

	/// Promedio solo de los días que SÍ se vendió (excluye ceros): el ritmo real de un día operado.
	measure 'Venta promedio día operado' = AVERAGEX(FILTER('FC_Venta diaria', 'FC_Venta diaria'[es_dia_sin_venta] = FALSE), 'FC_Venta diaria'[ventas_netas])
		formatString: "Q" #,0
		displayFolder: 01 Serie

	measure 'Días sin venta' = CALCULATE(COUNTROWS('FC_Venta diaria'), 'FC_Venta diaria'[es_dia_sin_venta] = TRUE)
		formatString: #,0
		displayFolder: 02 Actividad

	measure 'Clientes activos por día' = AVERAGEX(FILTER('FC_Venta diaria', 'FC_Venta diaria'[es_dia_sin_venta] = FALSE), 'FC_Venta diaria'[clientes_activos])
		formatString: #,0
		displayFolder: 02 Actividad

	partition 'FC_Venta diaria' = m
		mode: import
		source =
				let
				    Origen = PostgreSQL.Database(Servidor, BaseDatos),
				    Tabla = Origen{[Schema="oro",Item="metrica_venta_diaria"]}[Data]
				in
				    Tabla
