table 'FC_Proyección de caja'

	column empresa_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: empresa_id

	column organizacion_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: organizacion_clave

	column flujo
		dataType: string
		summarizeBy: none
		sourceColumn: flujo

	column estado_vencimiento
		dataType: string
		summarizeBy: none
		sourceColumn: estado_vencimiento

	column semana_inicio
		dataType: dateTime
		summarizeBy: none
		sourceColumn: semana_inicio
		formatString: dd/MM/yyyy

	column semana_fin
		dataType: dateTime
		summarizeBy: none
		sourceColumn: semana_fin
		formatString: dd/MM/yyyy

	column tiempo_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: tiempo_clave

	column semana_offset
		dataType: int64
		summarizeBy: none
		sourceColumn: semana_offset
		formatString: #,0

	column semana_etiqueta
		dataType: string
		summarizeBy: none
		sourceColumn: semana_etiqueta
		sortByColumn: semana_offset

	column partidas
		dataType: int64
		summarizeBy: none
		sourceColumn: partidas
		formatString: #,0

	column monto
		dataType: decimal
		summarizeBy: none
		sourceColumn: monto
		formatString: #,0.00

	column fecha_corte
		dataType: dateTime
		summarizeBy: none
		sourceColumn: fecha_corte
		formatString: dd/MM/yyyy

	column proceso_transformacion
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: proceso_transformacion

	column version_proceso
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: version_proceso

	/// Proyección CONTRACTUAL: si cada partida abierta se paga en su vencimiento. No es un pronóstico.
	measure 'Entradas proyectadas' = CALCULATE(SUM('FC_Proyección de caja'[monto]), KEEPFILTERS('FC_Proyección de caja'[flujo] = "entrada"))
		formatString: "Q" #,0
		displayFolder: 01 Proyección

	measure 'Salidas proyectadas' = CALCULATE(SUM('FC_Proyección de caja'[monto]), KEEPFILTERS('FC_Proyección de caja'[flujo] = "salida"))
		formatString: "Q" #,0
		displayFolder: 01 Proyección

	measure 'Flujo neto proyectado' = [Entradas proyectadas] - [Salidas proyectadas]
		formatString: "Q" #,0
		displayFolder: 01 Proyección

	/// Ya venció y sigue abierto: en teoría es cobrable HOY. La brecha con lo programado mide la gestión de cobro.
	measure 'Entradas vencidas (exigible)' = CALCULATE(SUM('FC_Proyección de caja'[monto]), KEEPFILTERS('FC_Proyección de caja'[flujo] = "entrada"), KEEPFILTERS('FC_Proyección de caja'[estado_vencimiento] = "vencido"))
		formatString: "Q" #,0
		displayFolder: 02 Vencido

	measure 'Salidas vencidas (exigible)' = CALCULATE(SUM('FC_Proyección de caja'[monto]), KEEPFILTERS('FC_Proyección de caja'[flujo] = "salida"), KEEPFILTERS('FC_Proyección de caja'[estado_vencimiento] = "vencido"))
		formatString: "Q" #,0
		displayFolder: 02 Vencido

	/// Flujo acumulado semana a semana: la curva que muestra en qué semana la caja se pone negativa si nada cambia. Es la pregunta que hace un gerente el lunes por la mañana.
	measure 'Posición proyectada acumulada' = CALCULATE([Flujo neto proyectado], FILTER(ALL('FC_Proyección de caja'[semana_offset]), 'FC_Proyección de caja'[semana_offset] <= MAX('FC_Proyección de caja'[semana_offset])))
		formatString: "Q" #,0
		displayFolder: 03 Acumulado

	/// Horizonte corto: lo que entra y sale en las próximas 4 semanas, sin contar lo ya vencido.
	measure 'Entradas próximas 4 semanas' = CALCULATE([Entradas proyectadas], FILTER(ALL('FC_Proyección de caja'[semana_offset]), 'FC_Proyección de caja'[semana_offset] >= 0 && 'FC_Proyección de caja'[semana_offset] <= 3))
		formatString: "Q" #,0
		displayFolder: 03 Acumulado

	measure 'Salidas próximas 4 semanas' = CALCULATE([Salidas proyectadas], FILTER(ALL('FC_Proyección de caja'[semana_offset]), 'FC_Proyección de caja'[semana_offset] >= 0 && 'FC_Proyección de caja'[semana_offset] <= 3))
		formatString: "Q" #,0
		displayFolder: 03 Acumulado

	measure 'Flujo neto próximas 4 semanas' = [Entradas próximas 4 semanas] - [Salidas próximas 4 semanas]
		formatString: "Q" #,0
		displayFolder: 03 Acumulado

	partition 'FC_Proyección de caja' = m
		mode: import
		source =
				let
				    Origen = PostgreSQL.Database(Servidor, BaseDatos),
				    Tabla = Origen{[Schema="oro",Item="proyeccion_caja_semanal"]}[Data]
				in
				    Tabla
