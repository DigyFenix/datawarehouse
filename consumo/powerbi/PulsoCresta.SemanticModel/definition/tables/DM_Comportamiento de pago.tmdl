table 'DM_Comportamiento de pago'

	column empresa_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: empresa_id

	column cliente_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: cliente_clave

	column partidas_abiertas
		dataType: int64
		summarizeBy: none
		sourceColumn: partidas_abiertas
		formatString: #,0

	column saldo_total
		dataType: decimal
		summarizeBy: none
		sourceColumn: saldo_total
		formatString: #,0.00

	column saldo_corriente
		dataType: decimal
		summarizeBy: none
		sourceColumn: saldo_corriente
		formatString: #,0.00

	column saldo_vencido
		dataType: decimal
		summarizeBy: none
		sourceColumn: saldo_vencido
		formatString: #,0.00

	column max_dias_vencido
		dataType: int64
		summarizeBy: none
		sourceColumn: max_dias_vencido
		formatString: #,0

	column dias_vencido_ponderado
		dataType: decimal
		summarizeBy: none
		sourceColumn: dias_vencido_ponderado
		formatString: #,0.00

	column vencimiento_mas_antiguo
		dataType: dateTime
		summarizeBy: none
		sourceColumn: vencimiento_mas_antiguo
		formatString: dd/MM/yyyy

	column fecha_corte
		dataType: dateTime
		summarizeBy: none
		sourceColumn: fecha_corte
		formatString: dd/MM/yyyy

	column ultimo_pago
		dataType: dateTime
		summarizeBy: none
		sourceColumn: ultimo_pago
		formatString: dd/MM/yyyy

	column dias_desde_ultimo_pago
		dataType: int64
		summarizeBy: none
		sourceColumn: dias_desde_ultimo_pago
		formatString: #,0

	column pagos_12m
		dataType: int64
		summarizeBy: none
		sourceColumn: pagos_12m
		formatString: #,0

	column monto_pagado_12m
		dataType: decimal
		summarizeBy: none
		sourceColumn: monto_pagado_12m
		formatString: #,0.00

	column monto_pagado_3m
		dataType: decimal
		summarizeBy: none
		sourceColumn: monto_pagado_3m
		formatString: #,0.00

	column pct_saldo_vencido
		dataType: decimal
		summarizeBy: none
		sourceColumn: pct_saldo_vencido
		formatString: 0.0"%"

	column perfil_riesgo
		dataType: string
		summarizeBy: none
		sourceColumn: perfil_riesgo

	column perfil_riesgo_nombre
		dataType: string
		summarizeBy: none
		sourceColumn: perfil_riesgo_nombre

	column proceso_transformacion
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: proceso_transformacion

	column version_proceso
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: version_proceso

	measure 'Clientes al día' = CALCULATE(COUNTROWS('DM_Comportamiento de pago'), 'DM_Comportamiento de pago'[perfil_riesgo] = "al_dia")
		formatString: #,0
		displayFolder: 01 Conteos

	/// Más de 90 días vencido o más de la mitad del saldo vencido: revisar antes de despachar.
	measure 'Clientes en vencido crítico' = CALCULATE(COUNTROWS('DM_Comportamiento de pago'), 'DM_Comportamiento de pago'[perfil_riesgo] = "vencido_critico")
		formatString: #,0
		displayFolder: 01 Conteos

	measure 'Clientes con saldo vencido' = CALCULATE(COUNTROWS('DM_Comportamiento de pago'), 'DM_Comportamiento de pago'[perfil_riesgo] IN {"vencido_leve", "vencido_moderado", "vencido_critico"})
		formatString: #,0
		displayFolder: 01 Conteos

	measure 'Saldo en clientes críticos' = CALCULATE(SUM('DM_Comportamiento de pago'[saldo_total]), 'DM_Comportamiento de pago'[perfil_riesgo] = "vencido_critico")
		formatString: "Q" #,0
		displayFolder: 02 Montos

	/// Del saldo total abierto, cuánto ya venció. El termómetro de la salud de la cartera.
	measure '% cartera vencida (clientes)' = DIVIDE(SUM('DM_Comportamiento de pago'[saldo_vencido]), SUM('DM_Comportamiento de pago'[saldo_total]))
		formatString: 0.0%
		displayFolder: 02 Montos

	partition 'DM_Comportamiento de pago' = m
		mode: import
		source =
				let
				    Origen = PostgreSQL.Database(Servidor, BaseDatos),
				    Tabla = Origen{[Schema="oro",Item="comportamiento_pago_cliente"]}[Data]
				in
				    Tabla
