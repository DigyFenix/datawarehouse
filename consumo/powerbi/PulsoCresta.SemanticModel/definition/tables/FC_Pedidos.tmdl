table FC_Pedidos

	column tiempo_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: tiempo_clave

	column tiempo_vencimiento_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: tiempo_vencimiento_clave

	column cliente_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: cliente_clave

	column socio_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: socio_clave

	column producto_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: producto_clave

	column vendedor_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: vendedor_clave

	column organizacion_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: organizacion_clave

	column almacen_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: almacen_clave

	column moneda_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: moneda_clave

	column empresa_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: empresa_id

	column pedido_id
		dataType: string
		summarizeBy: none
		sourceColumn: pedido_id

	column pedido_numero
		dataType: string
		summarizeBy: none
		sourceColumn: pedido_numero

	column serie_codigo
		dataType: string
		summarizeBy: none
		sourceColumn: serie_codigo

	column linea_numero
		dataType: int64
		summarizeBy: none
		sourceColumn: linea_numero
		formatString: #,0

	column fecha_pedido
		dataType: dateTime
		summarizeBy: none
		sourceColumn: fecha_pedido
		formatString: dd/MM/yyyy

	column fecha_entrega
		dataType: dateTime
		summarizeBy: none
		sourceColumn: fecha_entrega
		formatString: dd/MM/yyyy

	column estado
		dataType: string
		summarizeBy: none
		sourceColumn: estado

	column estado_linea
		dataType: string
		summarizeBy: none
		sourceColumn: estado_linea

	column es_abierta
		dataType: boolean
		summarizeBy: none
		sourceColumn: es_abierta

	column cantidad
		dataType: decimal
		summarizeBy: none
		sourceColumn: cantidad
		formatString: #,0.00

	column cantidad_abierta
		dataType: decimal
		summarizeBy: none
		sourceColumn: cantidad_abierta
		formatString: #,0.00

	column cantidad_entregada
		dataType: decimal
		summarizeBy: none
		sourceColumn: cantidad_entregada
		formatString: #,0.00

	column precio_unitario_doc
		dataType: decimal
		summarizeBy: none
		sourceColumn: precio_unitario_doc
		formatString: #,0.00

	column descuento_pct
		dataType: decimal
		summarizeBy: none
		sourceColumn: descuento_pct
		formatString: 0.0"%"

	column monto_sin_impuesto
		dataType: decimal
		summarizeBy: none
		sourceColumn: monto_sin_impuesto
		formatString: #,0.00

	column monto_sin_impuesto_doc
		dataType: decimal
		summarizeBy: none
		sourceColumn: monto_sin_impuesto_doc
		formatString: #,0.00

	column monto_abierto
		dataType: decimal
		summarizeBy: none
		sourceColumn: monto_abierto
		formatString: #,0.00

	column descripcion_linea
		dataType: string
		summarizeBy: none
		sourceColumn: descripcion_linea

	column proceso_transformacion
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: proceso_transformacion

	column version_proceso
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: version_proceso

	/// Base SIN impuesto de lo pedido en el período. El COMPROMISO, no el resultado (eso es Ventas).
	measure 'Monto pedido' = SUM(FC_Pedidos[monto_sin_impuesto])
		formatString: "Q" #,0
		displayFolder: 01 Pedido

	measure 'Cantidad pedida' = SUM(FC_Pedidos[cantidad])
		formatString: #,0
		displayFolder: 01 Pedido

	measure 'Pedidos del período' = DISTINCTCOUNT(FC_Pedidos[pedido_id])
		formatString: #,0
		displayFolder: 01 Pedido

	/// Pedido y AÚN no cumplido (líneas abiertas): lo que la operación debe entregar/facturar.
	measure 'Backlog' = CALCULATE(SUM(FC_Pedidos[monto_abierto]), FC_Pedidos[es_abierta] = TRUE)
		formatString: "Q" #,0
		displayFolder: 02 Backlog

	measure 'Cantidad pendiente' = CALCULATE(SUM(FC_Pedidos[cantidad_abierta]), FC_Pedidos[es_abierta] = TRUE)
		formatString: #,0
		displayFolder: 02 Backlog

	measure 'Líneas abiertas' = CALCULATE(COUNTROWS(FC_Pedidos), FC_Pedidos[es_abierta] = TRUE)
		formatString: #,0
		displayFolder: 02 Backlog

	/// De lo pedido, cuánto ya se cumplió (1 − backlog/pedido). El pulso de la operación.
	measure 'Fill rate' = 1 - DIVIDE([Backlog], [Monto pedido], 0)
		formatString: 0.0%
		displayFolder: 02 Backlog

	partition FC_Pedidos = m
		mode: import
		source =
				let
				    Origen = PostgreSQL.Database(Servidor, BaseDatos),
				    Tabla = Origen{[Schema="oro",Item="hecho_pedido_linea"]}[Data]
				in
				    Tabla
