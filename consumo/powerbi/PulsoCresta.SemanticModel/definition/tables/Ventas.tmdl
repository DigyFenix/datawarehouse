table Ventas

	column tiempo_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: tiempo_clave

	column cliente_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: cliente_clave

	column producto_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: producto_clave

	column vendedor_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: vendedor_clave

	column organizacion_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: organizacion_clave

	column almacen_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: almacen_clave

	column moneda_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: moneda_clave

	column cuenta_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: cuenta_clave

	column centro_costo_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: centro_costo_clave

	column tipo_documento_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: tipo_documento_clave

	column empresa_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: empresa_id

	column documento_id
		dataType: string
		summarizeBy: none
		sourceColumn: documento_id

	column documento_numero
		dataType: string
		summarizeBy: none
		sourceColumn: documento_numero

	column linea_numero
		dataType: int64
		summarizeBy: none
		sourceColumn: linea_numero
		formatString: #,0

	column tipo_documento
		dataType: string
		summarizeBy: none
		sourceColumn: tipo_documento

	column fecha_documento
		dataType: dateTime
		summarizeBy: none
		sourceColumn: fecha_documento
		formatString: dd/MM/yyyy

	column cantidad
		dataType: decimal
		summarizeBy: none
		sourceColumn: cantidad
		formatString: #,0.00

	column monto_sin_impuesto_local
		dataType: decimal
		summarizeBy: none
		sourceColumn: monto_sin_impuesto_local
		formatString: #,0.00

	column monto_impuesto_local
		dataType: decimal
		summarizeBy: none
		sourceColumn: monto_impuesto_local
		formatString: #,0.00

	column monto_con_impuesto_local
		dataType: decimal
		summarizeBy: none
		sourceColumn: monto_con_impuesto_local
		formatString: #,0.00

	column monto_sin_impuesto_doc
		dataType: decimal
		summarizeBy: none
		sourceColumn: monto_sin_impuesto_doc
		formatString: #,0.00

	column monto_impuesto_doc
		dataType: decimal
		summarizeBy: none
		sourceColumn: monto_impuesto_doc
		formatString: #,0.00

	column monto_con_impuesto_doc
		dataType: decimal
		summarizeBy: none
		sourceColumn: monto_con_impuesto_doc
		formatString: #,0.00

	column monto_descuento_local
		dataType: decimal
		summarizeBy: none
		sourceColumn: monto_descuento_local
		formatString: #,0.00

	column descuento_pct
		dataType: decimal
		summarizeBy: none
		sourceColumn: descuento_pct
		formatString: 0.0"%"

	column costo_local
		dataType: decimal
		summarizeBy: none
		sourceColumn: costo_local
		formatString: #,0.00

	column margen_local
		dataType: decimal
		summarizeBy: none
		sourceColumn: margen_local
		formatString: #,0.00

	column proceso_transformacion
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: proceso_transformacion

	column version_proceso
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: version_proceso

	/// Base de todo: venta sin impuestos, con la nota de crédito ya en negativo.
	measure 'Ventas netas' = SUM(Ventas[monto_sin_impuesto_local])
		formatString: #,0
		displayFolder: 01 Importes

	measure 'Ventas netas con IVA' = SUM(Ventas[monto_con_impuesto_local])
		formatString: #,0
		displayFolder: 01 Importes

	measure 'Ventas brutas' = CALCULATE([Ventas netas], 'Tipo de documento'[tipo_documento] = "factura")
		formatString: #,0
		displayFolder: 01 Importes

	measure Devoluciones = ABS(CALCULATE([Ventas netas], 'Tipo de documento'[tipo_documento] = "nota_credito"))
		formatString: #,0
		displayFolder: 01 Importes

	measure 'Impuesto facturado' = SUM(Ventas[monto_impuesto_local])
		formatString: #,0
		displayFolder: 01 Importes

	measure 'Descuento otorgado' = SUM(Ventas[monto_descuento_local])
		formatString: #,0
		displayFolder: 01 Importes

	measure '% Descuento' = DIVIDE([Descuento otorgado], [Ventas netas] + [Descuento otorgado])
		formatString: 0.0%
		displayFolder: 01 Importes

	/// El mercado real. La venta al grupo no compite por precio: mezclarla distorsiona todo indicador comercial.
	measure 'Ventas a terceros' = CALCULATE([Ventas netas], Cliente[es_intercompania] = FALSE)
		formatString: #,0
		displayFolder: 02 Terceros vs grupo

	measure 'Ventas al grupo' = CALCULATE([Ventas netas], Cliente[es_intercompania] = TRUE)
		formatString: #,0
		displayFolder: 02 Terceros vs grupo

	measure '% Venta al grupo' = DIVIDE([Ventas al grupo], [Ventas netas])
		formatString: 0.0%
		displayFolder: 02 Terceros vs grupo

	measure 'Unidades vendidas' = SUM(Ventas[cantidad])
		formatString: #,0
		displayFolder: 03 Conteos

	measure 'Líneas de venta' = COUNTROWS(Ventas)
		formatString: #,0
		displayFolder: 03 Conteos

	measure 'Documentos de venta' = DISTINCTCOUNT(Ventas[documento_id])
		formatString: #,0
		displayFolder: 03 Conteos

	measure 'Clientes con venta' = CALCULATE(DISTINCTCOUNT(Ventas[cliente_clave]), Ventas[monto_sin_impuesto_local] <> 0)
		formatString: #,0
		displayFolder: 03 Conteos

	measure 'Productos vendidos' = DISTINCTCOUNT(Ventas[producto_clave])
		formatString: #,0
		displayFolder: 03 Conteos

	measure 'Ticket promedio' = DIVIDE([Ventas netas], [Documentos de venta])
		formatString: #,0
		displayFolder: 03 Conteos

	measure 'Precio promedio unidad' = DIVIDE([Ventas netas], [Unidades vendidas])
		formatString: #,0.00
		displayFolder: 03 Conteos

	measure 'Costo de ventas' = SUM(Ventas[costo_local])
		formatString: #,0
		displayFolder: 04 Rentabilidad

	measure 'Margen bruto' = SUM(Ventas[margen_local])
		formatString: #,0
		displayFolder: 04 Rentabilidad

	measure '% Margen' = DIVIDE([Margen bruto], [Ventas netas])
		formatString: 0.0%
		displayFolder: 04 Rentabilidad

	/// El margen de mercado. Incluir la venta al grupo, que no compite por precio, infla el indicador.
	measure '% Margen terceros' = DIVIDE(CALCULATE([Margen bruto], Cliente[es_intercompania] = FALSE), [Ventas a terceros])
		formatString: 0.0%
		displayFolder: 04 Rentabilidad

	measure 'Ventas mes anterior' = CALCULATE([Ventas netas], DATEADD(Calendario[fecha], -1, MONTH))
		formatString: #,0
		displayFolder: 05 Comparativos

	measure 'Ventas año anterior' = CALCULATE([Ventas netas], DATEADD(Calendario[fecha], -1, YEAR))
		formatString: #,0
		displayFolder: 05 Comparativos

	measure 'Ventas acumuladas año' = TOTALYTD([Ventas netas], Calendario[fecha])
		formatString: #,0
		displayFolder: 05 Comparativos

	measure 'Variación vs mes anterior' = DIVIDE([Ventas netas] - [Ventas mes anterior], [Ventas mes anterior])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 05 Comparativos

	measure 'Variación vs año anterior' = DIVIDE([Ventas netas] - [Ventas año anterior], [Ventas año anterior])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 05 Comparativos

	/// Promedio de los últimos 3 meses: alisa el diente de sierra de la facturación diaria.
	measure 'Media móvil 3 meses' = AVERAGEX(DATESINPERIOD(Calendario[fecha], MAX(Calendario[fecha]), -3, MONTH), [Ventas netas])
		formatString: #,0
		displayFolder: 05 Comparativos

	partition Ventas = m
		mode: import
		source =
				let
				    Origen = PostgreSQL.Database(Servidor, BaseDatos),
				    Tabla = Origen{[Schema="oro",Item="hecho_venta_linea"]}[Data]
				in
				    Tabla
