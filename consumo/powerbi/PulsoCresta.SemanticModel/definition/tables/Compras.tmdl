table Compras

	column tiempo_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: tiempo_clave

	column proveedor_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: proveedor_clave

	column producto_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: producto_clave

	column organizacion_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: organizacion_clave

	column almacen_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: almacen_clave

	column moneda_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: moneda_clave

	column cuenta_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: cuenta_clave

	column centro_costo_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: centro_costo_clave

	column tipo_documento_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: tipo_documento_clave

	column empresa_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: empresa_id

	column documento_id
		dataType: string
		summarizeBy: none
		sourceColumn: documento_id

	column documento_numero
		dataType: string
		summarizeBy: none
		sourceColumn: documento_numero

	column linea_numero
		dataType: int64
		summarizeBy: none
		sourceColumn: linea_numero
		formatString: #,0

	column tipo_documento
		dataType: string
		summarizeBy: none
		sourceColumn: tipo_documento

	column fecha_documento
		dataType: dateTime
		summarizeBy: none
		sourceColumn: fecha_documento
		formatString: dd/MM/yyyy

	column cantidad
		dataType: decimal
		summarizeBy: none
		sourceColumn: cantidad
		formatString: #,0.00

	column monto_sin_impuesto_local
		dataType: decimal
		summarizeBy: none
		sourceColumn: monto_sin_impuesto_local
		formatString: #,0.00

	column monto_impuesto_local
		dataType: decimal
		summarizeBy: none
		sourceColumn: monto_impuesto_local
		formatString: #,0.00

	column monto_con_impuesto_local
		dataType: decimal
		summarizeBy: none
		sourceColumn: monto_con_impuesto_local
		formatString: #,0.00

	column monto_sin_impuesto_doc
		dataType: decimal
		summarizeBy: none
		sourceColumn: monto_sin_impuesto_doc
		formatString: #,0.00

	column monto_impuesto_doc
		dataType: decimal
		summarizeBy: none
		sourceColumn: monto_impuesto_doc
		formatString: #,0.00

	column monto_con_impuesto_doc
		dataType: decimal
		summarizeBy: none
		sourceColumn: monto_con_impuesto_doc
		formatString: #,0.00

	column monto_descuento_local
		dataType: decimal
		summarizeBy: none
		sourceColumn: monto_descuento_local
		formatString: #,0.00

	column descuento_pct
		dataType: decimal
		summarizeBy: none
		sourceColumn: descuento_pct
		formatString: 0.0"%"

	column proceso_transformacion
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: proceso_transformacion

	column version_proceso
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: version_proceso

	measure 'Compras netas' = SUM(Compras[monto_sin_impuesto_local])
		formatString: #,0
		displayFolder: 01 Importes

	measure 'Compras netas con IVA' = SUM(Compras[monto_con_impuesto_local])
		formatString: #,0
		displayFolder: 01 Importes

	measure 'Impuesto de compras' = SUM(Compras[monto_impuesto_local])
		formatString: #,0
		displayFolder: 01 Importes

	measure 'Unidades compradas' = SUM(Compras[cantidad])
		formatString: #,0
		displayFolder: 02 Conteos

	measure 'Líneas de compra' = COUNTROWS(Compras)
		formatString: #,0
		displayFolder: 02 Conteos

	measure 'Documentos de compra' = DISTINCTCOUNT(Compras[documento_id])
		formatString: #,0
		displayFolder: 02 Conteos

	measure 'Proveedores con compra' = CALCULATE(DISTINCTCOUNT(Compras[proveedor_clave]), Compras[monto_sin_impuesto_local] <> 0)
		formatString: #,0
		displayFolder: 02 Conteos

	measure 'Compra promedio por documento' = DIVIDE([Compras netas], [Documentos de compra])
		formatString: #,0
		displayFolder: 02 Conteos

	measure 'Compras mes anterior' = CALCULATE([Compras netas], DATEADD(Calendario[fecha], -1, MONTH))
		formatString: #,0
		displayFolder: 03 Comparativos

	measure 'Compras acumuladas año' = TOTALYTD([Compras netas], Calendario[fecha])
		formatString: #,0
		displayFolder: 03 Comparativos

	partition Compras = m
		mode: import
		source =
				let
				    Origen = PostgreSQL.Database(Servidor, BaseDatos),
				    Tabla = Origen{[Schema="oro",Item="hecho_compra_linea"]}[Data]
				in
				    Tabla
