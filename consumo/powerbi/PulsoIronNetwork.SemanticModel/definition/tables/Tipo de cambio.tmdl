table 'Tipo de cambio'

	column tiempo_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: tiempo_clave

	column moneda_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: moneda_clave

	column organizacion_clave
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: organizacion_clave

	column empresa_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: empresa_id

	column fecha
		dataType: dateTime
		summarizeBy: none
		sourceColumn: fecha
		formatString: dd/MM/yyyy

	column moneda_codigo
		dataType: string
		summarizeBy: none
		sourceColumn: moneda_codigo

	column tasa
		dataType: decimal
		summarizeBy: none
		sourceColumn: tasa
		formatString: #,0.00

	column proceso_transformacion
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: proceso_transformacion

	column version_proceso
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: version_proceso

	/// Tasa promedio del período filtrado (moneda local por 1 unidad). Filtrar una moneda para leerla.
	measure 'Tipo de cambio promedio' = AVERAGE('Tipo de cambio'[tasa])
		formatString: #,0.0000
		displayFolder: 01 Tasa

	/// La tasa del último día con registro dentro del filtro.
	measure 'Tipo de cambio de cierre' = CALCULATE(AVERAGE('Tipo de cambio'[tasa]), LASTDATE('Tipo de cambio'[fecha]))
		formatString: #,0.0000
		displayFolder: 01 Tasa

	partition 'Tipo de cambio' = m
		mode: import
		source =
				let
				    Origen = PostgreSQL.Database(Servidor, BaseDatos),
				    Tabla = Origen{[Schema="oro",Item="tipo_cambio"]}[Data]
				in
				    Tabla
