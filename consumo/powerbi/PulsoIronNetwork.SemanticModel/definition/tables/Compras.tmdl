		summarizeBy: none
		sourceColumn: documento_id

	column documento_numero
		dataType: string
		summarizeBy: none
		sourceColumn: documento_numero

	column linea_numero
		dataType: int64
		summarizeBy: none
		sourceColumn: linea_numero
		formatString: #,0

	column tipo_documento
		dataType: string
		summarizeBy: none
		sourceColumn: tipo_documento

	column fecha_documento
		dataType: dateTime
		summarizeBy: none
		sourceColumn: fecha_documento
		formatString: dd/MM/yyyy

	column cantidad
		dataType: decimal
		summarizeBy: none
		sourceColumn: cantidad
		formatString: #,0.00

	column monto_sin_impuesto_local
		dataType: decimal
		summarizeBy: none
		sourceColumn: monto_sin_impuesto_local
		formatString: #,0.00

