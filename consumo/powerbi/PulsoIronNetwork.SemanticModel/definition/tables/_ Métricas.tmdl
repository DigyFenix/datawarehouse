table '_ Métricas'

	measure 'Ventas netas' = SUM(Ventas[monto_sin_impuesto_local])
		formatString: #,0
		displayFolder: 01 Ventas

	measure 'Ventas netas con IVA' = SUM(Ventas[monto_con_impuesto_local])
		formatString: #,0
		displayFolder: 01 Ventas

	measure 'Ventas brutas' = CALCULATE([Ventas netas], 'Tipo de documento'[tipo_documento] = "factura")
		formatString: #,0
		displayFolder: 01 Ventas

	measure Devoluciones = ABS(CALCULATE([Ventas netas], 'Tipo de documento'[tipo_documento] = "nota_credito"))
		formatString: #,0
		displayFolder: 01 Ventas

	measure 'Ventas a terceros' = CALCULATE([Ventas netas], Cliente[es_intercompania] = FALSE)
		formatString: #,0
		displayFolder: 01 Ventas

	measure 'Ventas al grupo' = CALCULATE([Ventas netas], Cliente[es_intercompania] = TRUE)
		formatString: #,0
		displayFolder: 01 Ventas

	measure 'Costo de ventas' = SUM(Ventas[costo_local])
		formatString: #,0
		displayFolder: 02 Rentabilidad

	measure 'Margen bruto' = SUM(Ventas[margen_local])
		formatString: #,0
		displayFolder: 02 Rentabilidad

	measure '% Margen' = DIVIDE([Margen bruto], [Ventas netas])
		formatString: 0.0%
		displayFolder: 02 Rentabilidad

	/// El margen de mercado. La venta al grupo no compite por precio, así que incluirla infla el indicador.
	measure '% Margen terceros' = DIVIDE(CALCULATE([Margen bruto], Cliente[es_intercompania] = FALSE), CALCULATE([Ventas netas], Cliente[es_intercompania] = FALSE))
		formatString: 0.0%
		displayFolder: 02 Rentabilidad

	measure Compras = SUM(Compras[monto_sin_impuesto_local])
		formatString: #,0
		displayFolder: 03 Compras

	measure 'Saldo por cobrar' = SUM('Cartera por cobrar'[saldo_pendiente_local])
		formatString: #,0
		displayFolder: 04 Cartera

	measure 'Saldo por cobrar terceros' = CALCULATE([Saldo por cobrar], Cliente[es_intercompania] = FALSE)
		formatString: #,0
		displayFolder: 04 Cartera

	/// Saldo entre empresas del propio grupo. En Proavisa es el 72.7% de la cartera: leerlo junto al de terceros hace parecer que hay una crisis de cobranza que no existe.
	measure 'Saldo por cobrar grupo' = CALCULATE([Saldo por cobrar], Cliente[es_intercompania] = TRUE)
		formatString: #,0
		displayFolder: 04 Cartera

	measure 'Saldo por pagar' = SUM('Cartera por pagar'[saldo_pendiente_absoluto])
		formatString: #,0
		displayFolder: 04 Cartera

	measure 'Posición neta' = [Saldo por cobrar] - [Saldo por pagar]
		formatString: #,0
		displayFolder: 04 Cartera

	measure 'Cartera vencida' = CALCULATE([Saldo por cobrar], 'Cartera por cobrar'[dias_vencido] > 0)
		formatString: #,0
		displayFolder: 05 Riesgo

	/// La mora que sí hay que cobrar.
	measure 'Cartera vencida terceros' = CALCULATE([Saldo por cobrar], 'Cartera por cobrar'[dias_vencido] > 0, Cliente[es_intercompania] = FALSE)
		formatString: #,0
		displayFolder: 05 Riesgo

	measure '% Vencido terceros' = DIVIDE([Cartera vencida terceros], [Saldo por cobrar terceros])
		formatString: 0.0%
		displayFolder: 05 Riesgo

	/// Días de venta a terceros pendientes de cobro. Mezclar el saldo del grupo lo triplica (84 días vs 29).
	measure 'Días de cartera terceros' = DIVIDE([Saldo por cobrar terceros], DIVIDE(CALCULATE([Ventas netas], Cliente[es_intercompania] = FALSE), CALCULATE(DISTINCTCOUNT(Calendario[fecha]), Ventas)))
		formatString: #,0.0
		displayFolder: 05 Riesgo

	measure 'Ventas mes anterior' = CALCULATE([Ventas netas], DATEADD(Calendario[fecha], -1, MONTH))
		formatString: #,0
		displayFolder: 06 Comparativos

	measure 'Ventas año anterior' = CALCULATE([Ventas netas], DATEADD(Calendario[fecha], -1, YEAR))
		formatString: #,0
		displayFolder: 06 Comparativos

	measure 'Ventas acumuladas año' = TOTALYTD([Ventas netas], Calendario[fecha])
		formatString: #,0
		displayFolder: 06 Comparativos

	measure 'Variación vs mes anterior' = DIVIDE([Ventas netas] - [Ventas mes anterior], [Ventas mes anterior])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 06 Comparativos

	partition '_ Métricas' = m
		mode: import
		source =
				let
				    Origen = #table({"_"}, {{1}})
				in
				    Origen

	column _
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: _
