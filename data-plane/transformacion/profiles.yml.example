# Plantilla de perfil dbt. Copiar a ~/.dbt/profiles.yml (o exportar DBT_PROFILES_DIR)
# y completar con los valores del .env. NUNCA versionar el profiles.yml real con credenciales.
quilate_control:
  target: local
  outputs:
    local:
      type: postgres
      host: "{{ env_var('POSTGRES_HOST', 'localhost') }}"
      port: "{{ env_var('POSTGRES_PORT', '5432') | int }}"
      dbname: "{{ env_var('POSTGRES_DB') }}"
      user: "{{ env_var('POSTGRES_USER') }}"
      password: "{{ env_var('POSTGRES_PASSWORD') }}"
      schema: dbt          # schema base; los modelos sobreescriben a bronze/silver/gold
      threads: 4
